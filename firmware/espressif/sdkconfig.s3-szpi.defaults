# LCKFB SZPI ESP32-S3 preview profile (ESP32-S3-WROOM-1-N16R8).
CONFIG_MICROPIXEL_BOARD_SZPI_ESP32S3=y
CONFIG_MICROPIXEL_SZPI_S3_LVGL_DOUBLE_BUFFER=y

# The ST7789 accepts direct PSRAM SPI DMA. Two 40-row partial buffers leave more
# of the board's 8 MiB octal PSRAM available to Guest linear memory and assets.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM=y

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
