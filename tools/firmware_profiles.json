      "firmware/espressif/sdkconfig.s31.defaults"
    ],
    "sdkconfig_defaults_env": "S31_SDKCONFIG_DEFAULTS",
    "port_env": "S31_PORT",
    "baud_env": "S31_BAUD",
    "default_baud": 460800,
    "flash_before": "no-reset",
    "application_usb_products": [
      "MicroPixel ESP-Mosaico"
    ],
    "rom_usb_products": [
      "ESP32-S31"
    ],
    "preview": true,
    "flash": true,
    "monitor": true
  },
  "s31-null": {
