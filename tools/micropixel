def upload(
    client: ControlClient, bundle_path: Path, expected_target: str | None = None
) -> dict[str, Any]:
    require_compatible_firmware(client)
    details = require_bundle_target(
        bundle_path, expected_target or network_device_aot_target(client)
    )
    payload, _ = client.request(
        "POST",
        client.device_path("/packages"),
        binary_body=bundle_path.read_bytes(),
        content_type="application/vnd.micropixel.app",
        timeout=120.0,
    )
    response = json.loads(payload)
    if not isinstance(response, dict):
        raise CliError("Control API returned an unexpected upload response")
    print(f"Uploaded {details['appId']} ({details['sizeBytes']} bytes)", file=sys.stderr)
    return response


def pull_logs(
    client: ControlClient,
    cursor: str | None,
    timeout_seconds: float,
    source: str,
    command_timeout_ms: int | None = None,
) -> tuple[str | None, bool, list[dict[str, Any]]]:
    body = {"cursor": cursor, "source": source}
    if command_timeout_ms is None:
        command = client.json("POST", client.device_path("/logs/read"), body)
    else:
        command = client.json(
            "POST",
            client.device_path("/logs/read"),
            body,
            command_timeout_ms=command_timeout_ms,
        )
    client.wait_job(command, timeout_seconds)
    query_values = {"source": source}
    if cursor is not None:
        query_values["cursor"] = cursor
    query = f"?{urllib.parse.urlencode(query_values)}"
    snapshot = client.json("GET", client.device_path(f"/logs{query}"))
    entries = snapshot.get("entries", [])
    normalized_entries = [entry for entry in entries if isinstance(entry, dict)] if isinstance(entries, list) else []
    next_cursor = snapshot.get("nextCursor", cursor)
    return (
        next_cursor if isinstance(next_cursor, str) else cursor,
        snapshot.get("hasMore") is True,
        normalized_entries,
    )


def print_log_entries(entries: list[dict[str, Any]]) -> None:
    for entry in entries:
        sequence = entry.get("sequence", "-")
        level = str(entry.get("level", "info")).upper()
        source = str(entry.get("source", "app"))
        app_id = entry.get("appId")
        message = entry.get("message", "")
        prefix = f"[APP {app_id or 'unknown'}]" if source == "app" else "[HOST]"
        print(f"{sequence:>6} {level:<5} {prefix} {message}")


def stream_network_logs(
    client: ControlClient,
    *,
    cursor: str | None,
    lines: int | None,
    follow: bool,
    interval: float,
    timeout: float,
    command_timeout_ms: int | None,
    source: str,
) -> None:
    initial_entries: list[dict[str, Any]] = []
    catching_up = lines is not None
    try:
        while True:
            cursor, has_more, entries = pull_logs(client, cursor, timeout, source, command_timeout_ms)
            if catching_up:
                initial_entries.extend(entries)
                if lines == 0:
                    initial_entries.clear()
                elif lines is not None and len(initial_entries) > lines:
                    del initial_entries[:-lines]
            else:
                print_log_entries(entries)
            if catching_up and not has_more:
                print_log_entries(initial_entries)
                catching_up = False
            if not follow and not has_more:
                break
            if not has_more:
                time.sleep(interval)
    except KeyboardInterrupt:
        print("\nStopped following logs; the App is still running.", file=sys.stderr)


def usb_log_tail_cursor(client: UsbControlClient, source: str, lines: int) -> str | None:
    """Return a cursor roughly `lines` entries before the newest retained entry.

    Sequences are dense per session, so the newest sequence is found with a
    galloping search followed by bisection on "does an entry exist after
    this sequence": about 2*log2(retained) round trips instead of one per entry.
    Returns None when the retained log is empty so the caller reads from the
    start.
    """
    first_cursor, _has_more, _truncated, first_entries = client.read_log(None, source)
    if not first_entries:
        return None
    session = first_cursor.rpartition(":")[0]
    oldest = first_entries[0]["sequence"]

    def has_entry_after(sequence: int) -> bool:
        return bool(client.read_log(f"{session}:{sequence}", source)[3])

    # Gallop until no entry follows, then bisect for the last sequence that
    # still has a successor; the newest entry is the one after it.
    low = oldest
    step = 1
    high = oldest + step
    while has_entry_after(high):
        low = high
        step *= 2
        high = oldest + step
    while high - low > 1:
        middle = (low + high) // 2
        if has_entry_after(middle):
            low = middle
        else:
            high = middle
    newest = low + 1
    start_after = max(oldest - 1, newest - lines)
    return f"{session}:{start_after}"


def stream_usb_logs(
    client: UsbControlClient,
    *,
    cursor: str | None,
    lines: int | None,
    follow: bool,
    interval: float,
    source: str,
) -> None:
    initial_entries: list[dict[str, Any]] = []
    catching_up = lines is not None
    if catching_up and cursor is None and lines:
        # LOG_READ returns one entry per round trip, so walking the whole
        # retained log to print its last N lines is O(retained) and never
        # catches up with an App that logs faster than the channel pages.
        # Locate the tail first and start just before it.
        cursor = usb_log_tail_cursor(client, source, lines)
    try:
        while True:
            cursor, has_more, truncated, entries = client.read_log(cursor, source)
            if truncated:
                print("micropixel: retained system logs were truncated before this cursor", file=sys.stderr)
            if catching_up:
                initial_entries.extend(entries)
                if lines == 0:
                    initial_entries.clear()
                elif lines is not None and len(initial_entries) > lines:
                    del initial_entries[:-lines]
            else:
                print_log_entries(entries)
            if catching_up and not has_more:
                print_log_entries(initial_entries)
                catching_up = False
            if not follow and not has_more:
                break
            if not has_more:
                time.sleep(interval)
    except KeyboardInterrupt:
        print("\nStopped following logs; the App is still running.", file=sys.stderr)


def active_remote_app_id(snapshot: dict[str, Any]) -> str | None:
    status = snapshot.get("status")
    runtime = status.get("runtime") if isinstance(status, dict) else None
    sessions = runtime.get("runtimeSessions") if isinstance(runtime, dict) else None
    if not isinstance(sessions, list):
        return None
    foreground_session_id = runtime.get("foregroundSessionId")
    ordered = sorted(
        (session for session in sessions if isinstance(session, dict)),
        key=lambda session: session.get("sessionId") != foreground_session_id,
    )
    for session in ordered:
        app_id = session.get("appId")
        if isinstance(app_id, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", app_id) is not None:
            return app_id
    return None


def remote_app_action(
    client: ControlClient,
    args: argparse.Namespace,
    app_id: str,
    action: str,
    idempotency_scope: str,
    launch_arguments: list[str] | None = None,
) -> dict[str, Any]:
    encoded_app_id = quote_identifier(app_id)
    job = create_job(
        client,
        args,
        "POST",
        client.device_path(f"/apps/{encoded_app_id}/actions/{action}"),
        {"launchArguments": validate_launch_arguments(launch_arguments)} if action == "start" and launch_arguments else {},
        idempotency_scope=idempotency_scope,
    )
    return client.wait_job(job, args.timeout)


def restore_remote_app(client: ControlClient, args: argparse.Namespace, app_id: str | None) -> None:
    if app_id is None:
        return
    try:
        remote_app_action(client, args, app_id, "start", "run-restore")
        print(f"Restored previously running App {app_id}.", file=sys.stderr)
    except CliError as error:
        print(f"micropixel: could not restore previously running App {app_id}: {error}", file=sys.stderr)


def run_network_app(args: argparse.Namespace, client: ControlClient) -> None:
    snapshot = client.json("GET", client.device_path())
    previous_app_id = active_remote_app_id(snapshot)
    require_compatible_firmware(client)

    bundle = Path(args.bundle)
    details = validate_bundle(bundle)
    catalog = client.json("GET", client.device_path("/apps"))
    already_current = (
        isinstance(catalog, dict)
        and not bool(getattr(args, "force", False))
        and bundle_matches_installed(catalog, details["appId"], details["sizeBytes"], details["sha256"])
    )

    stop_job = create_job(
        client,
        args,
        "POST",
        client.device_path("/runtime/foreground/stop"),
        {},
        idempotency_scope="run-stop",
    )
    client.wait_job(stop_job, args.timeout)
    if previous_app_id is not None:
        print(f"Stopped {previous_app_id}.", file=sys.stderr)

    try:
        if already_current:
            print(f"Installed {args.app_id} is already current.", file=sys.stderr)
        else:
            package = upload(client, bundle, getattr(args, "aot_target", None))
            package_id = package.get("packageId")
            install_job = create_job(
                client,
                args,
                "POST",
                client.device_path("/apps/install"),
                {"packageId": package_id},
                idempotency_scope="run-install",
            )
            client.wait_job(install_job, args.timeout)
            print(f"Installed {args.app_id}.", file=sys.stderr)
        remote_app_action(client, args, args.app_id, "start", "run-start", getattr(args, "launch_arguments", []))
        print(f"Started {args.app_id}.", file=sys.stderr)
    except CliError:
        restore_remote_app(client, args, previous_app_id)
        raise

    if args.follow:
        print("Following Guest logs; press Ctrl-C to detach.", file=sys.stderr)
        stream_network_logs(
            client,
            cursor=None,
            lines=None,
            follow=True,
            interval=args.interval,
            timeout=args.timeout,
            command_timeout_ms=getattr(args, "command_timeout_ms", None),
            source="app",
        )


def start_usb_app(client: UsbControlClient, app_id: str, launch_arguments: list[str] | None = None) -> dict[str, Any]:
    """APP_START that explains a failed launch.

    The device only answers ``app_start_failed`` when the Guest dies during
    startup; the reason (phase, code and the Guest's own ``panic: ...`` line) is
    kept in its last App diagnostic, so fetch it and put it in the error.
    """
    try:
        if launch_arguments:
            return client.action("APP_START", app_id, launch_arguments)
        return client.action("APP_START", app_id)
    except CliError as error:
        if "app_start_failed" not in str(error) and "app_started_and_exited" not in str(error):
            raise
        try:
            diagnostic = client.last_app_error()
        except CliError:
            raise error from None
        if diagnostic.get("appId") != app_id:
            raise
        lines = [str(error), f"  phase={diagnostic.get('phase')} code={diagnostic.get('code')}"]
        if diagnostic.get("detail"):
            lines.append(f"  detail: {diagnostic['detail']}")
        if "exitCode" in diagnostic:
            lines.append(f"  exit code: {diagnostic['exitCode']}")
        if diagnostic.get("recommendation"):
            lines.append(f"  {diagnostic['recommendation']}")
        raise CliError("\n".join(lines)) from None


def restore_usb_app(client: UsbControlClient, app_id: str | None) -> None:
    if app_id is None:
        return
    try:
        client.action("APP_START", app_id)
        print(f"Restored previously running App {app_id}.", file=sys.stderr)
    except CliError as error:
        print(f"micropixel: could not restore previously running App {app_id}: {error}", file=sys.stderr)


def install_usb_with_progress(
    client: UsbControlClient,
