    for mode in (press, tap, swipe, sequence):
        mode.add_argument("--screenshot", metavar="JPEG", help="Append a screenshot to the same device Job")
        add_job_options(mode)
    for command in (
        diagnostics,
        reboot,
        firmware_update,
        run,
        app_list,
        install,
        start,
        stop,
        uninstall,
        screenshot,
    ):
        add_job_options(command)
    logs.add_argument("--wait-timeout", "--timeout", dest="timeout", type=float, default=300.0)
    logs.add_argument("--command-timeout-ms", type=int)

    job = commands.add_parser("job", help="Resume waiting for an existing Control Job")
    job_modes = job.add_subparsers(dest="job_command", required=True)
    job_wait = job_modes.add_parser("wait", help="Wait for a Job UUID to reach a terminal state")
    job_wait.add_argument("job_id")
    job_wait.add_argument("--wait-timeout", "--timeout", dest="timeout", type=float, default=300.0)
    return result


def resolve_transport(args: argparse.Namespace) -> argparse.Namespace:
    if args.transport is None:
        if args.port:
            args.transport = "usb"
        else:
            args.transport = os.environ.get("MICROPIXEL_TRANSPORT", "remote")
        return args
    if args.transport == "remote" and args.port:
        raise CliError("--port implies USB transport; omit --transport remote or pass --transport usb")
    return args


def parse_command_line(arguments: list[str] | None = None) -> argparse.Namespace:
    raw = list(sys.argv[1:] if arguments is None else arguments)
    if "--" not in raw:
        return resolve_transport(parser().parse_args(raw))
    separator = raw.index("--")
    try:
        parsed = parser().parse_args(raw[:separator])
    except SystemExit:
        return resolve_transport(parser().parse_args(raw))
    supports_launch_arguments = parsed.command == "run" or (
        parsed.command == "app" and getattr(parsed, "app_command", None) == "start"
    )
    if not supports_launch_arguments:
        return resolve_transport(parser().parse_args(raw))
    parsed.launch_arguments = validate_launch_arguments(raw[separator + 1 :])
    return resolve_transport(parsed)


def main() -> int:
    global _CLI_ERROR, _CLI_RESULT
    try:
        args = parse_command_line()
        if _CLI_JSON_MODE:
            if args.command not in {"init", "build", "package", "publish", "run"}:
                raise CliUsageError("--json is supported for init/build/package/publish/run --no-follow")
            if args.command == "run" and args.follow:
                raise CliUsageError("JSON run requires --no-follow; use separate log commands afterward")
        if args.command == "validate":
            print("micropixel: 'validate' is deprecated; use 'bundle validate'", file=sys.stderr)
        if args.command == "auth" and args.auth_command == "login":
            print("micropixel: 'auth login' is deprecated; use 'auth pair'", file=sys.stderr)
        if args.command == "app" and args.app_command == "upload":
            print("micropixel: 'app upload' is deprecated; use 'artifact upload'", file=sys.stderr)

        if args.command == "publish":
            run_publish(args)
        elif args.command == "auth" and args.auth_command in {"github", "status", "logout"}:
            run_developer_auth(args)
        elif args.command == "init":
            run_init(args)
            _CLI_RESULT = {"project": str(Path(args.directory).resolve())}
        elif args.command == "build":
            run_build(args)
        elif args.command == "package":
            run_package(args)
        elif args.command == "run":
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    bundle = prepare_connected_bundle(args, usb_device_aot_target(client), run_input)
                    args.bundle = str(bundle)
                    args.app_id = validate_bundle(bundle)["appId"]
                    run_usb_app(args, client)
            else:
                client = ControlClient(ControlConfig.load(Path.cwd()))
                bundle = prepare_connected_bundle(args, network_device_aot_target(client), run_input)
                args.bundle = str(bundle)
                args.app_id = validate_bundle(bundle)["appId"]
                run_network_app(args, client)
        elif args.command == "app" and args.app_command == "install":
            if args.follow and not args.start:
                raise CliError("app install --follow requires --start")
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    bundle = prepare_connected_bundle(args, usb_device_aot_target(client), install_input)
                    args.bundle = str(bundle)
                    args.app_id = validate_bundle(bundle)["appId"]
                    execute_usb(args, client)
            else:
                client = ControlClient(ControlConfig.load(Path.cwd()))
                bundle = prepare_connected_bundle(args, network_device_aot_target(client), install_input)
                args.bundle = str(bundle)
                args.app_id = validate_bundle(bundle)["appId"]
                execute_network(args, client)
        elif args.command == "app" and args.app_command == "start":
            if args.app_id is None:
                args.app_id = current_project_app_id()
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    execute_usb(args, client)
            else:
                execute_network(args, ControlClient(ControlConfig.load(Path.cwd())))
        elif args.command == "bundle" and args.bundle_command == "validate":
            print_json(validate_bundle(Path(args.bundle)))
        elif args.command == "validate":
            print_json(validate_bundle(Path(args.bundle)))
        elif args.command == "auth" and args.auth_command in {"pair", "login"}:
            run_auth_pair(args)
        elif args.command == "port" and args.port_command == "list":
            print_json(list_local_ports(args.all, args.timeout))
        elif args.command in NETWORK_COMMANDS:
            if args.transport == "usb":
                with UsbControlClient(args.port, getattr(args, "timeout", 300.0)) as client:
                    execute_usb(args, client)
            else:
                execute_network(args, ControlClient(ControlConfig.load(Path.cwd())))
        else:
            raise CliError(f"Unsupported command: {args.command}")
        return 0
    except (CliError, FileNotFoundError, PermissionError, subprocess.CalledProcessError) as error:
        _CLI_ERROR = {"code": getattr(error, "diagnostic_code", "execution_failed"), "message": str(error)}
        print(f"micropixel: {error}", file=sys.stderr)
        return getattr(error, "exit_code", 1)


def entrypoint() -> int:
    global _CLI_JSON_MODE, _CLI_RESULT, _CLI_ERROR
    raw = sys.argv[1:]
    boundary = raw.index("--") if "--" in raw else len(raw)
    if "--json" not in raw[:boundary]:
        return main()
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, 'reconfigure'):
            stream.reconfigure(encoding='utf-8')
    _CLI_JSON_MODE = True
    _CLI_RESULT = None
    _CLI_ERROR = None
    _CLI_ARTIFACTS.clear()
    sys.argv = [sys.argv[0], *[v for v in raw[:boundary] if v != "--json"], *raw[boundary:]]
    output = sys.stdout
    code = 1
    with contextlib.redirect_stdout(sys.stderr):
        try:
            code = main()
        except SystemExit as error:
            code = int(error.code or 0)
            if code:
                _CLI_ERROR = {"code": "invalid_arguments", "message": "See stderr for argument usage"}
        except (OSError, ValueError) as error:
            _CLI_ERROR = {"code": "execution_failed", "message": str(error)}
        except KeyboardInterrupt:
            _CLI_ERROR = {"code": "interrupted", "message": "Operation interrupted"}
    result = {"sdk_version": VERSION, "toolchain_id": os.environ.get("MICROPIXEL_TOOLCHAIN_ID"),
              "artifacts": list(_CLI_ARTIFACTS)}
    if isinstance(_CLI_RESULT, dict):
        result.update(_CLI_RESULT)
    elif _CLI_RESULT is not None:
        result["data"] = _CLI_RESULT
    print(json.dumps({"schema_version": 1, "ok": code == 0,
                      "code": "ok" if code == 0 else (_CLI_ERROR or {}).get("code", "execution_failed"),
                      "result": result, "error": _CLI_ERROR, "warnings": []}, ensure_ascii=False), file=output)
    return code


if __name__ == "__main__":
    raise SystemExit(entrypoint())
