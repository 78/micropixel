# KSDIY ESP32-P4C5 4.3-inch board, layered after sdkconfig.p4.defaults.
# CONFIG_MICROPIXEL_BOARD_METALIO_CLAW4 is not set
CONFIG_MICROPIXEL_BOARD_KSDIY_P4C5=y
# kevincoooool/ksdiy_p4c5_bsp scans out the RGB888 framebuffers LVGL renders.
# CONFIG_KSDIY_P4C5_LCD_RGB565 is not set
CONFIG_KSDIY_P4C5_LCD_RGB888=y

# 16 MiB flash; the 32 MiB-only bootloader option does not apply.
# CONFIG_ESPTOOLPY_FLASHSIZE_32MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.p4-16mb.csv"
# CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH is not set

# ESP32-P4 v3.x silicon: 400 MHz CPU and 250 MHz hex PSRAM.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
# CONFIG_ESP32P4_REV_MIN_100 is not set
CONFIG_ESP32P4_REV_MIN_300=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
# CONFIG_SPIRAM_SPEED_200M is not set
CONFIG_SPIRAM_SPEED_250M=y

# The ESP32-C5 coprocessor uses the SDIO Slot 1 pins of the P4 Function-EV
# layout; reset stays on GPIO54 as in sdkconfig.p4.defaults.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
