CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.p4.csv"

# Enable the 32 MiB DIO flash configuration used by the supported Metalio-Claw4 board.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y

# The attached ESP32-P4 has 16-line PSRAM. Keep standard malloc() internal;
# WAMR linear memory and the Host comparison buffer request PSRAM explicitly.
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The attached device is P4 rev 1.3. ESP-IDF treats pre-v3 and v3+ P4 as
# mutually incompatible targets; rev 1.x runs at 360 MHz.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Let an idle Host scale down to the XTAL frequency. The LVGL adapter holds its
# PM lock while active and releases it after its event-driven idle timeout.
# Automatic light sleep remains disabled until display/Wi-Fi retention has
# completed board-level validation.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Reserve enough shared interrupt stack for nested display, Wi-Fi and timer ISRs.
CONFIG_FREERTOS_ISR_STACKSIZE=2048
# The Host controller keeps running on the main task after startup. With the
# shared 14 KiB allowance its high-water mark drops to ~1 KiB once the boot-time
# QUIC firmware check has run, and an APP_START taken by an interrupt at that
# depth trips the hardware stack guard (observed: reboot back to the App Hall).
# The P4 has ample internal SRAM, so give the main task more headroom here.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
# Suppress periodic ticks while every runnable task is blocked. Runtime PM does
# not enable automatic light sleep; explicit Host sleep remains authoritative.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Metalio-Claw4 routes Wi-Fi through its ESP32-C5 coprocessor. The board does
# not use the ESP32-P4 Function-EV default SDIO pins.
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# esp_hosted derives ESP_HOSTED_SDIO_PIN_* from these user-configurable Slot 1
# symbols. Setting the derived symbols is ignored by current Kconfig versions.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=34
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=31
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=53
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# ESP32-P4 product path: retained Guest objects, PPA-assisted image copies,
# and bounded dirty-region coalescing.
CONFIG_MICROPIXEL_BOARD_METALIO_CLAW4=y
# ESP32-P4 uses the portable fixed-point RISC-V decoder path.
# CONFIG_OPUS_FLOATING_POINT is not set
# CONFIG_OPUS_ENABLE_XTENSA_OPTIMIZATIONS is not set
CONFIG_MICROPIXEL_SYSTEM_SHELL_SNAPSHOT=y
# Keep the RGB888 scratch buffer in internal SRAM for render speed, but limit
# it to 60 rows (129600 bytes). This returns another 129600 bytes of contiguous
# internal SRAM compared with the previous 120-row buffer.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=60
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set
# Merge nearby retained-object invalidations to limit repeated LVGL tree walks.
# Coalescing is always enabled; this bounds the extra overdraw per merge.
CONFIG_MICROPIXEL_LVGL_DIRTY_COALESCE_EXTRA_PIXELS=8192
CONFIG_LV_COLOR_DEPTH_24=y
# The Host shell, status panel and the Guest App Surface image share LVGL's
# fixed pool. Do not rely on run-time pool expansion in the display task.
CONFIG_LV_MEM_SIZE_KILOBYTES=96
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=0
# CONFIG_LV_USE_LODEPNG is not set
# main/CMakeLists.txt overrides LVGL's built-in default font with generated
# builtin-latin-v1/14. Explicitly disable the other duplicate sizes too.
# CONFIG_LV_FONT_MONTSERRAT_18 is not set
# CONFIG_LV_FONT_MONTSERRAT_24 is not set
# CONFIG_LV_FONT_MONTSERRAT_32 is not set
# ESP32-P4 revisions used by Metalio-Claw4 reject the ESP ECDSA peripheral at
# runtime. Keep TLS 1.3 CertificateVerify on the software path and do not link
# the unusable PSA hardware driver.
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set
# Keep every LVGL row 16-byte aligned without producing a fractional RGB888
# physical width: lcm(16-byte SIMD alignment, 3-byte RGB888 pixel) = 48 bytes.
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=48
