def run_usb_app(args: argparse.Namespace, client: UsbControlClient) -> None:
    status = client.device_status()
    runtime = status.get("runtime")
    previous_app_id = runtime.get("activeAppId") if isinstance(runtime, dict) else None
    if not isinstance(previous_app_id, str):
        previous_app_id = None

    bundle = Path(args.bundle)
    details = validate_bundle(bundle)
    catalog = client.list_apps()
    already_current = not bool(getattr(args, "force", False)) and bundle_matches_installed(
        catalog, details["appId"], details["sizeBytes"], details["sha256"]
    )

    client.action("APP_STOP")
    if previous_app_id is not None:
        print(f"Stopped {previous_app_id}.", file=sys.stderr)

    try:
        if already_current:
            print(f"Installed {args.app_id} is already current.", file=sys.stderr)
        else:
            install_usb_with_progress(
                client,
                bundle,
                args.app_id,
                getattr(args, "aot_target", None),
                catalog=catalog,
                force=bool(getattr(args, "force", False)),
            )
            print(f"Installed {args.app_id}.", file=sys.stderr)
        start_usb_app(client, args.app_id, getattr(args, "launch_arguments", []))
        print(f"Started {args.app_id}.", file=sys.stderr)
    except CliError:
        restore_usb_app(client, previous_app_id)
        raise

    if args.follow:
        print("Following Guest logs; press Ctrl-C to detach.", file=sys.stderr)
        stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")


def non_negative_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a non-negative integer") from error
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be a non-negative integer")
    return parsed


def screenshot_artifact(client: ControlClient, completed: dict[str, Any], output: Path) -> None:
    result = completed.get("result")
    screenshots = result.get("screenshots") if isinstance(result, dict) else None
    first = screenshots[0] if isinstance(screenshots, list) and screenshots else None
    url = first.get("downloadUrl") if isinstance(first, dict) else None
    if not isinstance(url, str) or not url.startswith("/"):
        raise CliError("Job completed without a valid screenshot artifact URL")
    image, media_type = client.request("GET", url, timeout=60.0)
    if media_type != "image/jpeg" or len(image) < 4 or image[:2] != b"\xff\xd8" or image[-2:] != b"\xff\xd9":
        raise CliError("Screenshot artifact is not a valid JPEG")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(image)


def bounded_argument(value: int, minimum: int, maximum: int, label: str) -> int:
    if not minimum <= value <= maximum:
        raise CliError(f"{label} must be between {minimum} and {maximum}")
    return value


def input_operations(args: argparse.Namespace) -> list[dict[str, Any]]:
    if args.input_command == "press":
        hold_ms = bounded_argument(args.hold_ms, 0, 5_000, "--hold-ms")
        operations: list[dict[str, Any]] = [
            {"type": "key", "code": args.code, "phase": "down"},
            {"type": "key", "code": args.code, "phase": "up", "delayMs": hold_ms},
        ]
    elif args.input_command == "tap":
        x = bounded_argument(args.x, 0, 0x7FFF_FFFF, "x")
        y = bounded_argument(args.y, 0, 0x7FFF_FFFF, "y")
        pressure = bounded_argument(args.pressure, 0, 1_000, "--pressure")
        hold_ms = bounded_argument(args.hold_ms, 0, 5_000, "--hold-ms")
        operations = [
            {"type": "touch", "phase": "down", "id": 0, "x": x, "y": y, "pressurePerMille": pressure},
            {
                "type": "touch",
                "phase": "up",
                "id": 0,
                "x": x,
                "y": y,
                "pressurePerMille": 0,
                "delayMs": hold_ms,
            },
        ]
    elif args.input_command == "swipe":
        x1 = bounded_argument(args.x1, 0, 0x7FFF_FFFF, "x1")
        y1 = bounded_argument(args.y1, 0, 0x7FFF_FFFF, "y1")
        x2 = bounded_argument(args.x2, 0, 0x7FFF_FFFF, "x2")
        y2 = bounded_argument(args.y2, 0, 0x7FFF_FFFF, "y2")
        pressure = bounded_argument(args.pressure, 0, 1_000, "--pressure")
        duration_ms = bounded_argument(args.duration_ms, 0, 5_000, "--duration-ms")
        steps = bounded_argument(args.steps, 2, 13, "--steps")
        step_delay = duration_ms // (steps - 1)
        operations = []
        for index in range(steps):
            fraction = index / (steps - 1)
            operations.append(
                {
                    "type": "touch",
                    "phase": "down" if index == 0 else "move",
                    "id": 0,
                    "x": round(x1 + (x2 - x1) * fraction),
                    "y": round(y1 + (y2 - y1) * fraction),
                    "pressurePerMille": pressure,
                    **({"delayMs": step_delay} if index else {}),
                }
            )
        operations.append(
            {"type": "touch", "phase": "up", "id": 0, "x": x2, "y": y2, "pressurePerMille": 0}
        )
    elif args.input_command == "sequence":
        try:
            text = sys.stdin.read() if args.file == "-" else Path(args.file).read_text(encoding="utf-8")
            value = json.loads(text)
        except (OSError, json.JSONDecodeError) as error:
            raise CliError(f"Cannot read input sequence: {error}") from error
        raw_operations = value.get("operations") if isinstance(value, dict) else value
        if not isinstance(raw_operations, list) or not all(isinstance(item, dict) for item in raw_operations):
            raise CliError("Input sequence must be a JSON operation array or an object containing operations")
        operations = raw_operations
    else:
        raise CliError(f"Unsupported input command: {args.input_command}")

    if args.screenshot:
        if len(operations) >= 16:
            raise CliError("Input sequence has no room for the requested screenshot operation")
        operations.append({"type": "screenshot", "id": "after-input", "delayMs": 120})
    if not 1 <= len(operations) <= 16:
        raise CliError("Input sequence must contain between 1 and 16 operations")
    return operations


def execute_network(args: argparse.Namespace, client: ControlClient) -> None:
    if args.command == "device" and args.device_command == "status":
        snapshot = client.json("GET", client.device_path())
        if args.full:
            print_json(snapshot)
            return
        status = snapshot.get("status")
        status = status if isinstance(status, dict) else {}
        runtime = status.get("runtime")
        runtime = runtime if isinstance(runtime, dict) else {}
        print_json(
            {
                "online": snapshot.get("online") is True,
                "foregroundSessionId": runtime.get("foregroundSessionId"),
                "foregroundSurface": runtime.get("foregroundSurface"),
                "runtimeSessions": runtime.get("runtimeSessions", []),
                "network": status.get("network"),
                "firmwareUpdate": status.get("firmwareUpdate"),
                "lastSeenAt": snapshot.get("lastSeenAt"),
            }
        )
    elif args.command == "device" and args.device_command == "diagnostics":
        if not args.cached:
            system_job = create_job(
                client,
                args,
                "POST",
                client.device_path("/system-info/refresh"),
                {},
                idempotency_scope="system-info",
            )
            client.wait_job(system_job, args.timeout)
            task_job = create_job(
                client,
                args,
                "POST",
                client.device_path("/task-diagnostics/refresh"),
                {},
                idempotency_scope="task-diagnostics",
            )
            client.wait_job(task_job, args.timeout)
        system_info = client.json("GET", client.device_path("/system-info"))
        task_diagnostics = client.json("GET", client.device_path("/task-diagnostics"))
        print_json({**system_info, "taskDiagnostics": task_diagnostics})
    elif args.command == "device" and args.device_command == "reboot":
        job = create_job(client, args, "POST", client.device_path("/reboot"), {})
        print_json(client.wait_job(job, args.timeout))
    elif args.command == "firmware":
        snapshot = client.json("GET", client.device_path())
        status = snapshot.get("status")
        current_version = status.get("firmwareVersion") if isinstance(status, dict) else None
        query = ""
        body: dict[str, str] = {}
        if isinstance(current_version, str) and current_version:
            encoded = urllib.parse.quote(current_version, safe="")
            query = f"?currentVersion={encoded}"
            body["currentVersion"] = current_version
        if args.firmware_command == "status":
            print_json(client.json("GET", client.device_path(f"/firmware/latest{query}")))
        elif args.firmware_command == "update":
            if snapshot.get("online") is not True:
                raise CliError("The device is offline. Bring it online before updating its firmware.")
            job = create_job(client, args, "POST", client.device_path("/firmware/update"), body)
            print_json(client.wait_job(job, args.timeout))
    elif args.command == "app" and args.app_command == "list":
        if not args.cached:
            job = create_job(client, args, "POST", client.device_path("/apps/refresh"), {})
            client.wait_job(job, args.timeout)
        catalog = client.json("GET", client.device_path("/apps"))
        if args.running:
            apps = catalog.get("apps")
            if isinstance(apps, list):
                running_states = {"running", "foreground", "starting", "resuming", "suspended"}
                filtered = [
                    app
                    for app in apps
                    if isinstance(app, dict)
                    and (app.get("active") is True or app.get("lifecycle") in running_states)
                ]
                catalog = {**catalog, "apps": filtered, "count": len(filtered)}
        print_json(catalog)
    elif args.command == "app" and args.app_command == "last-error":
        response = client.json("GET", client.device_path("/app-errors/latest"))
        diagnostic = response.get("error")
        if isinstance(diagnostic, dict):
            recommendation = app_failure_recommendation(diagnostic)
            print_json({**diagnostic, **({"recommendation": recommendation} if recommendation else {})})
        else:
            print_json(response)
    elif args.command == "artifact" and args.artifact_command == "upload":
        print_json(upload(client, Path(args.bundle), getattr(args, "aot_target", None)))
    elif args.command == "app" and args.app_command == "upload":
        print_json(upload(client, Path(args.bundle), getattr(args, "aot_target", None)))
    elif args.command == "app" and args.app_command == "install":
        bundle = Path(args.bundle)
        details = validate_bundle(bundle)
        catalog = client.json("GET", client.device_path("/apps"))
        if (
            isinstance(catalog, dict)
            and not bool(getattr(args, "force", False))
            and bundle_matches_installed(catalog, details["appId"], details["sizeBytes"], details["sha256"])
        ):
            print_json(already_installed_result(details["appId"], details["sizeBytes"], "remote"))
            if getattr(args, "start", False):
                require_compatible_firmware(client)
                app_id = quote_identifier(args.app_id)
                start_job = create_job(
                    client,
                    args,
                    "POST",
                    client.device_path(f"/apps/{app_id}/actions/start"),
                    {},
                    idempotency_scope="start",
                )
                print_json(client.wait_job(start_job, args.timeout))
                if getattr(args, "follow", False):
                    stream_network_logs(
                        client,
                        cursor=None,
                        lines=None,
                        follow=True,
                        interval=args.interval,
                        timeout=args.timeout,
                        command_timeout_ms=getattr(args, "command_timeout_ms", None),
                        source="app",
                    )
            return
        package = upload(client, bundle, getattr(args, "aot_target", None))
        package_id = package.get("packageId")
        job = create_job(client, args, "POST", client.device_path("/apps/install"), {"packageId": package_id})
        print_json(client.wait_job(job, args.timeout))
        if getattr(args, "start", False):
            require_compatible_firmware(client)
            app_id = quote_identifier(args.app_id)
            start_job = create_job(
                client,
                args,
                "POST",
                client.device_path(f"/apps/{app_id}/actions/start"),
                {},
                idempotency_scope="start",
            )
            print_json(client.wait_job(start_job, args.timeout))
            if getattr(args, "follow", False):
                stream_network_logs(
                    client,
                    cursor=None,
                    lines=None,
                    follow=True,
                    interval=args.interval,
                    timeout=args.timeout,
                    command_timeout_ms=getattr(args, "command_timeout_ms", None),
                    source="app",
                )
    elif args.command == "app" and args.app_command in {"start", "stop"}:
        if args.app_command == "stop" and args.app_id is None:
            job = create_job(client, args, "POST", client.device_path("/runtime/foreground/stop"), {})
            print_json(client.wait_job(job, args.timeout))
            return
        if args.app_command == "start":
            require_compatible_firmware(client)
        app_id = quote_identifier(args.app_id)
        action = args.app_command
        action_body = (
            {"launchArguments": validate_launch_arguments(getattr(args, "launch_arguments", []))}
            if action == "start" and getattr(args, "launch_arguments", [])
            else {}
        )
        job = create_job(client, args, "POST", client.device_path(f"/apps/{app_id}/actions/{action}"), action_body)
        print_json(client.wait_job(job, args.timeout))
        if args.app_command == "start" and getattr(args, "follow", False):
            stream_network_logs(
                client,
                cursor=None,
                lines=None,
                follow=True,
                interval=args.interval,
                timeout=args.timeout,
                command_timeout_ms=getattr(args, "command_timeout_ms", None),
                source="app",
            )
    elif args.command == "app" and args.app_command == "uninstall":
        app_id = quote_identifier(args.app_id)
        job = create_job(client, args, "DELETE", client.device_path(f"/apps/{app_id}"))
        print_json(client.wait_job(job, args.timeout))
    elif args.command == "logs":
        stream_network_logs(
            client,
            cursor=args.cursor,
            lines=args.lines,
            follow=args.follow,
            interval=args.interval,
            timeout=args.timeout,
            command_timeout_ms=getattr(args, "command_timeout_ms", None),
            source=getattr(args, "source", "all"),
        )
    elif args.command == "screenshot":
        job = create_job(client, args, "POST", client.device_path("/screenshots"), {})
        completed = client.wait_job(job, args.timeout)
        output = Path(args.output)
        screenshot_artifact(client, completed, output)
        print(output)
    elif args.command == "input":
        operations = input_operations(args)
        job = create_job(client, args, "POST", client.device_path("/input-sequences"), {"operations": operations})
        completed = client.wait_job(job, args.timeout)
        if args.screenshot:
            screenshot_artifact(client, completed, Path(args.screenshot))
        print_json(completed)
    elif args.command == "job" and args.job_command == "wait":
        try:
            job_id = str(uuid.UUID(args.job_id))
        except ValueError as error:
            raise CliError("job wait requires a valid Job UUID") from error
        print_json(client.wait_job({"id": job_id}, args.timeout))


def execute_usb(args: argparse.Namespace, client: UsbControlClient) -> None:
    if args.command == "device" and args.device_command == "status":
        print_json(client.device_status())
    elif args.command == "device" and args.device_command == "diagnostics":
        print_json({**client.device_status(), "taskDiagnostics": client.task_diagnostics()})
    elif args.command == "device" and args.device_command == "reboot":
        print_json(client.action("DEVICE_REBOOT"))
    elif args.command == "app" and args.app_command == "list":
        catalog = client.list_apps()
        if args.running:
            apps = [app for app in catalog["apps"] if app.get("active") is True]
            catalog = {**catalog, "apps": apps, "count": len(apps)}
        print_json(catalog)
    elif args.command == "app" and args.app_command == "last-error":
        print_json(client.last_app_error())
    elif args.command == "app" and args.app_command == "install":
        print_json(
            install_usb_with_progress(
                client,
                Path(args.bundle),
                args.app_id,
                getattr(args, "aot_target", None),
                force=bool(getattr(args, "force", False)),
            )
        )
        if getattr(args, "start", False):
            print_json(start_usb_app(client, args.app_id))
            if getattr(args, "follow", False):
                stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")
    elif args.command == "app" and args.app_command == "start":
        print_json(start_usb_app(client, args.app_id, getattr(args, "launch_arguments", [])))
        if getattr(args, "follow", False):
            stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")
    elif args.command == "app" and args.app_command == "stop":
        print_json(client.action("APP_STOP", args.app_id))
    elif args.command == "app" and args.app_command == "uninstall":
        print_json(client.action("APP_UNINSTALL", args.app_id))
    elif args.command == "logs":
        stream_usb_logs(
            client,
            cursor=args.cursor,
            lines=args.lines,
            follow=args.follow,
            interval=args.interval,
            source=getattr(args, "source", "all"),
        )
    elif args.command == "screenshot":
        jpeg, _width, _height = client.capture_screen()
        output = Path(args.output)
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(jpeg)
        print(output)
    elif args.command == "input":
        operations = input_operations(args)
        capture_requested = any(operation.get("type") == "screenshot" for operation in operations)
        input_only = [operation for operation in operations if operation.get("type") != "screenshot"]
        completed = (
            client.input_sequence(input_only)
            if input_only
            else {"status": "succeeded", "result": {"message": "no_input"}, "transport": "usb"}
        )
        if capture_requested:
            jpeg, width, height = client.capture_screen()
            if args.screenshot:
                output = Path(args.screenshot)
                output.parent.mkdir(parents=True, exist_ok=True)
                output.write_bytes(jpeg)
                completed["result"]["screenshot"] = {
                    "path": str(output), "width": width, "height": height, "mediaType": "image/jpeg"
                }
        print_json(completed)
    elif args.command == "firmware" and args.firmware_command == "status":
        print_json(client.firmware_status())
    elif args.command == "firmware" and args.firmware_command == "update":
        print_json(client.action("FIRMWARE_UPDATE"))
    else:
        suffix = getattr(args, "app_command", getattr(args, "device_command", ""))
        raise CliError(f"{args.command} {suffix}".strip() + " is not available over USB")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="micropixel", description=__doc__)
    result.add_argument("--version", action="version", version=f"micropixel {VERSION}")
    result.add_argument("--json", action="store_true", help="One final JSON result for init/build/package/publish/run --no-follow; diagnostics go to stderr")
    result.add_argument(
        "--transport",
        choices=["remote", "usb"],
        default=None,
        help="Device transport for control commands (default: usb when --port is set, otherwise remote)",
    )
    result.add_argument(
        "--port",
        help="USB Serial/JTAG port; implies --transport usb. Auto-detected when one ESP32 device is connected",
    )
    commands = result.add_subparsers(dest="command", required=True)

    init = commands.add_parser("init", help="Create app.json from existing sources or scaffold a new Guest App")
    init.add_argument("directory", nargs="?", default=".", help="Project directory (default: .)")
    init.add_argument("--app-id", help="Stable App ID (default: local.<directory-name>)")
    init.add_argument("--title", help="App Hall display name (default: directory name)")
    init.add_argument("--version", dest="app_version", default="0.1.0", help="App major.minor.patch (default: 0.1.0)")
    init.add_argument("--source", dest="sources", action="append", help="Source relative to the project; repeat to replace auto-discovery")

    publish = commands.add_parser("publish", help="Build and publish an App to the MicroPixel App Store")
    publish.add_argument("project", nargs="?", default=".")
    publish.add_argument("--dry-run", action="store_true")
    publish.add_argument("--force", action="store_true")
    publish.add_argument("--output-dir")
    publish.add_argument("--notes-file")
    publish.add_argument("--tested-device", action="append", choices=["metalio-claw4", "esp-mosaico", "esp-box-3", "szpi-esp32s3", "m5stack-cores3"], default=[])

    build = commands.add_parser("build", help="Build an app.json project into Wasm and AOT")
    build.add_argument("source", nargs="?", default=".", help="Project directory, app.json, or legacy C++ source")
    build.add_argument("extra_source", nargs="*")
    build.add_argument("--name")
    build.add_argument("--profile", choices=["development", "release", "size", "performance"], default="development")
    build.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    build.add_argument("--output-dir", help="Build output directory")
    build.add_argument("--unchecked-memory", action="store_true", help="Compile the AOT without linear-memory bounds checks; the Bundle is flagged and only Hosts built with CONFIG_MICROPIXEL_ALLOW_UNCHECKED_AOT accept it")
    build.add_argument("--force", action="store_true", help="Rebuild even when no input is newer than the existing output")

    package = commands.add_parser("package", help="Build an app.json project into an installable Bundle v1")
    package.add_argument("project", nargs="?", default=".", help="Project directory or app.json (default: .)")
    package.add_argument("--profile", choices=["development", "release", "size", "performance"], default="release")
    package.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    package.add_argument("--output-dir", help="Build output directory")
    package.add_argument("--output", help="Bundle output path")
    package.add_argument("--unchecked-memory", action="store_true", help="Compile the AOT without linear-memory bounds checks; the Bundle is flagged and only Hosts built with CONFIG_MICROPIXEL_ALLOW_UNCHECKED_AOT accept it")
    package.add_argument("--force", action="store_true", help="Rebuild even when no input is newer than the existing Bundle")
    package.add_argument(
        "--raw",
        nargs=argparse.REMAINDER,
        help=argparse.SUPPRESS,
    )

    run = commands.add_parser("run", help="Build, install, start, and attach to an App project")
    run.add_argument("project", nargs="?", default=".", help="Project directory or app.json (default: .)")
    run.add_argument("--profile", choices=["development", "release", "size", "performance"], default="development")
    run.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    run.add_argument("--output-dir", help="Build output directory")
    run.add_argument("--output", help="Bundle output path")
    run.add_argument("--unchecked-memory", action="store_true", help="Compile the AOT without linear-memory bounds checks; the Bundle is flagged and only Hosts built with CONFIG_MICROPIXEL_ALLOW_UNCHECKED_AOT accept it")
    run.add_argument("--force", action="store_true", help="Rebuild even when no input is newer than the existing Bundle")
    run.add_argument(
        "--no-follow",
        dest="follow",
        action="store_false",
        help="Return after starting instead of following Guest logs",
    )
    run.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    run.set_defaults(follow=True)
    run.set_defaults(launch_arguments=[])

    bundle = commands.add_parser("bundle", help="Inspect and validate MicroPixel Bundles")
    bundle_modes = bundle.add_subparsers(dest="bundle_command", required=True)
    bundle_validate = bundle_modes.add_parser("validate", help="Validate a Bundle v1 header")
    bundle_validate.add_argument("bundle")

    validate = commands.add_parser("validate", help="Deprecated alias for 'bundle validate'")
    validate.add_argument("bundle")

    auth = commands.add_parser("auth", help="Pair a device and manage Control API authentication")
    auth_modes = auth.add_subparsers(dest="auth_command", required=True)

    def add_pair_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("--connection-code", required=True, help="One-time code shown on the device")
        command.add_argument("--env-file", default=".env", help="Local environment file to update (default: .env)")
        command.add_argument("--control-url", help="Control API origin (default: MICROPIXEL_CONTROL_URL or production)")

    github = auth_modes.add_parser("github", help="Sign in as a GitHub developer for publishing")
    github.add_argument("--no-browser", action="store_true")
    auth_modes.add_parser("status", help="Show the developer account")
    auth_modes.add_parser("logout", help="Revoke developer credentials; keep device pairing")
    pair = auth_modes.add_parser("pair", help="Exchange a device connection code for a permanent API token")
    add_pair_options(pair)
    login = auth_modes.add_parser("login", help="Deprecated alias for 'auth pair'")
    add_pair_options(login)

    device = commands.add_parser("device", help="Read device connection state and runtime diagnostics")
    device_modes = device.add_subparsers(dest="device_command", required=True)
    status = device_modes.add_parser("status", help="Show online state, current App, network, and firmware state")
    status.add_argument("--full", action="store_true", help="Show the complete cached Control API snapshot")
    diagnostics = device_modes.add_parser("diagnostics", help="Refresh hardware, memory, task, and runtime details")
    diagnostics.add_argument("--cached", action="store_true", help="Read the last snapshot without refreshing the device")
    reboot = device_modes.add_parser("reboot", help="Reboot the device")

    port = commands.add_parser("port", help="Discover local serial ports and MicroPixel hardware")
    port_modes = port.add_subparsers(dest="port_command", required=True)
    port_list = port_modes.add_parser("list", help="List local MicroPixel ports, boards, and chip types")
    port_list.add_argument(
        "--all", action="store_true", help="Include serial ports that are not MicroPixel candidates"
    )
    port_list.add_argument("--timeout", type=float, default=2.0, help="Handshake timeout per candidate port")

    firmware = commands.add_parser("firmware", help="Check or install device firmware updates")
    firmware_modes = firmware.add_subparsers(dest="firmware_command", required=True)
    firmware_modes.add_parser("status", help="Show the installed and latest firmware versions")
    firmware_update = firmware_modes.add_parser("update", help="Install the latest firmware on the device")

    app = commands.add_parser("app", help="List, install, start, stop, inspect, and uninstall Apps")
    app_modes = app.add_subparsers(dest="app_command", required=True)
    app_list = app_modes.add_parser("list", help="Refresh and list installed Apps")
    app_list.add_argument("--running", action="store_true", help="Show only Apps that are active or suspended")
    app_list.add_argument("--cached", action="store_true", help="Read the last catalog without refreshing the device")
    app_modes.add_parser("last-error", help="Show the most recent AOT load, launch, or runtime failure")
    upload_command = app_modes.add_parser("upload", help="Deprecated alias for 'artifact upload'")
    upload_command.add_argument("bundle")
    install = app_modes.add_parser("install", help="Build if needed, then upload and install an App")
    install.add_argument(
        "project_or_bundle", nargs="?", default=".", help="Project directory, app.json, or Bundle v1 (default: .)"
    )
    install.add_argument("--profile", choices=["development", "release", "size", "performance"], default="release")
    install.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    install.add_argument("--output-dir", help="Build output directory")
    install.add_argument("--output", help="Bundle output path when building a project")
    install.add_argument("--unchecked-memory", action="store_true", help="Compile the AOT without linear-memory bounds checks; the Bundle is flagged and only Hosts built with CONFIG_MICROPIXEL_ALLOW_UNCHECKED_AOT accept it")
    install.add_argument("--force", action="store_true", help="Rebuild even when no input is newer than the existing Bundle")
    install.add_argument("--start", action="store_true", help="Start the App after it is installed")
    install.add_argument("-f", "--follow", action="store_true", help="Follow Guest logs after starting the App")
    install.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    start = app_modes.add_parser("start", help="Start an installed App")
    start.add_argument("app_id", nargs="?", help="App ID; inferred from ./app.json when omitted")
    start.add_argument("-f", "--follow", action="store_true", help="Follow Guest logs after the App starts")
    start.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    start.set_defaults(launch_arguments=[])
    stop = app_modes.add_parser("stop", help="Stop an App or whichever App owns the runtime")
    stop.add_argument("app_id", nargs="?", help="App ID; omit to stop whichever App owns the runtime")
    uninstall = app_modes.add_parser("uninstall", help="Uninstall an App from the device")
    uninstall.add_argument("app_id")

    artifact = commands.add_parser("artifact", help="Manage remote Control API artifacts")
    artifact_modes = artifact.add_subparsers(dest="artifact_command", required=True)
    artifact_upload = artifact_modes.add_parser(
        "upload", help="Upload a Bundle without installing it (remote transport only)"
    )
    artifact_upload.add_argument("bundle")
    logs = commands.add_parser("logs", help="Read retained Host and App logs")
    logs.add_argument("--follow", action="store_true")
    logs.add_argument(
        "-n",
        "--lines",
        type=non_negative_int,
        metavar="N",
        help="Show only the latest N retained log entries before following",
    )
    logs.add_argument("--cursor", help="Opaque cursor returned by a previous log read")
    logs.add_argument(
        "--source",
        choices=["all", "host", "app"],
        default="all",
        help="Select all, Host, or App logs (default: all)",
    )
    logs.add_argument("--interval", type=float, default=2.0)
    screenshot = commands.add_parser("screenshot", help="Capture a JPEG screenshot")
    screenshot.add_argument("--output", default="micropixel-screenshot.jpg")
    input_command = commands.add_parser("input", help="Send a button press, screen tap, swipe, or JSON sequence")
    input_modes = input_command.add_subparsers(dest="input_command", required=True)

    press = input_modes.add_parser("press", help="Press and release a device button such as confirm or back")
    press.add_argument(
        "code",
        choices=["up", "down", "left", "right", "confirm", "back", "menu", "south", "east", "west", "north"],
