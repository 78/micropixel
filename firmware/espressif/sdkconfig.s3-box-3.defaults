# ESP32-S3-BOX-3 preview product profile.
CONFIG_MICROPIXEL_BOARD_ESP32_S3_BOX_3=y
CONFIG_MICROPIXEL_BOX3_LVGL_DOUBLE_BUFFER=y

# Keep all large LVGL draw buffers in PSRAM. ESP32-S3 can feed SPI LCD DMA from
# PSRAM, and the adapter swaps RGB565 wire byte order in place before submit.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM=y

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
