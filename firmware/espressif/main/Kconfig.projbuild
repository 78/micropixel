menu "WAMR application quotas"

    config MICROPIXEL_GUEST_LINEAR_MEMORY_MAX_PAGES
        int "Maximum Wasm linear-memory pages per Guest"
        range 2 128
        default 128
        help
            Hard Host ceiling for the active Guest's Wasm linear memory. Each
            page is 64 KiB, so the default allows 8 MiB for Guest static data,
            stack and C++ dynamic allocations. At instantiation the Host may
            lower this ceiling to fit the largest contiguous PSRAM block while
            retaining a safety reserve for Host work. This remains separate
            from Host-owned Bitmap quotas.

    config MICROPIXEL_GUEST_PSRAM_RESERVE_BYTES
        int "PSRAM safety reserve protected from Guest allocations"
        range 262144 8388608
        default 2097152
        help
            Minimum free PSRAM retained for Host display, audio, system UI and
            transient work. WAMR growth, decoded textures and mutable surfaces
            are admitted on demand only while this reserve remains available.
            This is a Host safety floor, not a preallocated Guest quota.

    config MICROPIXEL_AOT_PACKAGE_BUFFER_IN_PSRAM
        bool "Copy non-mapped AOT package input into PSRAM"
        depends on SPIRAM
        depends on SPIRAM_USE_CAPS_ALLOC || SPIRAM_USE_MALLOC
        default y if WAMR_AOT_CODE_IN_PSRAM
        default n
        help
            Keep an ordinary relocatable AOT input buffer in writable PSRAM
            until its WAMR module is unloaded. This removes the temporary and
            lifetime package-size charge from internal SRAM and is required
            for large ordinary AOT packages whose relocated text also runs
            from PSRAM.

    config WAMR_RUNTIME_MAX_GUEST_THREADS
        int "Maximum child threads per guest"
        range 1 8
        default 2
        help
            Set WAMR's runtime-wide hard limit for child threads in each
            guest cluster. The main guest thread is not included in this
            count. A production multi-app framework should additionally
            enforce each app's manifest limit at or below this hard limit.

    config WAMR_DEFAULT_WATCHDOG_TIMEOUT_MS
        int "Default guest continuous-computation budget (ms)"
        range 10 60000
        default 1000
        help
            Terminate a guest cluster after this much continuous execution
            without a Host ABI checkpoint. Blocking event waits pause the
            budget. A production app manifest can request a smaller value,
            but must not exceed the framework's policy ceiling.

    config MICROPIXEL_BITMAP_PSRAM_QUOTA_BYTES
        int "Maximum bytes in one decoded Bitmap/offscreen surface"
        range 65536 25165824
        default 4194304
        help
            Rejects one unexpectedly large JPEG/PNG decode output or mutable
            offscreen surface. This is not a cumulative Guest quota: multiple
            textures are allocated elastically while the Host PSRAM safety
            reserve remains intact. Raw package Bitmaps remain backed by
            read-only Flash mmap and do not consume PSRAM.

    config MICROPIXEL_MAX_TEXTURE_DIMENSION
        int "Maximum decoded texture dimension"
        range 64 2048
        default 1024
        help
            Independent width/height ceiling for decoded and streaming
            textures. This is a resource policy, not the physical panel
            resolution; Guest rendering still queries RendererInfo.

    config MICROPIXEL_KV_MAX_BYTES
        int "Maximum logical private KV bytes per Guest"
        range 256 16384
        default 2048

    config MICROPIXEL_KV_MAX_VALUE_BYTES
        int "Maximum private KV value bytes"
        range 32 4096
        default 512

    config MICROPIXEL_KV_MAX_KEYS
        int "Maximum private KV keys per Guest"
        range 1 64
        default 16

    config MICROPIXEL_KV_WRITE_BURST
        int "Private KV write burst per Guest launch"
        range 1 64
        default 8

    config MICROPIXEL_KV_WRITE_REFILL_MS
        int "Milliseconds to refill one private KV write token"
        range 100 60000
        default 1000

endmenu

menu "MicroPixel board backends"

    config MICROPIXEL_DISPLAY_LVGL
        bool
        select LV_FONT_FMT_TXT_LARGE
        select LV_USE_SNAPSHOT

    config MICROPIXEL_DISPLAY_PPA
        bool

    config MICROPIXEL_DISPLAY_DIRECT_FRAMEBUFFER
        bool

    choice MICROPIXEL_BOARD
        prompt "Target board"
        default MICROPIXEL_BOARD_METALIO_CLAW4 if IDF_TARGET_ESP32P4
        default MICROPIXEL_BOARD_NULL

    config MICROPIXEL_BOARD_METALIO_CLAW4
        bool "Metalio-Claw4"
        depends on IDF_TARGET_ESP32P4
        select MICROPIXEL_DISPLAY_LVGL
        select MICROPIXEL_DISPLAY_PPA
        select MICROPIXEL_DISPLAY_DIRECT_FRAMEBUFFER
        help
            Bring up the verified 720x720 RGB888 MIPI-DSI panel and GT911
            touch controller before WAMR starts. LVGL remains a Host-only
            backend and is not exposed through the Guest ABI.

    config MICROPIXEL_BOARD_ESP_MOSAICO
        bool "ESP-Mosaico bring-up profile"
        depends on IDF_TARGET_ESP32S31
        select MICROPIXEL_DISPLAY_LVGL
        select MICROPIXEL_DISPLAY_PPA
        help
            Bring up the CO5300 display and 78/esp_lcd_touch_cst92xx driver with the
            shared Runtime, Guest graphics engine and native ESP32-S31 Wi-Fi.
            Audio, sensors, battery, NAND and module discovery remain outside
            the initial HMI integration.

    config MICROPIXEL_BOARD_NULL
        bool "Null compile-only board"
        help
            Build hardware-independent Runtime and Device paths with unavailable
            device backends. This profile is not intended for flashing.

    endchoice

    config MICROPIXEL_MOSAICO_SOFTWARE_RENDERING
        bool "Disable PPA and DMA2D on ESP-Mosaico"
        depends on MICROPIXEL_BOARD_ESP_MOSAICO
        default n
        help
            Experimental A/B profile for measuring ESP32-S31 graphics without
            Pixel Processing Accelerator or DMA2D assistance. App Surface and
            resource scaling use their CPU implementations, the panel shadow
            uses CPU row copies, and hardware-only system transitions fall back
            to the ordinary LVGL/direct presentation path. The QSPI panel still
            uses its transport DMA; this option disables graphics accelerators,
            not the display bus itself.

    config MICROPIXEL_MOSAICO_LCD_QSPI_DRIVE_CAP
        int "ESP-Mosaico LCD QSPI drive strength (0-3)"
        depends on MICROPIXEL_BOARD_ESP_MOSAICO
        range 0 3
        default 3
        help
            GPIO drive capability for the CO5300 QSPI clock and DATA0-DATA3.
            ESP-Mosaico's vendor BSP exposes the same tuning range and advises
            increasing it when display signal integrity fails at 40 MHz. Keep
            this board-specific; Runtime and Device contracts never depend on it.

    config MICROPIXEL_LVGL_PPA_ACCEL
        bool "Use PPA for eligible LVGL RGB888 draw operations"
        depends on MICROPIXEL_DISPLAY_PPA && !MICROPIXEL_MOSAICO_SOFTWARE_RENDERING
        default y
        help
            Register the ESP LVGL adapter's PPA Fill/Blend handler on a target
            that advertises the accelerator. Guest applications never see PPA.

    config MICROPIXEL_LVGL_PPA_MIN_AREA_PIXELS
        int "Minimum RGB888 fill area sent to PPA"
        depends on MICROPIXEL_LVGL_PPA_ACCEL
        range 100 518400
        default 4096
        help
            Keep smaller opaque fills on the CPU because blocking PPA setup
            and cache maintenance can dominate them. Areas larger than this
            threshold use PPA Fill.

    config MICROPIXEL_APP_SURFACE_HW_MIN_AREA_PIXELS
        int "Minimum App Surface operation sent to PPA/DMA2D"
        depends on MICROPIXEL_DISPLAY_PPA
        range 1 65536
        default 100
        help
            Retained Scene damage is already clipped before replay, so its
            hardware threshold can be lower than LVGL's generic draw threshold.
            Small glyph spans still remain on CPU while ordinary game cells,
            sprites and background restores use PPA or DMA2D.

    config MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT
        int "LVGL partial draw buffer height"
        depends on MICROPIXEL_DISPLAY_LVGL
        range 20 720
        default 100
        help
            Number of panel-wide rows in each LVGL scratch draw buffer.
            Larger values reduce repeated object traversal but require memory
            proportional to the selected board's display width and pixel format.

    config MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM
        bool "Place the LVGL partial draw buffer in PSRAM"
        depends on MICROPIXEL_DISPLAY_LVGL && SPIRAM
        default n
        help
            Allocate partial scratch buffers from PSRAM instead of internal
            SRAM. This permits taller or multiple buffers at the cost of slower
            CPU access. PPA and DMA2D remain available where supported.

    config MICROPIXEL_LVGL_OBJECT_POOL_PSRAM
        bool "Place the LVGL object pool in PSRAM"
        depends on MICROPIXEL_DISPLAY_LVGL && SPIRAM && LV_USE_BUILTIN_MALLOC
        default n
        help
            Place LVGL's fixed builtin TLSF pool, which owns objects, styles
            and event descriptors, in external RAM. Draw buffers are governed
            separately by MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM. Keep this off
            on boards where CPU access to PSRAM makes object traversal too
            expensive.

    config MICROPIXEL_LVGL_DIRTY_COALESCE_EXTRA_PIXELS
        int "Maximum extra pixels per dirty-area merge"
        depends on MICROPIXEL_DISPLAY_LVGL
        range 0 65536
        default 8192
        help
            Dirty-region coalescing is always enabled for the Metalio-Claw4
            backend. This is the upper bound on overdraw introduced by one
            merge, collapsing localized effects while keeping distant HUD and
            board regions separate.

    config MICROPIXEL_LVGL_DIRTY_COALESCE_MAX_PIXELS
        int "Maximum union area for a dirty-area merge"
        depends on MICROPIXEL_DISPLAY_LVGL
        range 4096 518400
        default 65536
        help
            Prevent repeated locally-cheap merges from chaining scattered
            sprites into a full-screen invalidation. An already-large damage
            area is still rendered as-is, but is not enlarged by coalescing.

    config MICROPIXEL_SYSTEM_SHELL_SNAPSHOT
        bool "Enable suspended-App snapshot transitions for the App Hall"
        depends on MICROPIXEL_BOARD_METALIO_CLAW4 && SPIRAM
        select LV_USE_SNAPSHOT
        default y
        help
            Capture the paused Guest object tree into a transient 720x720
            RGB888 PSRAM buffer. The ESP32-P4 PPA hardware scales it into one
            native 202x202 Hall thumbnail and drives the fixed Guest-to-Hall
            transition; the full-size source is released after the animation.
            The retained Guest tree is captured again for the reverse Hall-to-
            Guest transition. Only one thumbnail can persist because only one
            Guest can be resident.

endmenu

menu "MicroPixel system time"

    config MICROPIXEL_NTP_SERVER
        string "Host NTP server"
        default "pool.ntp.org"
        help
            SNTP hostname used to establish and periodically maintain the
            Host system UTC whenever networking is available. System time is
            independent of Remote Control. A product or isolated-LAN profile
            may replace this with a reachable local time server.

endmenu

menu "MicroPixel Remote Control"

    config MICROPIXEL_REMOTE_CONTROL_AGENT
        bool "Enable the Host Remote Control agent"
        default y
        help
            Build the Host-owned HTTP/3 control agent, stateless device
            bootstrap, NVS identity, control stream, and temporary pairing
            flow. The user-facing Remote Control switch remains off by
            default and is stored separately in sys_store.

    config MICROPIXEL_REMOTE_CONTROL_HOST
        string "Control service hostname"
        depends on MICROPIXEL_REMOTE_CONTROL_AGENT
        default ""
        help
            DNS name or IP address used by the HTTP/3 client. Leave empty to
            keep the agent offline until a development or product profile
            supplies a service endpoint.

    config MICROPIXEL_REMOTE_CONTROL_PORT
        int "Control service HTTPS port"
        depends on MICROPIXEL_REMOTE_CONTROL_AGENT
        range 1 65535
        default 8443

    config MICROPIXEL_REMOTE_CONTROL_ALLOW_UNVERIFIED_TLS
        bool "Allow an untrusted HTTP/3 certificate chain (development only)"
        depends on MICROPIXEL_REMOTE_CONTROL_AGENT
        default y
        help
            Skip certificate chain and hostname verification. It also skips
            validity-period verification when CONFIG_MBEDTLS_HAVE_TIME_DATE is
            enabled. The TLS 1.3 CertificateVerify signature and Finished MAC
            remain mandatory.
            Keep this disabled in product builds. Enabling it is an explicit
            development-only exception for a trusted local Control service.

    config MICROPIXEL_REMOTE_CONTROL_TRUSTED_CA_DER_BASE64
        string "Trusted Control CA certificate (DER, base64)"
        depends on MICROPIXEL_REMOTE_CONTROL_AGENT
        default ""
        help
            Base64 of one DER-encoded CA trust anchor. The HTTP/3 client
            validates the server chain and configured hostname against this CA
            before accepting application keys. Certificate dates are checked
            only when CONFIG_MBEDTLS_HAVE_TIME_DATE is enabled. For local Caddy,
            export its local root certificate to DER and encode it as a
            single-line base64 value. Leave empty only when Remote Control is
            offline or the development bypass above is enabled.

endmenu

menu "MicroPixel conformance testing"

    config MICROPIXEL_ENABLE_CONFORMANCE_TEST_HOOKS
        bool "Enable on-device conformance test hooks"
        default n
        help
            Link narrowly scoped synthetic event injectors used by the
            event-wait and touch-pressure conformance Guests. Product builds
            keep this disabled; the hooks remain outside the runtime directory
            and ABI namespace.

endmenu
