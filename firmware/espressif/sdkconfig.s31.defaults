CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.s31.csv"

# ESP-Mosaico's onboard Type-C connector is wired to USB 2.0 HS OTG, not the
# USB Serial/JTAG pads exposed on the left module header. ESP32-S31 does not
# expose ESP-IDF's ROM CDC console choice, so the board initializes an
# interrupt/task-driven TinyUSB CDC console during platform startup.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ESP-Mosaico carries 16 MiB octal PSRAM. Guest linear memory, decoded
# resources and the official BSP's double-partial LVGL buffers use it.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# Keep the S31 preview at 320 MHz. Startup DFS currently prevents ESP-Mosaico
# from booting reliably, so leave frequency scaling disabled while retaining PM
# support for tickless idle. The Host power state machine remains authoritative.
CONFIG_PM_ENABLE=y
# CONFIG_PM_DFS_INIT_AUTO is not set
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

CONFIG_MICROPIXEL_BOARD_ESP_MOSAICO=y
CONFIG_MICROPIXEL_MOSAICO_LCD_QSPI_DRIVE_CAP=3
# Keep two full-height LVGL draw buffers in PSRAM. The CO5300 transport still
# uses its bounded internal DMA-SRAM staging independently of these buffers.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=480
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM=y
CONFIG_MICROPIXEL_MOSAICO_LVGL_DOUBLE_BUFFER=y
# CONFIG_OPUS_FLOATING_POINT is not set
# CONFIG_OPUS_ENABLE_XTENSA_OPTIMIZATIONS is not set

# The S31 LVGL/PPA display bridge currently addresses partial RGB565 buffers
# as tightly packed rows. Keep LVGL's global stride packed; persistent
# MicroPixel-owned RGB888 surfaces apply their own 16-pixel stride alignment.
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
# Keep hosted/native network payload allocations in PSRAM on the S31 preview;
# only native ESP32-S3 profiles use the bounded dynamic Wi-Fi pool.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
