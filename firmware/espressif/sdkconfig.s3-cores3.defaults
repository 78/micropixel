# M5Stack CoreS3 preview profile (ESP32-S3, 16 MiB flash, 8 MiB Quad PSRAM).
CONFIG_MICROPIXEL_BOARD_M5STACK_CORES3=y
CONFIG_MICROPIXEL_CORES3_LVGL_DOUBLE_BUFFER=y

# CoreS3 uses Quad PSRAM; the shared S3 defaults select Octal for BOX-3 and SZPI.
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_MODE_QUAD=y

CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM=y

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
