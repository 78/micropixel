def sdk_root() -> Path:
    script_directory = Path(__file__).resolve().parent
    return script_directory if (script_directory / "guest").is_dir() else script_directory.parent


def dotenv_values(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for line_number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            raise CliError(f"{path}:{line_number}: expected KEY=VALUE")
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) is None:
            raise CliError(f"{path}:{line_number}: invalid environment variable name")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        values[key] = value
    return values


def project_environment(directory: Path) -> dict[str, str]:
    values = dotenv_values(directory / ".env")
    values.update(os.environ)
    return values


def control_url(environment: dict[str, str]) -> str:
    base_url = environment.get("MICROPIXEL_CONTROL_URL", "https://micropixel.ai").rstrip("/")
    parsed = urllib.parse.urlsplit(base_url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc or parsed.query or parsed.fragment:
        raise CliError("MICROPIXEL_CONTROL_URL must be an HTTP(S) origin")
    return base_url


def token_device_id(token: str) -> str:
    parts = token.split(".")
    if len(parts) != 3:
        raise CliError("MICROPIXEL_API_TOKEN is not a JWT")
    try:
        encoded = parts[1] + "=" * ((4 - len(parts[1]) % 4) % 4)
        claims = json.loads(base64.urlsafe_b64decode(encoded).decode("utf-8"))
    except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise CliError("MICROPIXEL_API_TOKEN has an invalid JWT payload") from error
    if not isinstance(claims, dict) or claims.get("typ") != "api":
        raise CliError("MICROPIXEL_API_TOKEN must be a scoped API Token, not a Console or device credential")
    device_id = claims.get("device_id")
    if not isinstance(device_id, str):
        raise CliError("MICROPIXEL_API_TOKEN does not contain a device_id claim")
    try:
        return str(uuid.UUID(device_id))
    except ValueError as error:
        raise CliError("MICROPIXEL_API_TOKEN contains an invalid device_id claim") from error


@dataclass(frozen=True)
class ControlConfig:
    base_url: str
    device_id: str
    token: str

    @staticmethod
    def load(directory: Path) -> "ControlConfig":
        environment = project_environment(directory)
        base_url = control_url(environment)
        token = environment.get("MICROPIXEL_API_TOKEN", "").strip()
        if not token:
            raise CliError("Set MICROPIXEL_API_TOKEN in the process environment or local .env")
        device_id = token_device_id(token)
        explicit_device_id = environment.get("MICROPIXEL_DEVICE_ID", "").strip()
        if explicit_device_id:
            try:
                explicit_device_id = str(uuid.UUID(explicit_device_id))
            except ValueError as error:
                raise CliError("MICROPIXEL_DEVICE_ID is not a valid UUID") from error
            if explicit_device_id != device_id:
                raise CliError("MICROPIXEL_DEVICE_ID does not match the device_id claim in MICROPIXEL_API_TOKEN")
        return ControlConfig(base_url=base_url, device_id=device_id, token=token)


class ControlClient:
    def __init__(self, config: ControlConfig) -> None:
        self.config = config

    def request(
        self,
        method: str,
        path: str,
        *,
        json_body: Any | None = None,
        binary_body: bytes | None = None,
        content_type: str | None = None,
        timeout: float = 30.0,
        idempotency_key: str | None = None,
        command_timeout_ms: int | None = None,
    ) -> tuple[bytes, str]:
        if json_body is not None and binary_body is not None:
            raise AssertionError("request body is ambiguous")
        body = binary_body
        if json_body is not None:
            body = json.dumps(json_body, separators=(",", ":")).encode("utf-8")
            content_type = "application/json"
        headers = {
            "Authorization": f"Bearer {self.config.token}",
            "Accept": "application/json",
            "User-Agent": f"MicroPixel-CLI/{VERSION} (+https://micropixel.ai/docs/)",
        }
        if content_type:
            headers["Content-Type"] = content_type
        if method in {"POST", "PUT", "PATCH", "DELETE"}:
            headers["Idempotency-Key"] = idempotency_key or str(uuid.uuid4())
        if command_timeout_ms is not None:
            headers["X-MicroPixel-Command-Timeout-Ms"] = str(command_timeout_ms)
        request = urllib.request.Request(
            f"{self.config.base_url}{path}", data=body, headers=headers, method=method
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return response.read(), response.headers.get_content_type()
        except urllib.error.HTTPError as error:
            payload = error.read()
            try:
                detail = json.loads(payload).get("error", payload.decode("utf-8", "replace"))
            except (json.JSONDecodeError, AttributeError):
                detail = payload.decode("utf-8", "replace")
            raise CliError(f"Control API returned HTTP {error.code}: {detail}") from error
        except urllib.error.URLError as error:
            raise CliError(f"Control API connection failed: {error.reason}") from error

    def json(
        self,
        method: str,
        path: str,
        body: Any | None = None,
        timeout: float = 30.0,
        *,
        idempotency_key: str | None = None,
        command_timeout_ms: int | None = None,
    ) -> dict[str, Any]:
        payload, _ = self.request(
            method,
            path,
            json_body=body,
            timeout=timeout,
            idempotency_key=idempotency_key,
            command_timeout_ms=command_timeout_ms,
        )
        try:
            value = json.loads(payload)
        except json.JSONDecodeError as error:
            raise CliError("Control API returned invalid JSON") from error
        if not isinstance(value, dict):
            raise CliError("Control API returned an unexpected response")
        return value

    def device_path(self, suffix: str = "") -> str:
        return f"/api/v1/devices/{self.config.device_id}{suffix}"

    def wait_job(self, job: dict[str, Any], timeout_seconds: float) -> dict[str, Any]:
        job_id = job.get("id")
        if not isinstance(job_id, str):
            raise CliError("Control API did not return a Job ID")
        deadline = time.monotonic() + timeout_seconds
        while True:
            current = self.json("GET", self.device_path(f"/jobs/{job_id}"))
            status = current.get("status")
            if status == "succeeded":
                return current
            if status in {"failed", "cancelled", "expired", "indeterminate"}:
                raise CliError(job_failure_message(job_id, str(status), current.get("error")))
            if status not in {"queued", "dispatched", "accepted", "running"}:
                raise CliError(f"Job {job_id} returned unexpected status: {status}")
            if time.monotonic() >= deadline:
                raise CliError(f"Timed out waiting for Job {job_id}")
            time.sleep(0.5)


ESPRESSIF_USB_VENDOR_ID = 0x303A
MICROPIXEL_USB_PRODUCT_IDS = frozenset({0x1001, 0x4001})


def usb_serial_ports() -> list[Any]:
    try:
        from serial.tools import list_ports
    except ImportError as error:
        raise CliError("USB transport requires pyserial; install requirements-dev.txt") from error
    return list(list_ports.comports())


def is_micropixel_usb_candidate(port: Any) -> bool:
    product = str(getattr(port, "product", "") or "")
    return getattr(port, "vid", None) == ESPRESSIF_USB_VENDOR_ID and (
        getattr(port, "pid", None) in MICROPIXEL_USB_PRODUCT_IDS or product.startswith("MicroPixel ")
    )


def discover_usb_port(explicit_port: str | None) -> str:
    if explicit_port:
        return explicit_port
    candidates = [
        port.device
        for port in usb_serial_ports()
        if is_micropixel_usb_candidate(port)
    ]
    if not candidates:
        raise CliError("No MicroPixel USB device found; connect the device, run 'port list', or pass --port")
    if len(candidates) != 1:
        shown = ", ".join(sorted(candidates))
        raise CliError(f"Multiple MicroPixel USB devices found ({shown}); pass --port")
    return candidates[0]


def open_usb_serial(port: str) -> Any:
    try:
        import serial
    except ImportError as error:
        raise CliError("USB transport requires pyserial; install requirements-dev.txt") from error
    options: dict[str, Any] = {
        "port": None,
        "baudrate": 115200,
        "timeout": 0.05,
        "write_timeout": 10.0,
    }
    if os.name != "nt":
        options["exclusive"] = False
    device = serial.Serial(**options)
    device.dtr = True
    device.rts = True
    device.port = port
    try:
        device.open()
        device.rts = False
        device.dtr = False
    except Exception:
        device.close()
        raise
    return device


class UsbControlClient:
    CHUNK_SIZE = 3072

    def __init__(self, port: str | None, timeout: float = 300.0) -> None:
        self.port = discover_usb_port(port)
        self.timeout = timeout
        self.device: Any | None = None
        self.next_request_id = secrets.randbelow(0x7FFFFFFF) + 1
        self.received = bytearray()

    def __enter__(self) -> "UsbControlClient":
        try:
            self.device = open_usb_serial(self.port)
        except Exception as error:
            raise CliError(f"Cannot open USB device {self.port}: {error}") from error
        deadline = time.monotonic() + min(self.timeout, 20.0)
        response: str | None = None
        last_error: CliError | None = None
        while response is None and time.monotonic() < deadline:
            try:
                response = self.request("HELLO", timeout=min(2.0, max(0.1, deadline - time.monotonic())))
            except CliError as error:
                if "Timed out waiting for USB device response" not in str(error):
                    self.close()
                    raise
                last_error = error
        if response is None:
            self.close()
            raise last_error or CliError(f"USB device {self.port} did not answer the control handshake")
        fields = response.split()
        if len(fields) != 4 or fields[0] != "HELLO" or fields[1] != "1":
            self.close()
            raise CliError(f"Device returned an incompatible USB control handshake: {response}")
        self.CHUNK_SIZE = min(int(fields[2]), self.CHUNK_SIZE)
        return self

    def __exit__(self, _type: object, _value: object, _traceback: object) -> None:
        self.close()

    def close(self) -> None:
        if self.device is not None:
            self.device.close()
            self.device = None

    def _allocate_request_id(self) -> int:
        request_id = self.next_request_id
        self.next_request_id = 1 if request_id == 0xFFFFFFFF else request_id + 1
        return request_id

    def _send(self, request_id: int, operation: str, arguments: str = "") -> None:
        if self.device is None:
            raise CliError("USB device is not open")
        suffix = f" {arguments}" if arguments else ""
        line = f"MPX1 {request_id} {operation}{suffix}\n".encode("ascii")
        try:
            self.device.write(line)
        except Exception as error:
            raise CliError(f"USB write failed on {self.port}: {error}") from error

    def _read_response(self, request_id: int, timeout: float) -> str:
        if self.device is None:
            raise CliError("USB device is not open")
        prefix = f"MPX1 {request_id} ".encode("ascii")
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            newline = self.received.find(b"\n")
            while newline >= 0:
                line = bytes(self.received[:newline]).strip(b"\r")
                del self.received[: newline + 1]
                if line.startswith(prefix):
                    remainder = line[len(prefix):].decode("ascii", "replace")
                    status, separator, detail = remainder.partition(" ")
                    if not separator:
                        raise CliError("Device returned a malformed USB control response")
                    if status == "ERROR":
                        raise CliError(f"USB device command failed: {detail}")
                    if status != "OK":
                        raise CliError(f"USB device returned an unknown response status: {status}")
                    return detail
                newline = self.received.find(b"\n")
            try:
                block = self.device.read(4096)
            except Exception as error:
                raise CliError(f"USB read failed on {self.port}: {error}") from error
            if block:
                self.received.extend(block)
                if len(self.received) > 128 * 1024:
                    del self.received[:64 * 1024]
        raise CliError(f"Timed out waiting for USB device response on {self.port}")

    def request(self, operation: str, arguments: str = "", timeout: float | None = None) -> str:
        request_id = self._allocate_request_id()
        self._send(request_id, operation, arguments)
        return self._read_response(request_id, self.timeout if timeout is None else timeout)

    def list_apps(self) -> dict[str, Any]:
        apps: list[dict[str, Any]] = []
        offset = 0
        expected_count: int | None = None
        store_used = 0
        store_total = 0
        while expected_count is None or offset < expected_count:
            detail = self.request("APP_LIST", str(offset))
            fields = detail.split()
            if len(fields) < 6 or fields[0] != "APP_LIST":
                raise CliError("Device returned a malformed App list")
            next_offset, count, store_used, store_total, page_count = map(int, fields[1:6])
            entries = fields[6:]
            if page_count != len(entries) or next_offset < offset or next_offset > count:
                raise CliError("Device returned inconsistent App list pagination")
            if expected_count is not None and count != expected_count:
                raise CliError("Installed App catalog changed while it was being listed")
            expected_count = count
            for entry in entries:
                parts = entry.split(",", 4)
                if len(parts) != 5:
                    raise CliError("Device returned a malformed App descriptor")
                app_id, size_text, encoded_name, active_text, lifecycle = parts
                try:
                    display_name = base64.b64decode(encoded_name, validate=True).decode("utf-8")
                    size_bytes = int(size_text)
                except (ValueError, UnicodeDecodeError) as error:
                    raise CliError("Device returned an invalid App descriptor") from error
                apps.append(
                    {
                        "appId": app_id,
                        "displayName": display_name,
                        "sizeBytes": size_bytes,
                        "active": active_text == "1",
                        "lifecycle": lifecycle,
                    }
                )
            offset = next_offset
            if offset == count:
                break
        return {
            "apps": apps,
            "count": len(apps),
            "storeUsedBytes": store_used,
            "storeTotalBytes": store_total,
            "transport": "usb",
            "port": self.port,
        }

    def action(
        self,
        operation: str,
        app_id: str | None = None,
        launch_arguments: list[str] | None = None,
    ) -> dict[str, Any]:
        detail = app_id or ""
        if launch_arguments:
            if operation != "APP_START" or app_id is None:
                raise CliError("launch arguments can only be supplied to APP_START")
            detail = f"{app_id} {encode_launch_arguments(launch_arguments)}"
        detail = self.request(operation, detail)
        fields = detail.split(maxsplit=1)
        if len(fields) != 2 or fields[0] != "RESULT":
            raise CliError(f"Device returned an unexpected action result: {detail}")
        return {"status": "succeeded", "result": {"message": fields[1]}, "transport": "usb"}

    def last_app_error(self) -> dict[str, Any]:
        fields = self.request("APP_LAST_ERROR").split()
        if fields == ["APP_ERROR", "NONE"]:
            return {"error": None, "transport": "usb"}
        if len(fields) != 7 or fields[0] != "APP_ERROR":
            raise CliError("Device returned a malformed App diagnostic")
        try:
            detail = base64.b64decode(fields[6], validate=True).decode("utf-8")
            exit_code = int(fields[5]) if fields[4] == "1" else None
        except (ValueError, UnicodeDecodeError) as error:
            raise CliError("Device returned an invalid App diagnostic") from error
        diagnostic: dict[str, Any] = {
            "appId": fields[1],
            "phase": fields[2],
            "code": fields[3],
            "detail": detail,
        }
        if exit_code is not None:
            diagnostic["exitCode"] = exit_code
        recommendation = app_failure_recommendation(diagnostic)
        if recommendation:
            diagnostic["recommendation"] = recommendation
        return diagnostic

    def read_log(self, cursor: str | None, source: str = "all") -> tuple[str, bool, bool, list[dict[str, Any]]]:
        session = "-"
        sequence = 0
        if cursor:
            session, separator, sequence_text = cursor.rpartition(":")
            if not separator or not session:
                raise CliError("USB log cursor is invalid")
            try:
                sequence = int(sequence_text)
            except ValueError as error:
                raise CliError("USB log cursor is invalid") from error
        fields = self.request("LOG_READ", f"{session} {sequence} {source}").split()
        if len(fields) < 6 or fields[0] != "LOG_PAGE":
            raise CliError("Device returned a malformed system log page")
        try:
            next_sequence = int(fields[2])
            truncated = fields[3] == "1"
            has_more = fields[4] == "1"
            count = int(fields[5])
        except ValueError as error:
            raise CliError("Device returned an invalid system log page") from error
        entries: list[dict[str, Any]] = []
        if count == 1:
            if len(fields) not in {11, 12}:
                raise CliError("Device returned a malformed system log entry")
            try:
                source_name = fields[9] if len(fields) == 12 else "app"
                app_id = fields[10] if len(fields) == 12 else fields[9]
                message_field = fields[11] if len(fields) == 12 else fields[10]
                message = base64.b64decode(message_field, validate=True).decode("utf-8", "replace")
                entries.append(
                    {
                        "sequence": int(fields[6]),
                        "timestampUs": int(fields[7]),
                        "level": {1: "debug", 2: "info", 3: "warning", 4: "error"}.get(
                            int(fields[8]), "unknown"
                        ),
                        "source": source_name,
                        "appId": "" if app_id == "-" else app_id,
                        "message": message,
                    }
                )
            except ValueError as error:
                raise CliError("Device returned an invalid system log entry") from error
        elif count != 0 or len(fields) != 6:
            raise CliError("Device returned an inconsistent system log page")
        return f"{fields[1]}:{next_sequence}", has_more, truncated, entries

    def input_sequence(self, operations: list[dict[str, Any]]) -> dict[str, Any]:
        encoded = base64.b64encode(json.dumps(operations, separators=(",", ":")).encode("utf-8")).decode("ascii")
        if len(encoded) > 4096:
            raise CliError("Input sequence is too large for the USB control channel")
        return self.action("INPUT_SEQUENCE", encoded)

    def firmware_status(self) -> dict[str, Any]:
        result = self.action("FIRMWARE_STATUS")
        message = result["result"]["message"]
        fields = message.split()
        if len(fields) != 6 or fields[0] != "firmware_status":
            raise CliError("Device returned a malformed firmware status")
        try:
            state_number = int(fields[1])
            progress = int(fields[4])
        except ValueError as error:
            raise CliError("Device returned an invalid firmware status") from error
        states = ["unknown", "checking", "current", "available", "downloading", "verifying", "installing", "failed"]
        return {
            "state": states[state_number] if 0 <= state_number < len(states) else "unknown",
            "updateAvailable": fields[2] == "1",
            "installable": fields[3] == "1",
            "progressPercent": progress,
            "latestVersion": None if fields[5] == "-" else fields[5],
            "transport": "usb",
        }

    def device_status(self) -> dict[str, Any]:
        fields = self.request("DEVICE_STATUS").split()
        if len(fields) != 17 or fields[0] != "DEVICE_STATUS":
            raise CliError("Device returned a malformed status snapshot")
        try:
            version, board, chip = (
                base64.b64decode(value, validate=True).decode("utf-8") for value in fields[1:4]
            )
            numbers = [int(value) for value in fields[4:5] + fields[7:14]]
        except (ValueError, UnicodeDecodeError) as error:
            raise CliError("Device returned an invalid status snapshot") from error
        uptime, app_count, store_used, store_total, internal_free, psram_free, width, height = numbers
        active_app = None if fields[5] == "-" else fields[5]
        return {
            "online": True,
            "transport": "usb",
            "port": self.port,
            "firmware": {"version": version},
            "hardware": {
                "board": board,
                "chip": chip,
                "display": {"widthPixels": width, "heightPixels": height},
            },
            "memory": {"internalSram": {"freeBytes": internal_free}, "psram": {"freeBytes": psram_free}},
            "storage": {
                "appStore": {
                    "usedBytes": store_used,
                    "totalBytes": store_total,
                    "freeBytes": max(0, store_total - store_used),
                }
            },
            "runtime": {
                "activeAppId": active_app,
                "lifecycle": fields[6],
                "installedAppCount": app_count,
                "uptimeMs": uptime,
            },
            "network": {
                "available": fields[14] == "1",
                "enabled": fields[15] == "1",
                "connected": fields[16] == "1",
            },
        }

    def task_diagnostics(self) -> dict[str, Any]:
        offset = 0
        tasks: list[dict[str, Any]] = []
        total_count = 0
        total_runtime = 0
        truncated = False
        states = ["running", "ready", "blocked", "suspended", "deleted", "invalid"]
        while True:
            fields = self.request("DEVICE_TASKS", str(offset)).split()
            if len(fields) < 8 or fields[0] != "TASK_PAGE":
                raise CliError("Device returned a malformed task diagnostics page")
            try:
                available = fields[1] == "1"
                next_offset, captured_count, total_count, truncated_number, total_runtime, page_count = map(
                    int, fields[2:8]
                )
            except ValueError as error:
                raise CliError("Device returned invalid task diagnostics") from error
            truncated = truncated_number != 0
            if page_count == 1:
                if len(fields) != 9:
                    raise CliError("Device returned a malformed task descriptor")
                parts = fields[8].split(",")
                if len(parts) != 7:
                    raise CliError("Device returned a malformed task descriptor")
                try:
                    name = base64.b64decode(parts[0], validate=True).decode("utf-8")
                    task_number, state, priority, base_priority, runtime, stack = map(int, parts[1:])
                except (ValueError, UnicodeDecodeError) as error:
                    raise CliError("Device returned an invalid task descriptor") from error
                tasks.append(
                    {
                        "name": name,
                        "taskNumber": task_number,
                        "state": states[state] if 0 <= state < len(states) else "invalid",
                        "priority": priority,
                        "basePriority": base_priority,
                        "runtimeCounter": runtime,
                        "stackHighWaterMarkBytes": stack,
                    }
                )
            elif page_count != 0 or len(fields) != 8:
                raise CliError("Device returned inconsistent task diagnostics pagination")
            if next_offset >= captured_count:
                break
            if next_offset <= offset:
                raise CliError("Device did not advance task diagnostics pagination")
            offset = next_offset
        return {
            "available": available,
            "taskCount": total_count,
            "truncated": truncated,
            "totalRuntimeCounter": total_runtime,
            "tasks": tasks,
        }

    def capture_screen(self) -> tuple[bytes, int, int]:
        if self.device is None:
            raise CliError("USB device is not open")
        begin = b"\nMICROPIXEL_CAPTURE_BEGIN "
        command = b"MICROPIXEL_CAPTURE\n"
        deadline = time.monotonic() + min(self.timeout, 60.0)
        next_request = 0.0
        while time.monotonic() < deadline:
            now = time.monotonic()
            if begin not in self.received and now >= next_request:
                self.device.write(command)
                next_request = now + 2.0
            start = self.received.find(begin)
            if start >= 0:
                header_end = self.received.find(b"\n", start + 1)
                if header_end >= 0:
                    fields = bytes(self.received[start + len(begin) : header_end]).split()
                    if len(fields) != 6 or fields[3] != b"JPEG":
                        del self.received[: header_end + 1]
                        continue
                    sequence, width, height = map(int, fields[:3])
                    jpeg_size = int(fields[4])
                    captured_source = fields[5].decode("ascii")
                    jpeg_start = header_end + 1
                    jpeg_end = jpeg_start + jpeg_size
                    marker = f"\nMICROPIXEL_CAPTURE_END {sequence}\n".encode("ascii")
                    marker_end = jpeg_end + len(marker)
                    if len(self.received) >= marker_end:
                        jpeg = bytes(self.received[jpeg_start:jpeg_end])
                        if self.received[jpeg_end:marker_end] != marker or not jpeg.startswith(b"\xff\xd8") or not jpeg.endswith(b"\xff\xd9"):
                            raise CliError("USB screenshot payload is corrupted")
                        if captured_source != "DISPLAY":
                            raise CliError("USB screenshot source does not match the request")
                        del self.received[:marker_end]
                        return jpeg, width, height
            block = self.device.read(16384)
            if block:
                self.received.extend(block)
                if begin not in self.received and len(self.received) > 128 * 1024:
                    del self.received[:-64 * 1024]
        raise CliError(f"Timed out waiting for USB screenshot on {self.port}")

    def install(
        self,
        bundle_path: Path,
        progress_callback: Callable[[int], None] | None = None,
    ) -> dict[str, Any]:
        details = validate_bundle(bundle_path)
        data = bundle_path.read_bytes()
        digest = hashlib.sha256(data).hexdigest()
        request_id = self._allocate_request_id()
        self._send(
            request_id,
            "APP_INSTALL_BEGIN",
            f"{details['appId']} {len(data)} {digest}",
        )
        ready = self._read_response(request_id, self.timeout)
        ready_fields = ready.split()
        if len(ready_fields) != 2 or ready_fields[0] != "INSTALL_READY":
            raise CliError(f"Device rejected the USB install session: {ready}")
        chunk_size = min(self.CHUNK_SIZE, int(ready_fields[1]))
        if progress_callback is not None:
            progress_callback(0)
        try:
            for offset in range(0, len(data), chunk_size):
                chunk = data[offset : offset + chunk_size]
                encoded = base64.b64encode(chunk).decode("ascii")
                self._send(request_id, "APP_INSTALL_CHUNK", f"{offset} {encoded}")
                acknowledgment = self._read_response(request_id, self.timeout)
                expected = offset + len(chunk)
                if acknowledgment != f"INSTALL_CHUNK {expected}":
                    raise CliError(f"Device acknowledged an unexpected install offset: {acknowledgment}")
                if progress_callback is not None:
                    progress_callback(min(99, expected * 99 // len(data)))
            self._send(request_id, "APP_INSTALL_COMMIT")
            completed = self._read_response(request_id, self.timeout)
        except Exception:
            try:
                self._send(request_id, "APP_INSTALL_ABORT")
            except Exception:
                pass
            raise
        fields = completed.split(maxsplit=1)
        if len(fields) != 2 or fields[0] != "RESULT":
            raise CliError(f"Device returned an unexpected install result: {completed}")
        if progress_callback is not None:
            progress_callback(100)
        return {
            "status": "succeeded",
            "result": {"message": fields[1], "appId": details["appId"], "sizeBytes": len(data)},
            "transport": "usb",
        }


def list_local_ports(include_all: bool = False, probe_timeout: float = 2.0) -> dict[str, Any]:
    if probe_timeout <= 0:
        raise CliError("port list --timeout must be greater than zero")
    results: list[dict[str, Any]] = []
    port_infos = sorted(usb_serial_ports(), key=lambda value: str(value.device))
    for port_info in port_infos:
        candidate = is_micropixel_usb_candidate(port_info)
        if not include_all and not candidate:
            continue
        product = getattr(port_info, "product", None)
        description = getattr(port_info, "description", None)
        manufacturer = getattr(port_info, "manufacturer", None)
        vid = getattr(port_info, "vid", None)
        pid = getattr(port_info, "pid", None)
        port: dict[str, Any] = {
            "port": str(port_info.device),
            "deviceName": product or description or str(port_info.device),
            "microPixelCandidate": candidate,
        }
        if manufacturer:
            port["manufacturer"] = str(manufacturer)
        if isinstance(vid, int) and isinstance(pid, int):
            port["usbId"] = f"{vid:04X}:{pid:04X}"
        if candidate:
            try:
                with UsbControlClient(str(port_info.device), probe_timeout) as client:
                    status = client.device_status()
                hardware = status.get("hardware")
                firmware = status.get("firmware")
                port.update(
                    {
                        "available": True,
                        "board": hardware.get("board") if isinstance(hardware, dict) else None,
                        "chip": hardware.get("chip") if isinstance(hardware, dict) else None,
                        "firmwareVersion": firmware.get("version") if isinstance(firmware, dict) else None,
                    }
                )
            except CliError as error:
                port.update({"available": False, "error": str(error)})
        results.append(port)
    return {"ports": results, "count": len(results)}


def job_failure_message(job_id: str, status: str, error: Any) -> str:
    if isinstance(error, dict):
        code = error.get("code")
        message = error.get("message")
        details = error.get("details")
        diagnostic = details.get("diagnostic") if isinstance(details, dict) else None
        if not isinstance(diagnostic, dict) and isinstance(details, dict):
            diagnostic = details
        if isinstance(diagnostic, dict):
            app_id = diagnostic.get("appId")
            phase = diagnostic.get("phase")
            diagnostic_code = diagnostic.get("code", code)
            detail = diagnostic.get("detail", message)
            if all(isinstance(value, str) for value in (app_id, phase, diagnostic_code, detail)):
                return f"App {app_id} failed during {phase}: {diagnostic_code}: {detail}"
        if isinstance(code, str) and isinstance(message, str):
            return f"Job {job_id} {status}: {code}: {message}"
    return f"Job {job_id} {status}: {json.dumps(error, ensure_ascii=False)}"


def create_job(
    client: ControlClient,
    args: argparse.Namespace,
    method: str,
    path: str,
    body: Any | None = None,
    *,
    idempotency_scope: str | None = None,
) -> dict[str, Any]:
    idempotency_key = getattr(args, "idempotency_key", None)
    if idempotency_key is not None and re.fullmatch(r"[A-Za-z0-9._:-]{8,128}", idempotency_key) is None:
        raise CliError("--idempotency-key must contain 8-128 letters, digits, dot, underscore, colon, or hyphen")
    if idempotency_key is not None and idempotency_scope is not None:
        idempotency_key = hashlib.sha256(f"{idempotency_key}:{idempotency_scope}".encode("ascii")).hexdigest()
    command_timeout_ms = getattr(args, "command_timeout_ms", None)
    if command_timeout_ms is not None and not 1_000 <= command_timeout_ms <= 300_000:
        raise CliError("--command-timeout-ms must be between 1000 and 300000")
    if idempotency_key is None and command_timeout_ms is None:
        return client.json(method, path, body)
    return client.json(method, path, body, idempotency_key=idempotency_key, command_timeout_ms=command_timeout_ms)


def quote_identifier(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", value) is None:
        raise CliError("App ID may contain only letters, digits, dot, underscore, and hyphen")
    return urllib.parse.quote(value, safe="")


def semantic_version(value: str) -> tuple[int, int, int] | None:
    matched = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)(?:[-+][0-9A-Za-z.-]+)?", value)
    return tuple(map(int, matched.groups())) if matched else None


def require_compatible_firmware(client: ControlClient) -> dict[str, Any]:
    snapshot = client.json("GET", client.device_path())
    if snapshot.get("online") is not True:
        raise CliError("The device is offline. Bring it online before installing or starting an App.")
    status = snapshot.get("status")
    firmware_version = status.get("firmwareVersion") if isinstance(status, dict) else None
    current = semantic_version(firmware_version) if isinstance(firmware_version, str) else None
    minimum = semantic_version(MINIMUM_FIRMWARE_VERSION)
    if current is None or minimum is None or current < minimum:
        shown = firmware_version if isinstance(firmware_version, str) and firmware_version else "unknown"
        raise CliError(
            f"Device firmware {shown} is not compatible with MicroPixel SDK/CLI {VERSION}. "
            f"Upgrade the device to firmware {MINIMUM_FIRMWARE_VERSION} or later, then retry."
        )
    return snapshot


def require_compatible_usb_firmware(status: dict[str, Any]) -> None:
    firmware = status.get("firmware")
    firmware_version = firmware.get("version") if isinstance(firmware, dict) else None
    current = semantic_version(firmware_version) if isinstance(firmware_version, str) else None
    minimum = semantic_version(MINIMUM_FIRMWARE_VERSION)
    if current is None or minimum is None or current < minimum:
        shown = firmware_version if isinstance(firmware_version, str) and firmware_version else "unknown"
        raise CliError(
            f"Device firmware {shown} is not compatible with MicroPixel SDK/CLI {VERSION}. "
            f"Upgrade the device to firmware {MINIMUM_FIRMWARE_VERSION} or later, then retry."
        )


def _hardware_chip(value: object) -> object:
    if not isinstance(value, dict):
        return None
    hardware = value.get("hardware")
    if isinstance(hardware, dict) and hardware.get("chip") is not None:
        return hardware.get("chip")
    status = value.get("status")
    if isinstance(status, dict):
        chip = _hardware_chip(status)
        if chip is not None:
            return chip
        system_information = status.get("systemInformation")
        chip = _hardware_chip(system_information)
        if chip is not None:
            return chip
    return None


def network_device_aot_target(client: ControlClient) -> str:
    snapshot = require_compatible_firmware(client)
    chip = _hardware_chip(snapshot)
    if chip is None:
        system_information = client.json("GET", client.device_path("/system-info"))
        chip = _hardware_chip(system_information)
    return aot_target_for_chip(chip)


def usb_device_aot_target(client: UsbControlClient) -> str:
    status = client.device_status()
    require_compatible_usb_firmware(status)
    return aot_target_for_chip(_hardware_chip(status))


def prepare_connected_bundle(
    args: argparse.Namespace,
    expected_target: str,
    prepare: Callable[[argparse.Namespace], Path],
) -> Path:
    requested_target = getattr(args, "aot_target", None)
    if requested_target is not None and requested_target != expected_target:
        raise CliError(
            f"--aot-target {requested_target} is incompatible with the connected device, which requires {expected_target}"
        )
    args.aot_target = expected_target
    bundle = prepare(args)
    require_bundle_target(bundle, expected_target)
    return bundle


def app_failure_recommendation(diagnostic: dict[str, Any]) -> str | None:
    error = diagnostic.get("error")
    code = error.get("code") if isinstance(error, dict) else diagnostic.get("code")
    if code in {"aot_load_failed", "aot_instantiate_failed", "entry_missing", "guest_services_failed", "guest_trap"}:
        return (
            f"If the device already runs firmware {MINIMUM_FIRMWARE_VERSION} or later, rebuild this App with "
            f"SDK {VERSION} and the pinned MicroPixel wamrc, then reinstall it."
        )
    return None


def fnv1a32(data: bytes) -> int:
    value = 0x811C9DC5
    for byte in data:
        value ^= byte
        value = (value * 0x01000193) & 0xFFFFFFFF
    return value


def validate_bundle(path: Path) -> dict[str, Any]:
    data = path.read_bytes()
    if len(data) < BUNDLE_HEADER_SIZE or len(data) % BUNDLE_ALIGNMENT or data[:8] != BUNDLE_MAGIC:
        raise CliError("Not a 64 KiB-aligned MicroPixel Bundle v1")
    fields = BUNDLE_HEADER.unpack_from(data)
    (
        _magic,
        version,
        header_size,
        bundle_size,
        toc_offset,
        app_id_field,
        app_id_length,
        section_count,
        framework_abi_version,
        _launch_asset_id,
        header_hash,
        reserved0,
        reserved1,
        reserved2,
        reserved3,
        reserved4,
    ) = fields
    if (
        version != 1
        or header_size != BUNDLE_HEADER_SIZE
        or bundle_size != len(data)
        or toc_offset != BUNDLE_HEADER_SIZE
        or not 1 <= app_id_length <= 64
        or not 1 <= section_count <= 128
        or toc_offset + section_count * BUNDLE_SECTION.size > len(data)
        or framework_abi_version != 1
        or any((reserved0, reserved1, reserved2, reserved3, reserved4))
    ):
        raise CliError("Invalid MicroPixel Bundle v1 header")
    hash_fields = list(fields)
    hash_fields[10] = 0
    if fnv1a32(BUNDLE_HEADER.pack(*hash_fields)) != header_hash:
        raise CliError("Invalid MicroPixel Bundle v1 header hash")
    app_id = app_id_field[:app_id_length].decode("ascii")
    if any(app_id_field[app_id_length:]):
        raise CliError("Invalid MicroPixel Bundle v1 App ID padding")
    quote_identifier(app_id)
    aot_sections = 0
    aot_target_mask = 0
    aot_flags = 0
    for index in range(section_count):
        section = BUNDLE_SECTION.unpack_from(data, toc_offset + index * BUNDLE_SECTION.size)
        if section[0] == 1:
            aot_sections += 1
            aot_flags = section[9]
            aot_target_mask = section[10]
            if aot_flags & ~AOT_FLAG_MASK or (
                aot_flags & AOT_FLAG_SHARED_MEMORY and not aot_flags & AOT_FLAG_THREADING_DECLARED
            ):
                raise CliError("Invalid MicroPixel Bundle v1 AOT threading metadata")
            if aot_target_mask not in {0, *AOT_TARGET_NAMES}:
                raise CliError("Invalid MicroPixel Bundle v1 AOT target metadata")
    if aot_sections > 1:
        raise CliError("Invalid MicroPixel Bundle v1 AOT target metadata")
    return {
        "appId": app_id,
        "sizeBytes": len(data),
        "aotTarget": AOT_TARGET_NAMES.get(aot_target_mask),
        "threading": (
            "shared-memory"
            if aot_flags & AOT_FLAG_SHARED_MEMORY
            else "none"
            if aot_flags & AOT_FLAG_THREADING_DECLARED
            else None
        ),
        "hasAot": aot_sections == 1,
    }


def aot_target_for_chip(chip: object) -> str:
    if not isinstance(chip, str) or not chip.strip():
        raise CliError("Device did not report its Host chip; cannot select an AOT target")
    normalized = chip.strip().upper()
    if normalized == "ESP32-S3":
        return "xtensa"
    if normalized in {"ESP32-P4", "ESP32-S31"}:
        return "riscv32-ilp32f"
    raise CliError(f"Device Host chip {chip!r} has no supported MicroPixel AOT target")


def require_bundle_target(bundle: Path, expected_target: str) -> dict[str, Any]:
    details = validate_bundle(bundle)
    if details["hasAot"]:
        actual_target = details["aotTarget"]
        if actual_target is None:
            raise CliError(
                "App Bundle has no AOT target metadata; rebuild it with the current MicroPixel CLI before installing"
            )
        if actual_target != expected_target:
            raise CliError(
                f"App Bundle targets {actual_target}, but the connected device requires {expected_target}"
            )
    return details


def print_json(value: Any) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True))


def auth_json_request(
    base_url: str,
    method: str,
    path: str,
    body: dict[str, Any],
    bearer_token: str | None = None,
) -> dict[str, Any]:
    headers = {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "User-Agent": f"MicroPixel-CLI/{VERSION} (+https://micropixel.ai/docs/)",
    }
    if bearer_token is not None:
        headers["Authorization"] = f"Bearer {bearer_token}"
    request = urllib.request.Request(
        f"{base_url}{path}",
        data=json.dumps(body, separators=(",", ":")).encode("utf-8"),
        headers=headers,
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=30.0) as response:
            value = json.loads(response.read())
    except urllib.error.HTTPError as error:
        payload = error.read()
        try:
            detail = json.loads(payload).get("error", payload.decode("utf-8", "replace"))
        except (json.JSONDecodeError, AttributeError):
            detail = payload.decode("utf-8", "replace")
        raise CliError(f"Control API returned HTTP {error.code}: {detail}") from error
    except urllib.error.URLError as error:
        raise CliError(f"Control API connection failed: {error.reason}") from error
    except json.JSONDecodeError as error:
        raise CliError("Control API returned invalid JSON") from error
    if not isinstance(value, dict):
        raise CliError("Control API returned an unexpected response")
    return value


def save_dotenv_token(path: Path, token: str) -> None:
    if not path.parent.is_dir():
        raise CliError(f"Environment file directory does not exist: {path.parent}")
    original = path.read_text(encoding="utf-8") if path.is_file() else ""
    replacement = f"MICROPIXEL_API_TOKEN={token}"
    output_lines: list[str] = []
    replaced = False
    for line in original.splitlines():
        if re.match(r"^\s*(?:export\s+)?MICROPIXEL_API_TOKEN\s*=", line):
            if not replaced:
                output_lines.append(replacement)
                replaced = True
            continue
        output_lines.append(line)
    if not replaced:
        output_lines.append(replacement)
    contents = "\n".join(output_lines) + "\n"
    temporary = path.with_name(f".{path.name}.tmp-{uuid.uuid4().hex}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        temporary.unlink(missing_ok=True)


def run_auth_pair(args: argparse.Namespace) -> None:
    environment = project_environment(Path.cwd())
    base_url = args.control_url.rstrip("/") if args.control_url else control_url(environment)
    if args.control_url:
        base_url = control_url({"MICROPIXEL_CONTROL_URL": base_url})
    issued = auth_json_request(
        base_url,
        "POST",
        "/api/v1/pairings/exchange",
        {"code": args.connection_code},
    )
    token = issued.get("token")
    device_id = issued.get("deviceId")
    if (
        not isinstance(token, str)
        or not isinstance(device_id, str)
        or issued.get("tokenKind") != "api"
        or issued.get("lifetime") != "permanent"
        or issued.get("expiresAt") is not None
        or issued.get("scopes") != list(ALL_API_SCOPES)
        or token_device_id(token) != device_id
    ):
        raise CliError("Control API did not return the requested permanent API token")
    env_file = Path(args.env_file).expanduser()
    save_dotenv_token(env_file, token)
    print(f"Connected. Permanent API token saved to {env_file.resolve()} as MICROPIXEL_API_TOKEN.")
    if os.environ.get("MICROPIXEL_API_TOKEN", "").strip() not in {"", token}:
        print(
            "Note: the current shell already exports a different MICROPIXEL_API_TOKEN; unset it to use the saved token.",
            file=sys.stderr,
        )


# Kept for callers that imported the 0.9.x script as a Python module.
run_auth_login = run_auth_pair


def guest_build_profile_flags(profile: str, aot_target: str) -> tuple[list[str], list[str], list[str]]:
    profiles = {
        "development": (["-O1", "-g"], [], ["--opt-level=1", "--size-level=3"]),
        "release": (
            ["-Oz"],
            ["-Wl,--strip-all"],
            ["--opt-level=3", "--size-level=3", "--call-stack-features=ip,func-idx"],
        ),
        "size": (
            ["-Oz"],
            ["-Wl,--strip-all"],
            ["--opt-level=3", "--size-level=3", "--call-stack-features=ip,func-idx"],
        ),
    }
    compile_flags, link_flags, aot_flags = profiles[profile]
    if aot_target == "xtensa":
        # Xtensa l32r can address literals only in the preceding 256 KiB.
        # WAMR's size-level 0 asks LLVM to emit literal islands for modules
        # whose generated text exceeds that range.
        aot_flags = [flag for flag in aot_flags if not flag.startswith("--size-level=")]
        aot_flags.append("--size-level=0")
    return list(compile_flags), list(link_flags), list(aot_flags)


def guest_threading_flags(threading: str) -> tuple[str, list[str], list[str], list[str]]:
    if threading == "none":
        return "wasm32-wasip1", [], [], []
    if threading == "shared-memory":
        return (
            "wasm32-wasip1-threads",
            ["-matomics", "-mbulk-memory"],
            ["-Wl,--shared-memory"],
            ["--enable-multi-thread"],
        )
    raise CliError("Guest threading must be none or shared-memory")


def _run_build_sources(args: argparse.Namespace) -> None:
    root = sdk_root()
    name = args.name or Path(args.source).stem
    if re.fullmatch(r"[A-Za-z0-9_-]+", name) is None:
        raise CliError("App name may contain only letters, digits, underscores, and hyphens")

    sources = [Path(args.source), *(Path(source) for source in args.extra_source)]
    for source in sources:
        if not source.is_file():
            raise CliError(f"Guest source not found: {source}")

    environment = project_environment(Path.cwd())
    aot_target = getattr(args, "aot_target", None) or environment.get(
        "MICROPIXEL_AOT_TARGET", DEFAULT_AOT_TARGET
    ).strip()
    if aot_target not in AOT_TARGET_FLAGS:
        choices = ", ".join(AOT_TARGET_FLAGS)
        raise CliError(f"Unsupported AOT target {aot_target!r}; choose one of: {choices}")
    wasi_clangxx = environment.get("WASI_CLANGXX", "").strip()
    if not wasi_clangxx and environment.get("WASI_CLANG", "").strip().endswith("clang"):
        wasi_clangxx = f"{environment['WASI_CLANG'].strip()[:-5]}clang++"
    if not wasi_clangxx and environment.get("WASI_SDK_PATH", "").strip():
        wasi_clangxx = str(Path(environment["WASI_SDK_PATH"].strip()).expanduser() / "bin/clang++")
    if not wasi_clangxx:
        local_wasi = Path.home() / ".local/wasi-sdk/bin/clang++"
        if local_wasi.is_file():
            wasi_clangxx = str(local_wasi)
    if not wasi_clangxx or not os.access(Path(wasi_clangxx).expanduser(), os.X_OK):
        raise CliError("Set WASI_CLANGXX or WASI_SDK_PATH to a C++23 compiler with the wasm32 backend")
    wasi_clangxx = str(Path(wasi_clangxx).expanduser())

    wamrc = environment.get("WAMRC", "").strip()
    if not wamrc:
        candidates = (
            (
                root / "build/tools/wamrc-xtensa/wamrc",
                root / "build/tools/wamrc-xtensa/wamrc-2.4.3",
            )
            if aot_target == "xtensa"
            else (
                root / "build/tools/wamrc-2.4.3-riscv32-ilp32f",
                root / "build/tools/wamrc-host-build-llvm19/wamrc",
                root / "build/tools/wamrc-host-build-llvm19/wamrc-2.4.3",
            )
        )
        wamrc = next((str(candidate) for candidate in candidates if os.access(candidate, os.X_OK)), "")
    if not wamrc:
        wamrc = shutil.which("wamrc") or ""
    if not wamrc or not os.access(Path(wamrc).expanduser(), os.X_OK):
        raise CliError("Set WAMRC to the locked wamrc 2.4.3 executable; see https://micropixel.ai/docs/environment/")
    wamrc = str(Path(wamrc).expanduser())
    version = subprocess.run(
        [wamrc, "--version"], check=True, capture_output=True, text=True
    ).stdout.strip()
    if version != "wamrc 2.4.3":
        raise CliError(f"WAMRC must report 'wamrc 2.4.3', got {version!r}")

    generated_include_override = getattr(args, "generated_include_override", None)
    generated_include = (
        str(generated_include_override)
        if generated_include_override is not None
        else environment.get("MICROPIXEL_GUEST_GENERATED_INCLUDE_DIR", "").strip()
    )
    if generated_include and not Path(generated_include).is_dir():
        raise CliError(f"Generated Guest include directory not found: {generated_include}")
    output_dir_override = getattr(args, "output_dir_override", None) or getattr(args, "output_dir", None)
    output_dir = Path(
        output_dir_override
        if output_dir_override is not None
        else environment.get("P4_GUEST_OUTPUT_DIR", str(Path.cwd() / "build/guest-p4"))
    )
    output_dir.mkdir(parents=True, exist_ok=True)

    compile_flags, link_flags, aot_flags = guest_build_profile_flags(args.profile, aot_target)
    threading = getattr(args, "threading", "none")
    target, thread_compile_flags, thread_link_flags, thread_aot_flags = guest_threading_flags(threading)
    include_flags = ["-I", str(root / "guest")]
    if generated_include:
        include_flags.extend(["-I", generated_include])
    wasm_output = output_dir / f"{name}.wasm"
    aot_output = output_dir / f"{name}.aot"

    subprocess.run(
        [
            wasi_clangxx,
            f"--target={target}",
            "-std=c++23",
            "-nostdlib",
            "-ffreestanding",
            *thread_compile_flags,
            "-mno-reference-types",
            *compile_flags,
            "-fno-exceptions",
            "-fno-rtti",
            "-fno-threadsafe-statics",
            "-ffunction-sections",
            "-fdata-sections",
            "-Wall",
            "-Wextra",
            "-Werror",
            *include_flags,
            "-Wl,--no-entry",
            *thread_link_flags,
            f"-Wl,--max-memory={GUEST_LINEAR_MEMORY_ABSOLUTE_MAX_BYTES}",
            "-Wl,-z,stack-size=16384",
            "-Wl,--gc-sections",
            f"-Wl,--allow-undefined-file={root / 'guest/abi/allowed_imports.txt'}",
            "-Wl,--export=__micropixel_start",
            "-Wl,--export-if-defined=__wasm_call_ctors",
            "-Wl,--export-if-defined=__micropixel_test_event_wait",
            "-Wl,--export-if-defined=__micropixel_test_touch_pressure",
            "-Wl,--export-if-defined=__micropixel_test_key_input",
            "-Wl,--export-if-defined=__micropixel_test_run_handler",
            *link_flags,
            str(root / "guest/runtime/c_runtime.cpp"),
            str(root / "guest/runtime/cxx_runtime.cpp"),
            str(root / "guest/runtime/startup.cpp"),
            str(root / "guest/runtime/sdk.cpp"),
            str(root / "guest/runtime/scene_graph.cpp"),
            *(str(source) for source in sources),
            "-lc++",
            "-o",
            str(wasm_output),
        ],
        check=True,
    )
    subprocess.run(
        [
            wamrc,
            *AOT_TARGET_FLAGS[aot_target],
            "--bounds-checks=1",
            *thread_aot_flags,
            "--enable-memory-profiling",
            "--disable-ref-types",
            "--disable-simd",
            *aot_flags,
            "--enable-dump-call-stack",
            "-o",
            str(aot_output),
            str(wasm_output),
        ],
        check=True,
    )
    print(
        f"Guest built ({args.profile}, AOT target {aot_target}, threading {threading}):"
        f"\n{wasm_output}\n{aot_output}"
    )


def _tool_path(name: str) -> Path:
    path = sdk_root() / "tools" / name
    if not path.is_file():
        raise CliError(f"This development copy does not contain {name}")
    return path


def _bundle_builder_command(arguments: list[str]) -> list[str]:
    local_builder = sdk_root() / "tools/build_app_bundle.py"
    if local_builder.is_file():
        return [sys.executable, str(local_builder), *arguments]
    if EMBEDDED_BUNDLE_BUILDER is not None:
        return [sys.executable, "-c", EMBEDDED_BUNDLE_BUILDER, *arguments]
    raise CliError("This development copy does not contain the Bundle builder")


def _run_bundle_builder(arguments: list[str]) -> None:
    subprocess.run(_bundle_builder_command(arguments), check=True)


def _manifest_child(root: Path, value: object, label: str) -> Path:
    if not isinstance(value, str) or not value or Path(value).is_absolute():
        raise CliError(f"{label} must be a non-empty path relative to app.json")
    path = (root / value).resolve()
    if not path.is_relative_to(root):
        raise CliError(f"{label} escapes the project directory: {value}")
    return path


def resolve_project_manifest(target: str | Path) -> Path | None:
    path = Path(target).expanduser()
    if path.is_dir():
        manifest = path / "app.json"
        return manifest.resolve() if manifest.is_file() else None
    if path.is_file() and path.name == "app.json":
        return path.resolve()
    return None


def load_project_manifest(path: Path) -> ProjectManifest:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise CliError(f"Cannot read project manifest {path}: {error}") from error
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        raise CliError("app.json must be an object using schema_version 1")

    package_type = value.get("package_type", "app")
    if package_type not in {"app", "component"}:
        raise CliError("app.json package_type must be app or component")
    package_id_value = value.get("app_id") if package_type == "app" else value.get("id")
    if not isinstance(package_id_value, str) or re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", package_id_value) is None:
        raise CliError("app.json requires a 1..64 byte ASCII app_id or component id")
    name = package_id_value.rsplit(".", 1)[-1]
    if re.fullmatch(r"[A-Za-z0-9_-]+", name) is None:
        raise CliError("The final package ID segment must be usable as a build name")

    project_root = path.resolve().parent
    sources: list[Path] = []
    raw_sources = value.get("sources")
    if package_type == "app":
        if "display" in value or "display_profile" in value:
            raise CliError("app.json no longer declares a display profile; inspect RendererInfo in Guest code")
        if "display_name" in value:
            raise CliError("app.json display_name has been renamed to title")
        if not isinstance(value.get("title"), (str, dict)):
            raise CliError("App project requires a title string or localized title object")
        if "source" in value:
            raise CliError("app.json source has been removed; list every translation unit in sources")
        if (
            not isinstance(raw_sources, list)
            or not raw_sources
            or not all(isinstance(item, str) for item in raw_sources)
        ):
            raise CliError("App project requires a non-empty string sources list")
        for index, raw_source in enumerate(raw_sources):
            source = _manifest_child(project_root, raw_source, f"sources[{index}]")
            if not source.is_file():
                raise CliError(f"Guest source not found: {source}")
            sources.append(source)
    elif raw_sources not in (None, []):
        raise CliError("Component projects cannot contain Guest sources")

    asset_manifest = None
    if value.get("asset_manifest") is not None:
        asset_manifest = _manifest_child(project_root, value["asset_manifest"], "asset_manifest")
        if not asset_manifest.is_file():
            raise CliError(f"Asset manifest not found: {asset_manifest}")

    threading = value.get("threading", "none")
    if package_type == "component":
        if "threading" in value:
            raise CliError("Component projects cannot declare Guest threading")
        threading = "none"
    elif threading not in {"none", "shared-memory"}:
        raise CliError("app.json threading must be none or shared-memory")

    return ProjectManifest(
        path=path.resolve(),
        value=value,
        package_id=package_id_value,
        package_type=package_type,
        name=name,
        sources=tuple(sources),
        asset_manifest=asset_manifest,
        threading=threading,
    )


def project_output_directory(project: ProjectManifest, override: str | None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    repository_apps = (sdk_root() / "guest/apps").resolve()
    if project.path.parent.is_relative_to(repository_apps):
        return (sdk_root() / "build/apps" / project.name).resolve()
    return (project.path.parent / "build").resolve()


def prepare_project(project: ProjectManifest, output_dir: Path) -> tuple[Path, Path | None]:
    output_dir.mkdir(parents=True, exist_ok=True)
    generated_dir = output_dir / "generated"
    generated_dir.mkdir(parents=True, exist_ok=True)

    if project.value.get("localization") is not None:
        subprocess.run(
            [
                sys.executable,
                str(_tool_path("generate_localization.py")),
                "--app-manifest",
                str(project.path),
                "--cpp-namespace",
                f"{project.name.replace('-', '_')}_strings",
                "--output-header",
                str(generated_dir / f"{project.name}_strings.hpp"),
                "--report",
                str(output_dir / "localization-report.json"),
            ],
            check=True,
        )

    sfx_manifest = project.path.parent / "audio/sfx.json"
    if sfx_manifest.is_file():
        analyze_command = [
            sys.executable,
            str(_tool_path("analyze_sfx.py")),
            "--manifest",
            str(sfx_manifest),
            "--emit-cpp-header",
            str(generated_dir / f"{project.name}_sfx_profiles.hpp"),
            "--report",
            str(output_dir / "sfx-report.json"),
            "--check",
        ]
        subprocess.run(analyze_command, check=True)

    resource_pack = None
    if project.asset_manifest is not None:
        resource_pack = generated_dir / "resources.pack"
        _run_bundle_builder(
            [
                "--app-manifest",
                str(project.path),
                "--asset-manifest",
                str(project.asset_manifest),
                "--prepare-resource-pack",
                str(resource_pack),
                "--emit-cpp-header",
                str(generated_dir / f"{project.name}_assets.hpp"),
                "--cpp-namespace",
                f"{project.name.replace('-', '_')}_assets",
            ]
        )
    return generated_dir, resource_pack


def build_project(
    project: ProjectManifest, profile: str, output_dir: Path, aot_target: str | None = None
) -> Path | None:
    generated_dir, _ = prepare_project(project, output_dir)
    if project.package_type == "component":
        print(f"Component resources prepared: {output_dir}")
        return None
    build_args = argparse.Namespace(
        source=str(project.sources[0]),
        extra_source=[str(source) for source in project.sources[1:]],
        name=project.name,
        profile=profile,
        aot_target=aot_target,
        generated_include_override=generated_dir,
        output_dir_override=output_dir,
        threading=project.threading,
    )
    _run_build_sources(build_args)
    return output_dir / f"{project.name}.aot"


def package_project(
    project: ProjectManifest,
    profile: str,
    output_dir: Path,
    output: str | None,
    aot_target: str | None = None,
) -> Path:
    generated_dir, resource_pack = prepare_project(project, output_dir)
    aot_output: Path | None = None
    if project.package_type == "app":
        if aot_target not in AOT_TARGET_FLAGS:
            raise CliError("App packaging requires an explicit --aot-target")
        build_args = argparse.Namespace(
            source=str(project.sources[0]),
            extra_source=[str(source) for source in project.sources[1:]],
            name=project.name,
            profile=profile,
            aot_target=aot_target,
            generated_include_override=generated_dir,
            output_dir_override=output_dir,
            threading=project.threading,
        )
        _run_build_sources(build_args)
        aot_output = output_dir / f"{project.name}.aot"

    bundle_output = (
        Path(output).expanduser().resolve()
        if output
        else output_dir / f"{project.name}.bundle.bin"
    )
    arguments = ["--app-manifest", str(project.path), "--output", str(bundle_output)]
    if aot_output is not None:
        arguments.extend(["--aot", str(aot_output), "--aot-target", aot_target])
    if resource_pack is not None:
        arguments.extend(["--resource-pack", str(resource_pack)])
    _run_bundle_builder(arguments)
    print(f"Package ready: {bundle_output}")
    return bundle_output


def run_build(args: argparse.Namespace) -> None:
    manifest_path = resolve_project_manifest(args.source)
    if manifest_path is None:
        if args.source == ".":
            raise CliError("No app.json found in the current directory")
        _run_build_sources(args)
        return
    if args.extra_source:
        raise CliError("Extra source arguments are not allowed when building an app.json project")
    project = load_project_manifest(manifest_path)
    build_project(
        project,
        args.profile,
        project_output_directory(project, args.output_dir),
        getattr(args, "aot_target", None),
    )


def run_package(args: argparse.Namespace) -> Path:
    if args.raw is not None:
        if not args.raw:
            raise CliError("package --raw requires build_app_bundle.py arguments")
        _run_bundle_builder(args.raw)
        return Path(args.output).resolve() if args.output else Path()
    manifest_path = resolve_project_manifest(args.project)
    if manifest_path is None:
        raise CliError("package requires a project directory or app.json")
    project = load_project_manifest(manifest_path)
    if project.package_type == "app" and getattr(args, "aot_target", None) is None:
        raise CliError("Offline App packaging requires --aot-target")
    return package_project(
        project,
        args.profile,
        project_output_directory(project, args.output_dir),
        args.output,
        getattr(args, "aot_target", None),
    )


def install_input(args: argparse.Namespace) -> Path:
    target = Path(args.project_or_bundle).expanduser()
    manifest_path = resolve_project_manifest(target)
    if manifest_path is not None:
        project = load_project_manifest(manifest_path)
        return package_project(
            project,
            args.profile,
            project_output_directory(project, args.output_dir),
            args.output,
            getattr(args, "aot_target", None),
        )
    if not target.is_file():
        raise CliError("install requires a project directory, app.json, or Bundle v1 file")
    validate_bundle(target)
    return target.resolve()


def run_input(args: argparse.Namespace) -> Path:
    manifest_path = resolve_project_manifest(args.project)
    if manifest_path is None:
        raise CliError("run requires a project directory or app.json")
    project = load_project_manifest(manifest_path)
    if project.package_type != "app":
        raise CliError("run requires an App project, not a Component Package")
    return package_project(
        project,
        args.profile,
        project_output_directory(project, args.output_dir),
        args.output,
        getattr(args, "aot_target", None),
    )


def current_project_app_id(directory: Path | None = None) -> str:
    root = directory or Path.cwd()
    manifest_path = resolve_project_manifest(root)
    if manifest_path is None:
        raise CliError("app start requires an App ID outside a directory containing app.json")
    project = load_project_manifest(manifest_path)
    if project.package_type != "app":
        raise CliError("app start cannot start a Component Package project")
    return project.package_id


def upload(
    client: ControlClient, bundle_path: Path, expected_target: str | None = None
) -> dict[str, Any]:
    require_compatible_firmware(client)
    details = require_bundle_target(
        bundle_path, expected_target or network_device_aot_target(client)
    )
    payload, _ = client.request(
        "POST",
        client.device_path("/packages"),
        binary_body=bundle_path.read_bytes(),
        content_type="application/vnd.micropixel.app",
        timeout=120.0,
    )
    response = json.loads(payload)
    if not isinstance(response, dict):
        raise CliError("Control API returned an unexpected upload response")
    print(f"Uploaded {details['appId']} ({details['sizeBytes']} bytes)", file=sys.stderr)
    return response


def pull_logs(
    client: ControlClient,
    cursor: str | None,
    timeout_seconds: float,
    source: str,
    command_timeout_ms: int | None = None,
) -> tuple[str | None, bool, list[dict[str, Any]]]:
    body = {"cursor": cursor, "source": source}
    if command_timeout_ms is None:
        command = client.json("POST", client.device_path("/logs/read"), body)
    else:
        command = client.json(
            "POST",
            client.device_path("/logs/read"),
            body,
            command_timeout_ms=command_timeout_ms,
        )
    client.wait_job(command, timeout_seconds)
    query_values = {"source": source}
    if cursor is not None:
        query_values["cursor"] = cursor
    query = f"?{urllib.parse.urlencode(query_values)}"
    snapshot = client.json("GET", client.device_path(f"/logs{query}"))
    entries = snapshot.get("entries", [])
    normalized_entries = [entry for entry in entries if isinstance(entry, dict)] if isinstance(entries, list) else []
    next_cursor = snapshot.get("nextCursor", cursor)
    return (
        next_cursor if isinstance(next_cursor, str) else cursor,
        snapshot.get("hasMore") is True,
        normalized_entries,
    )


def print_log_entries(entries: list[dict[str, Any]]) -> None:
    for entry in entries:
        sequence = entry.get("sequence", "-")
        level = str(entry.get("level", "info")).upper()
        source = str(entry.get("source", "app"))
        app_id = entry.get("appId")
        message = entry.get("message", "")
        prefix = f"[APP {app_id or 'unknown'}]" if source == "app" else "[HOST]"
        print(f"{sequence:>6} {level:<5} {prefix} {message}")


def stream_network_logs(
    client: ControlClient,
    *,
    cursor: str | None,
    lines: int | None,
    follow: bool,
    interval: float,
    timeout: float,
    command_timeout_ms: int | None,
    source: str,
) -> None:
    initial_entries: list[dict[str, Any]] = []
    catching_up = lines is not None
    try:
        while True:
            cursor, has_more, entries = pull_logs(client, cursor, timeout, source, command_timeout_ms)
            if catching_up:
                initial_entries.extend(entries)
                if lines == 0:
                    initial_entries.clear()
                elif lines is not None and len(initial_entries) > lines:
                    del initial_entries[:-lines]
            else:
                print_log_entries(entries)
            if catching_up and not has_more:
                print_log_entries(initial_entries)
                catching_up = False
            if not follow and not has_more:
                break
            if not has_more:
                time.sleep(interval)
    except KeyboardInterrupt:
        print("\nStopped following logs; the App is still running.", file=sys.stderr)


def stream_usb_logs(
    client: UsbControlClient,
    *,
    cursor: str | None,
    lines: int | None,
    follow: bool,
    interval: float,
    source: str,
) -> None:
    initial_entries: list[dict[str, Any]] = []
    catching_up = lines is not None
    try:
        while True:
            cursor, has_more, truncated, entries = client.read_log(cursor, source)
            if truncated:
                print("micropixel: retained system logs were truncated before this cursor", file=sys.stderr)
            if catching_up:
                initial_entries.extend(entries)
                if lines == 0:
                    initial_entries.clear()
                elif lines is not None and len(initial_entries) > lines:
                    del initial_entries[:-lines]
            else:
                print_log_entries(entries)
            if catching_up and not has_more:
                print_log_entries(initial_entries)
                catching_up = False
            if not follow and not has_more:
                break
            if not has_more:
                time.sleep(interval)
    except KeyboardInterrupt:
        print("\nStopped following logs; the App is still running.", file=sys.stderr)


def active_remote_app_id(snapshot: dict[str, Any]) -> str | None:
    status = snapshot.get("status")
    runtime = status.get("runtime") if isinstance(status, dict) else None
    sessions = runtime.get("runtimeSessions") if isinstance(runtime, dict) else None
    if not isinstance(sessions, list):
        return None
    foreground_session_id = runtime.get("foregroundSessionId")
    ordered = sorted(
        (session for session in sessions if isinstance(session, dict)),
        key=lambda session: session.get("sessionId") != foreground_session_id,
    )
    for session in ordered:
        app_id = session.get("appId")
        if isinstance(app_id, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", app_id) is not None:
            return app_id
    return None


def remote_app_action(
    client: ControlClient,
    args: argparse.Namespace,
    app_id: str,
    action: str,
    idempotency_scope: str,
    launch_arguments: list[str] | None = None,
) -> dict[str, Any]:
    encoded_app_id = quote_identifier(app_id)
    job = create_job(
        client,
        args,
        "POST",
        client.device_path(f"/apps/{encoded_app_id}/actions/{action}"),
        {"launchArguments": validate_launch_arguments(launch_arguments)} if action == "start" and launch_arguments else {},
        idempotency_scope=idempotency_scope,
    )
    return client.wait_job(job, args.timeout)


def restore_remote_app(client: ControlClient, args: argparse.Namespace, app_id: str | None) -> None:
    if app_id is None:
        return
    try:
        remote_app_action(client, args, app_id, "start", "run-restore")
        print(f"Restored previously running App {app_id}.", file=sys.stderr)
    except CliError as error:
        print(f"micropixel: could not restore previously running App {app_id}: {error}", file=sys.stderr)


def run_network_app(args: argparse.Namespace, client: ControlClient) -> None:
    snapshot = client.json("GET", client.device_path())
    previous_app_id = active_remote_app_id(snapshot)
    require_compatible_firmware(client)

    stop_job = create_job(
        client,
        args,
        "POST",
        client.device_path("/runtime/foreground/stop"),
        {},
        idempotency_scope="run-stop",
    )
    client.wait_job(stop_job, args.timeout)
    if previous_app_id is not None:
        print(f"Stopped {previous_app_id}.", file=sys.stderr)

    try:
        package = upload(client, Path(args.bundle), getattr(args, "aot_target", None))
        package_id = package.get("packageId")
        install_job = create_job(
            client,
            args,
            "POST",
            client.device_path("/apps/install"),
            {"packageId": package_id},
            idempotency_scope="run-install",
        )
        client.wait_job(install_job, args.timeout)
        print(f"Installed {args.app_id}.", file=sys.stderr)
        remote_app_action(client, args, args.app_id, "start", "run-start", getattr(args, "launch_arguments", []))
        print(f"Started {args.app_id}.", file=sys.stderr)
    except CliError:
        restore_remote_app(client, args, previous_app_id)
        raise

    if args.follow:
        print("Following Guest logs; press Ctrl-C to detach.", file=sys.stderr)
        stream_network_logs(
            client,
            cursor=None,
            lines=None,
            follow=True,
            interval=args.interval,
            timeout=args.timeout,
            command_timeout_ms=getattr(args, "command_timeout_ms", None),
            source="app",
        )


def restore_usb_app(client: UsbControlClient, app_id: str | None) -> None:
    if app_id is None:
        return
    try:
        client.action("APP_START", app_id)
        print(f"Restored previously running App {app_id}.", file=sys.stderr)
    except CliError as error:
        print(f"micropixel: could not restore previously running App {app_id}: {error}", file=sys.stderr)


def install_usb_with_progress(
    client: UsbControlClient,
    bundle: Path,
    app_id: str,
    expected_target: str | None = None,
) -> dict[str, Any]:
    require_bundle_target(bundle, expected_target or usb_device_aot_target(client))
    progress = TerminalProgress(f"Installing {app_id}")
    try:
        return client.install(bundle, progress.update)
    finally:
        progress.close()


def run_usb_app(args: argparse.Namespace, client: UsbControlClient) -> None:
    status = client.device_status()
    runtime = status.get("runtime")
    previous_app_id = runtime.get("activeAppId") if isinstance(runtime, dict) else None
    if not isinstance(previous_app_id, str):
        previous_app_id = None

    client.action("APP_STOP")
    if previous_app_id is not None:
        print(f"Stopped {previous_app_id}.", file=sys.stderr)

    try:
        install_usb_with_progress(client, Path(args.bundle), args.app_id, getattr(args, "aot_target", None))
        print(f"Installed {args.app_id}.", file=sys.stderr)
        launch_arguments = getattr(args, "launch_arguments", [])
        if launch_arguments:
            client.action("APP_START", args.app_id, launch_arguments)
        else:
            client.action("APP_START", args.app_id)
        print(f"Started {args.app_id}.", file=sys.stderr)
    except CliError:
        restore_usb_app(client, previous_app_id)
        raise

    if args.follow:
        print("Following Guest logs; press Ctrl-C to detach.", file=sys.stderr)
        stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")


def non_negative_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a non-negative integer") from error
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be a non-negative integer")
    return parsed


def screenshot_artifact(client: ControlClient, completed: dict[str, Any], output: Path) -> None:
    result = completed.get("result")
    screenshots = result.get("screenshots") if isinstance(result, dict) else None
    first = screenshots[0] if isinstance(screenshots, list) and screenshots else None
    url = first.get("downloadUrl") if isinstance(first, dict) else None
    if not isinstance(url, str) or not url.startswith("/"):
        raise CliError("Job completed without a valid screenshot artifact URL")
    image, media_type = client.request("GET", url, timeout=60.0)
    if media_type != "image/jpeg" or len(image) < 4 or image[:2] != b"\xff\xd8" or image[-2:] != b"\xff\xd9":
        raise CliError("Screenshot artifact is not a valid JPEG")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(image)


def bounded_argument(value: int, minimum: int, maximum: int, label: str) -> int:
    if not minimum <= value <= maximum:
        raise CliError(f"{label} must be between {minimum} and {maximum}")
    return value


def input_operations(args: argparse.Namespace) -> list[dict[str, Any]]:
    if args.input_command == "press":
        hold_ms = bounded_argument(args.hold_ms, 0, 5_000, "--hold-ms")
        operations: list[dict[str, Any]] = [
            {"type": "key", "code": args.code, "phase": "down"},
            {"type": "key", "code": args.code, "phase": "up", "delayMs": hold_ms},
        ]
    elif args.input_command == "tap":
        x = bounded_argument(args.x, 0, 0x7FFF_FFFF, "x")
        y = bounded_argument(args.y, 0, 0x7FFF_FFFF, "y")
        pressure = bounded_argument(args.pressure, 0, 1_000, "--pressure")
        hold_ms = bounded_argument(args.hold_ms, 0, 5_000, "--hold-ms")
        operations = [
            {"type": "touch", "phase": "down", "id": 0, "x": x, "y": y, "pressurePerMille": pressure},
            {
                "type": "touch",
                "phase": "up",
                "id": 0,
                "x": x,
                "y": y,
                "pressurePerMille": 0,
                "delayMs": hold_ms,
            },
        ]
    elif args.input_command == "swipe":
        x1 = bounded_argument(args.x1, 0, 0x7FFF_FFFF, "x1")
        y1 = bounded_argument(args.y1, 0, 0x7FFF_FFFF, "y1")
        x2 = bounded_argument(args.x2, 0, 0x7FFF_FFFF, "x2")
        y2 = bounded_argument(args.y2, 0, 0x7FFF_FFFF, "y2")
        pressure = bounded_argument(args.pressure, 0, 1_000, "--pressure")
        duration_ms = bounded_argument(args.duration_ms, 0, 5_000, "--duration-ms")
        steps = bounded_argument(args.steps, 2, 13, "--steps")
        step_delay = duration_ms // (steps - 1)
        operations = []
        for index in range(steps):
            fraction = index / (steps - 1)
            operations.append(
                {
                    "type": "touch",
                    "phase": "down" if index == 0 else "move",
                    "id": 0,
                    "x": round(x1 + (x2 - x1) * fraction),
                    "y": round(y1 + (y2 - y1) * fraction),
                    "pressurePerMille": pressure,
                    **({"delayMs": step_delay} if index else {}),
                }
            )
        operations.append(
            {"type": "touch", "phase": "up", "id": 0, "x": x2, "y": y2, "pressurePerMille": 0}
        )
    elif args.input_command == "sequence":
        try:
            text = sys.stdin.read() if args.file == "-" else Path(args.file).read_text(encoding="utf-8")
            value = json.loads(text)
        except (OSError, json.JSONDecodeError) as error:
            raise CliError(f"Cannot read input sequence: {error}") from error
        raw_operations = value.get("operations") if isinstance(value, dict) else value
        if not isinstance(raw_operations, list) or not all(isinstance(item, dict) for item in raw_operations):
            raise CliError("Input sequence must be a JSON operation array or an object containing operations")
        operations = raw_operations
    else:
        raise CliError(f"Unsupported input command: {args.input_command}")

    if args.screenshot:
        if len(operations) >= 16:
            raise CliError("Input sequence has no room for the requested screenshot operation")
        operations.append({"type": "screenshot", "id": "after-input", "delayMs": 120})
    if not 1 <= len(operations) <= 16:
        raise CliError("Input sequence must contain between 1 and 16 operations")
    return operations


def execute_network(args: argparse.Namespace, client: ControlClient) -> None:
    if args.command == "device" and args.device_command == "status":
        snapshot = client.json("GET", client.device_path())
        if args.full:
            print_json(snapshot)
            return
        status = snapshot.get("status")
        status = status if isinstance(status, dict) else {}
        runtime = status.get("runtime")
        runtime = runtime if isinstance(runtime, dict) else {}
        print_json(
            {
                "online": snapshot.get("online") is True,
                "foregroundSessionId": runtime.get("foregroundSessionId"),
                "foregroundSurface": runtime.get("foregroundSurface"),
                "runtimeSessions": runtime.get("runtimeSessions", []),
                "network": status.get("network"),
                "firmwareUpdate": status.get("firmwareUpdate"),
                "lastSeenAt": snapshot.get("lastSeenAt"),
            }
        )
    elif args.command == "device" and args.device_command == "diagnostics":
        if not args.cached:
            system_job = create_job(
                client,
                args,
                "POST",
                client.device_path("/system-info/refresh"),
                {},
                idempotency_scope="system-info",
            )
            client.wait_job(system_job, args.timeout)
            task_job = create_job(
                client,
                args,
                "POST",
                client.device_path("/task-diagnostics/refresh"),
                {},
                idempotency_scope="task-diagnostics",
            )
            client.wait_job(task_job, args.timeout)
        system_info = client.json("GET", client.device_path("/system-info"))
        task_diagnostics = client.json("GET", client.device_path("/task-diagnostics"))
        print_json({**system_info, "taskDiagnostics": task_diagnostics})
    elif args.command == "device" and args.device_command == "reboot":
        job = create_job(client, args, "POST", client.device_path("/reboot"), {})
        print_json(client.wait_job(job, args.timeout))
    elif args.command == "firmware":
        snapshot = client.json("GET", client.device_path())
        status = snapshot.get("status")
        current_version = status.get("firmwareVersion") if isinstance(status, dict) else None
        query = ""
        body: dict[str, str] = {}
        if isinstance(current_version, str) and current_version:
            encoded = urllib.parse.quote(current_version, safe="")
            query = f"?currentVersion={encoded}"
            body["currentVersion"] = current_version
        if args.firmware_command == "status":
            print_json(client.json("GET", client.device_path(f"/firmware/latest{query}")))
        elif args.firmware_command == "update":
            if snapshot.get("online") is not True:
                raise CliError("The device is offline. Bring it online before updating its firmware.")
            job = create_job(client, args, "POST", client.device_path("/firmware/update"), body)
            print_json(client.wait_job(job, args.timeout))
    elif args.command == "app" and args.app_command == "list":
        if not args.cached:
            job = create_job(client, args, "POST", client.device_path("/apps/refresh"), {})
            client.wait_job(job, args.timeout)
        catalog = client.json("GET", client.device_path("/apps"))
        if args.running:
            apps = catalog.get("apps")
            if isinstance(apps, list):
                running_states = {"running", "foreground", "starting", "resuming", "suspended"}
                filtered = [
                    app
                    for app in apps
                    if isinstance(app, dict)
                    and (app.get("active") is True or app.get("lifecycle") in running_states)
                ]
                catalog = {**catalog, "apps": filtered, "count": len(filtered)}
        print_json(catalog)
    elif args.command == "app" and args.app_command == "last-error":
        response = client.json("GET", client.device_path("/app-errors/latest"))
        diagnostic = response.get("error")
        if isinstance(diagnostic, dict):
            recommendation = app_failure_recommendation(diagnostic)
            print_json({**diagnostic, **({"recommendation": recommendation} if recommendation else {})})
        else:
            print_json(response)
    elif args.command == "artifact" and args.artifact_command == "upload":
        print_json(upload(client, Path(args.bundle), getattr(args, "aot_target", None)))
    elif args.command == "app" and args.app_command == "upload":
        print_json(upload(client, Path(args.bundle), getattr(args, "aot_target", None)))
    elif args.command == "app" and args.app_command == "install":
        package = upload(client, Path(args.bundle), getattr(args, "aot_target", None))
        package_id = package.get("packageId")
        job = create_job(client, args, "POST", client.device_path("/apps/install"), {"packageId": package_id})
        print_json(client.wait_job(job, args.timeout))
        if getattr(args, "start", False):
            require_compatible_firmware(client)
            app_id = quote_identifier(args.app_id)
            start_job = create_job(
                client,
                args,
                "POST",
                client.device_path(f"/apps/{app_id}/actions/start"),
                {},
                idempotency_scope="start",
            )
            print_json(client.wait_job(start_job, args.timeout))
            if getattr(args, "follow", False):
                stream_network_logs(
                    client,
                    cursor=None,
                    lines=None,
                    follow=True,
                    interval=args.interval,
                    timeout=args.timeout,
                    command_timeout_ms=getattr(args, "command_timeout_ms", None),
                    source="app",
                )
    elif args.command == "app" and args.app_command in {"start", "stop"}:
        if args.app_command == "stop" and args.app_id is None:
            job = create_job(client, args, "POST", client.device_path("/runtime/foreground/stop"), {})
            print_json(client.wait_job(job, args.timeout))
            return
        if args.app_command == "start":
            require_compatible_firmware(client)
        app_id = quote_identifier(args.app_id)
        action = args.app_command
        action_body = (
            {"launchArguments": validate_launch_arguments(getattr(args, "launch_arguments", []))}
            if action == "start" and getattr(args, "launch_arguments", [])
            else {}
        )
        job = create_job(client, args, "POST", client.device_path(f"/apps/{app_id}/actions/{action}"), action_body)
        print_json(client.wait_job(job, args.timeout))
        if args.app_command == "start" and getattr(args, "follow", False):
            stream_network_logs(
                client,
                cursor=None,
                lines=None,
                follow=True,
                interval=args.interval,
                timeout=args.timeout,
                command_timeout_ms=getattr(args, "command_timeout_ms", None),
                source="app",
            )
    elif args.command == "app" and args.app_command == "uninstall":
        app_id = quote_identifier(args.app_id)
        job = create_job(client, args, "DELETE", client.device_path(f"/apps/{app_id}"))
        print_json(client.wait_job(job, args.timeout))
    elif args.command == "logs":
        stream_network_logs(
            client,
            cursor=args.cursor,
            lines=args.lines,
            follow=args.follow,
            interval=args.interval,
            timeout=args.timeout,
            command_timeout_ms=getattr(args, "command_timeout_ms", None),
            source=getattr(args, "source", "all"),
        )
    elif args.command == "screenshot":
        job = create_job(client, args, "POST", client.device_path("/screenshots"), {})
        completed = client.wait_job(job, args.timeout)
        output = Path(args.output)
        screenshot_artifact(client, completed, output)
        print(output)
    elif args.command == "input":
        operations = input_operations(args)
        job = create_job(client, args, "POST", client.device_path("/input-sequences"), {"operations": operations})
        completed = client.wait_job(job, args.timeout)
        if args.screenshot:
            screenshot_artifact(client, completed, Path(args.screenshot))
        print_json(completed)
    elif args.command == "job" and args.job_command == "wait":
        try:
            job_id = str(uuid.UUID(args.job_id))
        except ValueError as error:
            raise CliError("job wait requires a valid Job UUID") from error
        print_json(client.wait_job({"id": job_id}, args.timeout))


def execute_usb(args: argparse.Namespace, client: UsbControlClient) -> None:
    if args.command == "device" and args.device_command == "status":
        print_json(client.device_status())
    elif args.command == "device" and args.device_command == "diagnostics":
        print_json({**client.device_status(), "taskDiagnostics": client.task_diagnostics()})
    elif args.command == "device" and args.device_command == "reboot":
        print_json(client.action("DEVICE_REBOOT"))
    elif args.command == "app" and args.app_command == "list":
        catalog = client.list_apps()
        if args.running:
            apps = [app for app in catalog["apps"] if app.get("active") is True]
            catalog = {**catalog, "apps": apps, "count": len(apps)}
        print_json(catalog)
    elif args.command == "app" and args.app_command == "last-error":
        print_json(client.last_app_error())
    elif args.command == "app" and args.app_command == "install":
        print_json(
            install_usb_with_progress(
                client, Path(args.bundle), args.app_id, getattr(args, "aot_target", None)
            )
        )
        if getattr(args, "start", False):
            print_json(client.action("APP_START", args.app_id))
            if getattr(args, "follow", False):
                stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")
    elif args.command == "app" and args.app_command == "start":
        launch_arguments = getattr(args, "launch_arguments", [])
        print_json(
            client.action("APP_START", args.app_id, launch_arguments)
            if launch_arguments
            else client.action("APP_START", args.app_id)
        )
        if getattr(args, "follow", False):
            stream_usb_logs(client, cursor=None, lines=None, follow=True, interval=args.interval, source="app")
    elif args.command == "app" and args.app_command == "stop":
        print_json(client.action("APP_STOP", args.app_id))
    elif args.command == "app" and args.app_command == "uninstall":
        print_json(client.action("APP_UNINSTALL", args.app_id))
    elif args.command == "logs":
        stream_usb_logs(
            client,
            cursor=args.cursor,
            lines=args.lines,
            follow=args.follow,
            interval=args.interval,
            source=getattr(args, "source", "all"),
        )
    elif args.command == "screenshot":
        jpeg, _width, _height = client.capture_screen()
        output = Path(args.output)
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(jpeg)
        print(output)
    elif args.command == "input":
        operations = input_operations(args)
        capture_requested = any(operation.get("type") == "screenshot" for operation in operations)
        input_only = [operation for operation in operations if operation.get("type") != "screenshot"]
        completed = (
            client.input_sequence(input_only)
            if input_only
            else {"status": "succeeded", "result": {"message": "no_input"}, "transport": "usb"}
        )
        if capture_requested:
            jpeg, width, height = client.capture_screen()
            if args.screenshot:
                output = Path(args.screenshot)
                output.parent.mkdir(parents=True, exist_ok=True)
                output.write_bytes(jpeg)
                completed["result"]["screenshot"] = {
                    "path": str(output), "width": width, "height": height, "mediaType": "image/jpeg"
                }
        print_json(completed)
    elif args.command == "firmware" and args.firmware_command == "status":
        print_json(client.firmware_status())
    elif args.command == "firmware" and args.firmware_command == "update":
        print_json(client.action("FIRMWARE_UPDATE"))
    else:
        suffix = getattr(args, "app_command", getattr(args, "device_command", ""))
        raise CliError(f"{args.command} {suffix}".strip() + " is not available over USB")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="micropixel", description=__doc__)
    result.add_argument("--version", action="version", version=f"micropixel {VERSION}")
    result.add_argument(
        "--transport",
        choices=["remote", "usb"],
        default=os.environ.get("MICROPIXEL_TRANSPORT", "remote"),
        help="Device transport for control commands (default: remote)",
    )
    result.add_argument("--port", help="USB Serial/JTAG port; auto-detected when one ESP32 device is connected")
    commands = result.add_subparsers(dest="command", required=True)

    build = commands.add_parser("build", help="Build an app.json project into Wasm and AOT")
    build.add_argument("source", nargs="?", default=".", help="Project directory, app.json, or legacy C++ source")
    build.add_argument("extra_source", nargs="*")
    build.add_argument("--name")
    build.add_argument("--profile", choices=["development", "release", "size"], default="development")
    build.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    build.add_argument("--output-dir", help="Build output directory")

    package = commands.add_parser("package", help="Build an app.json project into an installable Bundle v1")
    package.add_argument("project", nargs="?", default=".", help="Project directory or app.json (default: .)")
    package.add_argument("--profile", choices=["development", "release", "size"], default="release")
    package.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    package.add_argument("--output-dir", help="Build output directory")
    package.add_argument("--output", help="Bundle output path")
    package.add_argument(
        "--raw",
        nargs=argparse.REMAINDER,
        help=argparse.SUPPRESS,
    )

    run = commands.add_parser("run", help="Build, install, start, and attach to an App project")
    run.add_argument("project", nargs="?", default=".", help="Project directory or app.json (default: .)")
    run.add_argument("--profile", choices=["development", "release", "size"], default="development")
    run.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    run.add_argument("--output-dir", help="Build output directory")
    run.add_argument("--output", help="Bundle output path")
    run.add_argument(
        "--no-follow",
        dest="follow",
        action="store_false",
        help="Return after starting instead of following Guest logs",
    )
    run.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    run.set_defaults(follow=True)
    run.set_defaults(launch_arguments=[])

    bundle = commands.add_parser("bundle", help="Inspect and validate MicroPixel Bundles")
    bundle_modes = bundle.add_subparsers(dest="bundle_command", required=True)
    bundle_validate = bundle_modes.add_parser("validate", help="Validate a Bundle v1 header")
    bundle_validate.add_argument("bundle")

    validate = commands.add_parser("validate", help="Deprecated alias for 'bundle validate'")
    validate.add_argument("bundle")

    auth = commands.add_parser("auth", help="Pair a device and manage Control API authentication")
    auth_modes = auth.add_subparsers(dest="auth_command", required=True)

    def add_pair_options(command: argparse.ArgumentParser) -> None:
        command.add_argument("--connection-code", required=True, help="One-time code shown on the device")
        command.add_argument("--env-file", default=".env", help="Local environment file to update (default: .env)")
        command.add_argument("--control-url", help="Control API origin (default: MICROPIXEL_CONTROL_URL or production)")

    pair = auth_modes.add_parser("pair", help="Exchange a device connection code for a permanent API token")
    add_pair_options(pair)
    login = auth_modes.add_parser("login", help="Deprecated alias for 'auth pair'")
    add_pair_options(login)

    device = commands.add_parser("device", help="Read device connection state and runtime diagnostics")
    device_modes = device.add_subparsers(dest="device_command", required=True)
    status = device_modes.add_parser("status", help="Show online state, current App, network, and firmware state")
    status.add_argument("--full", action="store_true", help="Show the complete cached Control API snapshot")
    diagnostics = device_modes.add_parser("diagnostics", help="Refresh hardware, memory, task, and runtime details")
    diagnostics.add_argument("--cached", action="store_true", help="Read the last snapshot without refreshing the device")
    reboot = device_modes.add_parser("reboot", help="Reboot the device")

    port = commands.add_parser("port", help="Discover local serial ports and MicroPixel hardware")
    port_modes = port.add_subparsers(dest="port_command", required=True)
    port_list = port_modes.add_parser("list", help="List local MicroPixel ports, boards, and chip types")
    port_list.add_argument(
        "--all", action="store_true", help="Include serial ports that are not MicroPixel candidates"
    )
    port_list.add_argument("--timeout", type=float, default=2.0, help="Handshake timeout per candidate port")

    firmware = commands.add_parser("firmware", help="Check or install device firmware updates")
    firmware_modes = firmware.add_subparsers(dest="firmware_command", required=True)
    firmware_modes.add_parser("status", help="Show the installed and latest firmware versions")
    firmware_update = firmware_modes.add_parser("update", help="Install the latest firmware on the device")

    app = commands.add_parser("app", help="List, install, start, stop, inspect, and uninstall Apps")
    app_modes = app.add_subparsers(dest="app_command", required=True)
    app_list = app_modes.add_parser("list", help="Refresh and list installed Apps")
    app_list.add_argument("--running", action="store_true", help="Show only Apps that are active or suspended")
    app_list.add_argument("--cached", action="store_true", help="Read the last catalog without refreshing the device")
    app_modes.add_parser("last-error", help="Show the most recent AOT load, launch, or runtime failure")
    upload_command = app_modes.add_parser("upload", help="Deprecated alias for 'artifact upload'")
    upload_command.add_argument("bundle")
    install = app_modes.add_parser("install", help="Build if needed, then upload and install an App")
    install.add_argument(
        "project_or_bundle", nargs="?", default=".", help="Project directory, app.json, or Bundle v1 (default: .)"
    )
    install.add_argument("--profile", choices=["development", "release", "size"], default="release")
    install.add_argument("--aot-target", choices=tuple(AOT_TARGET_FLAGS), default=None)
    install.add_argument("--output-dir", help="Build output directory")
    install.add_argument("--output", help="Bundle output path when building a project")
    install.add_argument("--start", action="store_true", help="Start the App after it is installed")
    install.add_argument("-f", "--follow", action="store_true", help="Follow Guest logs after starting the App")
    install.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    start = app_modes.add_parser("start", help="Start an installed App")
    start.add_argument("app_id", nargs="?", help="App ID; inferred from ./app.json when omitted")
    start.add_argument("-f", "--follow", action="store_true", help="Follow Guest logs after the App starts")
    start.add_argument("--interval", type=float, default=2.0, help="Seconds between log polls (default: 2)")
    start.set_defaults(launch_arguments=[])
    stop = app_modes.add_parser("stop", help="Stop an App or whichever App owns the runtime")
    stop.add_argument("app_id", nargs="?", help="App ID; omit to stop whichever App owns the runtime")
    uninstall = app_modes.add_parser("uninstall", help="Uninstall an App from the device")
    uninstall.add_argument("app_id")

    artifact = commands.add_parser("artifact", help="Manage remote Control API artifacts")
    artifact_modes = artifact.add_subparsers(dest="artifact_command", required=True)
    artifact_upload = artifact_modes.add_parser(
        "upload", help="Upload a Bundle without installing it (remote transport only)"
    )
    artifact_upload.add_argument("bundle")
    logs = commands.add_parser("logs", help="Read retained Host and App logs")
    logs.add_argument("--follow", action="store_true")
    logs.add_argument(
        "-n",
        "--lines",
        type=non_negative_int,
        metavar="N",
        help="Show only the latest N retained log entries before following",
    )
    logs.add_argument("--cursor", help="Opaque cursor returned by a previous log read")
    logs.add_argument(
        "--source",
        choices=["all", "host", "app"],
        default="all",
        help="Select all, Host, or App logs (default: all)",
    )
    logs.add_argument("--interval", type=float, default=2.0)
    screenshot = commands.add_parser("screenshot", help="Capture a JPEG screenshot")
    screenshot.add_argument("--output", default="micropixel-screenshot.jpg")
    input_command = commands.add_parser("input", help="Send a button press, screen tap, swipe, or JSON sequence")
    input_modes = input_command.add_subparsers(dest="input_command", required=True)

    press = input_modes.add_parser("press", help="Press and release a device button such as confirm or back")
    press.add_argument(
        "code",
        choices=["up", "down", "left", "right", "confirm", "back", "menu", "south", "east", "west", "north"],
    )
    press.add_argument("--hold-ms", type=int, default=80)
    tap = input_modes.add_parser("tap", help="Touch and release a screen coordinate")
    tap.add_argument("x", type=int)
    tap.add_argument("y", type=int)
    tap.add_argument("--pressure", type=int, default=500)
    tap.add_argument("--hold-ms", type=int, default=80)
    swipe = input_modes.add_parser("swipe", help="Swipe between two screen coordinates")
    swipe.add_argument("x1", type=int)
    swipe.add_argument("y1", type=int)
    swipe.add_argument("x2", type=int)
    swipe.add_argument("y2", type=int)
    swipe.add_argument("--duration-ms", type=int, default=240)
    swipe.add_argument("--steps", type=int, default=8)
    swipe.add_argument("--pressure", type=int, default=500)
    sequence = input_modes.add_parser("sequence", help="Read a JSON operation sequence from a file or stdin (-)")
    sequence.add_argument("file")

    def add_job_options(command: argparse.ArgumentParser) -> None:
        command.add_argument(
            "--wait-timeout",
            "--timeout",
            dest="timeout",
            type=float,
            default=300.0,
            help="Seconds the CLI waits for the terminal Job state",
        )
        command.add_argument(
            "--command-timeout-ms",
            type=int,
            help="Device execution deadline in milliseconds",
        )
        command.add_argument(
            "--idempotency-key",
            help="Stable 8-128 character key to reuse after an ambiguous request result",
        )

    for mode in (press, tap, swipe, sequence):
        mode.add_argument("--screenshot", metavar="JPEG", help="Append a screenshot to the same device Job")
        add_job_options(mode)
    for command in (
        diagnostics,
        reboot,
        firmware_update,
        run,
        app_list,
        install,
        start,
        stop,
        uninstall,
        screenshot,
    ):
        add_job_options(command)
    logs.add_argument("--wait-timeout", "--timeout", dest="timeout", type=float, default=300.0)
    logs.add_argument("--command-timeout-ms", type=int)

    job = commands.add_parser("job", help="Resume waiting for an existing Control Job")
    job_modes = job.add_subparsers(dest="job_command", required=True)
    job_wait = job_modes.add_parser("wait", help="Wait for a Job UUID to reach a terminal state")
    job_wait.add_argument("job_id")
    job_wait.add_argument("--wait-timeout", "--timeout", dest="timeout", type=float, default=300.0)
    return result


def parse_command_line(arguments: list[str] | None = None) -> argparse.Namespace:
    raw = list(sys.argv[1:] if arguments is None else arguments)
    if "--" not in raw:
        return parser().parse_args(raw)
    separator = raw.index("--")
    try:
        parsed = parser().parse_args(raw[:separator])
    except SystemExit:
        return parser().parse_args(raw)
    supports_launch_arguments = parsed.command == "run" or (
        parsed.command == "app" and getattr(parsed, "app_command", None) == "start"
    )
    if not supports_launch_arguments:
        return parser().parse_args(raw)
    parsed.launch_arguments = validate_launch_arguments(raw[separator + 1 :])
    return parsed


def main() -> int:
    try:
        args = parse_command_line()
        if args.command == "validate":
            print("micropixel: 'validate' is deprecated; use 'bundle validate'", file=sys.stderr)
        if args.command == "auth" and args.auth_command == "login":
            print("micropixel: 'auth login' is deprecated; use 'auth pair'", file=sys.stderr)
        if args.command == "app" and args.app_command == "upload":
            print("micropixel: 'app upload' is deprecated; use 'artifact upload'", file=sys.stderr)

        if args.command == "build":
            run_build(args)
        elif args.command == "package":
            run_package(args)
        elif args.command == "run":
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    bundle = prepare_connected_bundle(args, usb_device_aot_target(client), run_input)
                    args.bundle = str(bundle)
                    args.app_id = validate_bundle(bundle)["appId"]
                    run_usb_app(args, client)
            else:
                client = ControlClient(ControlConfig.load(Path.cwd()))
                bundle = prepare_connected_bundle(args, network_device_aot_target(client), run_input)
                args.bundle = str(bundle)
                args.app_id = validate_bundle(bundle)["appId"]
                run_network_app(args, client)
        elif args.command == "app" and args.app_command == "install":
            if args.follow and not args.start:
                raise CliError("app install --follow requires --start")
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    bundle = prepare_connected_bundle(args, usb_device_aot_target(client), install_input)
                    args.bundle = str(bundle)
                    args.app_id = validate_bundle(bundle)["appId"]
                    execute_usb(args, client)
            else:
                client = ControlClient(ControlConfig.load(Path.cwd()))
                bundle = prepare_connected_bundle(args, network_device_aot_target(client), install_input)
                args.bundle = str(bundle)
                args.app_id = validate_bundle(bundle)["appId"]
                execute_network(args, client)
        elif args.command == "app" and args.app_command == "start":
            if args.app_id is None:
                args.app_id = current_project_app_id()
            if args.transport == "usb":
                with UsbControlClient(args.port, args.timeout) as client:
                    execute_usb(args, client)
            else:
                execute_network(args, ControlClient(ControlConfig.load(Path.cwd())))
        elif args.command == "bundle" and args.bundle_command == "validate":
            print_json(validate_bundle(Path(args.bundle)))
        elif args.command == "validate":
            print_json(validate_bundle(Path(args.bundle)))
        elif args.command == "auth" and args.auth_command in {"pair", "login"}:
            run_auth_pair(args)
        elif args.command == "port" and args.port_command == "list":
            print_json(list_local_ports(args.all, args.timeout))
        elif args.command in NETWORK_COMMANDS:
            if args.transport == "usb":
                with UsbControlClient(args.port, getattr(args, "timeout", 300.0)) as client:
                    execute_usb(args, client)
            else:
                execute_network(args, ControlClient(ControlConfig.load(Path.cwd())))
        else:
            raise CliError(f"Unsupported command: {args.command}")
        return 0
    except (CliError, FileNotFoundError, PermissionError, subprocess.CalledProcessError) as error:
        print(f"micropixel: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
