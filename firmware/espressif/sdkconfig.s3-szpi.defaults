# LCKFB SZPI ESP32-S3 board profile (ESP32-S3-WROOM-1-N16R8).
CONFIG_MICROPIXEL_BOARD_SZPI_ESP32S3=y
CONFIG_MICROPIXEL_SZPI_S3_LVGL_DOUBLE_BUFFER=y

# Keep both drawing buffers and the RGB565 SPI DMA staging buffer in SRAM.
# Smaller strips preserve internal memory for networking and Guest tasks.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=35
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set

CONFIG_ESP_LVGL_ADAPTER_ENABLE_PERFORMANCE_TELEMETRY=y
