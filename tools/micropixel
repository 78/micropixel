class CliError(RuntimeError):
    pass


def validate_launch_arguments(arguments: list[str]) -> list[str]:
    if len(arguments) > LAUNCH_ARGUMENT_MAX_COUNT:
        raise CliError(f"at most {LAUNCH_ARGUMENT_MAX_COUNT} launch arguments are supported")
    total_bytes = 0
    for argument in arguments:
        if "\0" in argument:
            raise CliError("launch arguments cannot contain NUL bytes")
        total_bytes += len(argument.encode("utf-8")) + 1
    if total_bytes > LAUNCH_ARGUMENT_MAX_BYTES:
        raise CliError(f"launch arguments exceed the {LAUNCH_ARGUMENT_MAX_BYTES}-byte limit")
    return arguments


def encode_launch_arguments(arguments: list[str]) -> str:
    validate_launch_arguments(arguments)
    if not arguments:
        return ""
    payload = b"".join(argument.encode("utf-8") + b"\0" for argument in arguments)
    return base64.b64encode(payload).decode("ascii")


class TerminalProgress:
    BAR_WIDTH = 24

    def __init__(self, label: str, stream: TextIO | None = None) -> None:
        self.label = label
        self.stream = stream if stream is not None else sys.stderr
        self.interactive = self.stream.isatty()
        self.last_percent = -1
        self.line_active = False

    def update(self, progress_percent: int) -> None:
        percent = min(max(progress_percent, 0), 100)
        if percent == self.last_percent:
            return
        if not self.interactive and percent not in {0, 99, 100} and percent // 10 <= self.last_percent // 10:
            return
        self.last_percent = percent
        if self.interactive:
            completed = percent * self.BAR_WIDTH // 100
            bar = "#" * completed + "-" * (self.BAR_WIDTH - completed)
            ending = "\n" if percent == 100 else ""
            print(f"\r{self.label}: [{bar}] {percent:3d}%", end=ending, file=self.stream, flush=True)
            self.line_active = percent != 100
            return
        print(f"{self.label}: {percent}%", file=self.stream, flush=True)

    def close(self) -> None:
        if self.line_active:
            print(file=self.stream, flush=True)
            self.line_active = False


