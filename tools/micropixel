def guest_build_profile_flags(profile: str, aot_target: str) -> tuple[list[str], list[str], list[str]]:
    profiles = {
        "development": (["-O1", "-g"], [], ["--opt-level=1", "--size-level=3"]),
        "release": (
            ["-Oz"],
            ["-Wl,--strip-all"],
            ["--opt-level=3", "--size-level=3", "--call-stack-features=ip,func-idx"],
        ),
        "size": (
            ["-Oz"],
            ["-Wl,--strip-all"],
            ["--opt-level=3", "--size-level=3", "--call-stack-features=ip,func-idx"],
        ),
        # Full-screen software renderers: speed over Bundle size. Clang -O3 does
        # the loop work in the Wasm. wamrc size-level is the LLVM code model and
        # must stay 3 (small) on RV32: 0 does not lower and 1 (medium) emits
        # PCREL relocations the PSRAM-resident loader cannot fit.
        "performance": (
            ["-O3", "-fno-math-errno"],
            ["-Wl,--strip-all"],
            ["--opt-level=3", "--size-level=3", "--call-stack-features=ip,func-idx"],
        ),
    }
    compile_flags, link_flags, aot_flags = profiles[profile]
    if aot_target == "xtensa":
        # Xtensa l32r can address literals only in the preceding 256 KiB.
        # WAMR's size-level 0 asks LLVM to emit literal islands for modules
        # whose generated text exceeds that range.
        aot_flags = [flag for flag in aot_flags if not flag.startswith("--size-level=")]
        aot_flags.append("--size-level=0")
    return list(compile_flags), list(link_flags), list(aot_flags)


def guest_threading_flags(threading: str) -> tuple[str, list[str], list[str], list[str]]:
    # Bulk memory is enabled in every mode: the Host runtime and wamrc both
    # accept memory.copy/memory.fill, and full-frame renderers spend a
    # measurable share of their time in memcpy/memset otherwise.
    # Non-trapping float->int lets clang emit i32.trunc_sat_f32_s, which wamrc
    # lowers to a single fcvt instead of a range check plus trap on every cast;
    # rasterizers cast per texel. Wasm-level saturation matches RISC-V fcvt.
    common = ["-mbulk-memory", "-mnontrapping-fptoint"]
    if threading == "none":
        return "wasm32-wasip1", common, [], []
    if threading == "shared-memory":
        return (
            "wasm32-wasip1-threads",
            ["-matomics", *common],
            ["-Wl,--shared-memory"],
            ["--enable-multi-thread"],
        )
    raise CliError("Guest threading must be none or shared-memory")


# Objects live under the selected build output, separated by compiler command.
# Track actual compiler dependencies (including system/generated headers), not
# just quoted includes. Hash each dependency once per invocation so regenerated
# headers with identical contents do not cause unrelated App units to rebuild.
GUEST_OBJECT_CACHE_VERSION = 1
GUEST_COMPILE_ENVIRONMENT_KEYS = (
    "CPATH", "CPLUS_INCLUDE_PATH", "C_INCLUDE_PATH", "SDKROOT",
    "CCC_OVERRIDE_OPTIONS", "CLANG_CONFIG_FILE_SYSTEM_DIR", "CLANG_CONFIG_FILE_USER_DIR",
    "SOURCE_DATE_EPOCH",
)


def _read_guest_depfile(path: Path) -> list[Path]:
    # -MT object fixes the target spelling. Clang uses Make escaping here, not
    # shell quoting: spaces/# are backslash escaped and literal $ becomes $$.
    text = path.read_text(encoding="utf-8").replace("\\\n", "")
    if not text.startswith("object:"):
        raise CliError(f"Invalid compiler dependency file: {path}")
    words: list[str] = []
    word: list[str] = []
    index = len("object:")
    while index < len(text):
        char = text[index]
        if char == "\\" and index + 1 < len(text) and text[index + 1] in " \t\r\n#\\":
            index += 1
            word.append(text[index])
        elif char == "$" and text[index:index + 2] == "$$":
            word.append("$")
            index += 1
        elif char.isspace():
            if word:
                words.append("".join(word))
                word = []
        else:
            word.append(char)
        index += 1
    if word:
        words.append("".join(word))
    if not words:
        raise CliError(f"Empty compiler dependency file: {path}")
    return sorted({Path(word).absolute() for word in words})


def _write_guest_cache_json(path: Path, value: Any) -> None:
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    try:
        temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def _guest_file_identity(path: Path) -> dict[str, Any]:
    stat = path.stat()
    return {"path": str(path.resolve()), "size": stat.st_size, "mtime_ns": stat.st_mtime_ns}


def _compile_guest_objects(
    command: list[str], sources: list[Path], output_dir: Path, force: bool,
) -> tuple[list[Path], list[Path]]:
    compiler = Path(command[0]).absolute()
    # The WASI distribution uses clang++.cfg for its no-exception sysroot.
    # Include adjacent configs as well as the binary in toolchain identity.
    toolchain_inputs = sorted({compiler, compiler.resolve(), *compiler.resolve().parent.glob("*.cfg")})
    identity = {
        "schema_version": GUEST_OBJECT_CACHE_VERSION,
        "command": command,
        "cwd": str(Path.cwd()),
        "toolchain": [_guest_file_identity(path) for path in toolchain_inputs],
        "environment": {key: os.environ.get(key, "") for key in GUEST_COMPILE_ENVIRONMENT_KEYS},
    }
    key = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()[:20]
    cache_dir = output_dir.resolve() / "obj" / key
    cache_dir.mkdir(parents=True, exist_ok=True)
    fingerprints: dict[Path, tuple[tuple[int, int, int], str]] = {}

    def fingerprint(path: Path) -> str:
        stat = path.stat()
        signature = (stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)
        cached = fingerprints.get(path)
        if cached is None or cached[0] != signature:
            fingerprints[path] = (signature, hashlib.sha256(path.read_bytes()).hexdigest())
        return fingerprints[path][1]

    objects: list[Path] = []
    build_inputs: set[Path] = set(toolchain_inputs)
    compiled = 0
    for source in sources:
        source = source.absolute()
        source_key = hashlib.sha256(str(source).encode()).hexdigest()[:20]
        obj = cache_dir / f"{source.stem}-{source_key}.o"
        depfile = obj.with_suffix(".d")
        stamp_path = obj.with_suffix(".json")
        dependencies: list[Path] = []
        reusable = False
        if not force:
            try:
                stamp = json.loads(stamp_path.read_text(encoding="utf-8"))
                dependencies = _read_guest_depfile(depfile)
                reusable = (
                    stamp["identity"] == identity
                    and stamp["object"] == _guest_file_identity(obj)
                    and source in dependencies
                    and stamp["dependencies"] == {str(path): fingerprint(path) for path in dependencies}
                )
            except (OSError, UnicodeError, ValueError, KeyError, TypeError, CliError):
                pass
        if not reusable:
            temporary = obj.with_name(f".{obj.stem}.{uuid.uuid4().hex}.tmp.o")
            temporary_depfile = temporary.with_suffix(".d")
            started = time.time_ns()
            try:
                _run_process(
                    [*command, "-MD", "-MF", str(temporary_depfile), "-MT", "object",
                     "-c", str(source), "-o", str(temporary)],
                    check=True,
                )
                dependencies = _read_guest_depfile(temporary_depfile)
                # Do not certify a result whose inputs changed during compile.
                # It can still be linked now; the next invocation will rebuild.
                stable = all(path.stat().st_mtime_ns <= started for path in dependencies)
                dependency_hashes = {str(path): fingerprint(path) for path in dependencies}
                stamp_path.unlink(missing_ok=True)
                temporary.replace(obj)
                temporary_depfile.replace(depfile)
                if stable:
                    _write_guest_cache_json(stamp_path, {
                        "identity": identity,
                        "object": _guest_file_identity(obj),
                        "dependencies": dependency_hashes,
                    })
            finally:
                temporary.unlink(missing_ok=True)
                temporary_depfile.unlink(missing_ok=True)
            compiled += 1
        objects.append(obj)
        build_inputs.update(dependencies)
        build_inputs.update((obj, depfile, stamp_path))
    print(f"Guest objects: {compiled} compiled, {len(objects) - compiled} reused ({cache_dir})")
    return objects, sorted(build_inputs)


def _guest_build_inputs_path(output_dir: Path, name: str) -> Path:
    return output_dir / f"{name}.build-inputs.json"


def _run_build_sources(args: argparse.Namespace) -> None:
    root = sdk_root()
    name = args.name or Path(args.source).stem
    if re.fullmatch(r"[A-Za-z0-9_-]+", name) is None:
        raise CliError("App name may contain only letters, digits, underscores, and hyphens")

    sources = [Path(args.source), *(Path(source) for source in args.extra_source)]
    for source in sources:
        if not source.is_file():
            raise CliError(f"Guest source not found: {source}")

    environment = project_environment(Path.cwd())
    aot_target = getattr(args, "aot_target", None) or environment.get(
        "MICROPIXEL_AOT_TARGET", DEFAULT_AOT_TARGET
    ).strip()
    if aot_target not in AOT_TARGET_FLAGS:
        choices = ", ".join(AOT_TARGET_FLAGS)
        raise CliError(f"Unsupported AOT target {aot_target!r}; choose one of: {choices}")
    wasi_clangxx = environment.get("WASI_CLANGXX", "").strip()
    wasi_clang = environment.get("WASI_CLANG", "").strip()
    if not wasi_clangxx and Path(wasi_clang).name in {"clang", "clang.exe"}:
        wasi_clangxx = str(Path(wasi_clang).with_name("clang++.exe" if wasi_clang.endswith(".exe") else "clang++"))
    if not wasi_clangxx and environment.get("WASI_SDK_PATH", "").strip():
        wasi_clangxx = str(Path(environment["WASI_SDK_PATH"].strip()).expanduser() / "bin/clang++")
    if not wasi_clangxx:
        local_wasi = Path.home() / ".local/wasi-sdk/bin/clang++"
        if local_wasi.is_file():
            wasi_clangxx = str(local_wasi)
    if wasi_clangxx:
        wasi_clangxx = str(tool_executable(wasi_clangxx))
    if not wasi_clangxx or not os.access(Path(wasi_clangxx).expanduser(), os.X_OK):
        raise EnvironmentFailure("Set WASI_CLANGXX or WASI_SDK_PATH to a C++23 compiler with the wasm32 backend")
    wasi_clangxx = str(Path(wasi_clangxx).expanduser())

    wamrc = environment.get("XTENSA_WAMRC" if aot_target == "xtensa" else "WAMRC", "").strip()
    if not wamrc:
        wamrc = environment.get("WAMRC", "").strip()
    if not wamrc:
        candidates = (
            (
                root / "build/tools/wamrc-xtensa/wamrc",
                root / "build/tools/wamrc-xtensa/wamrc-2.4.3",
            )
            if aot_target == "xtensa"
            else (
                root / "build/tools/wamrc-2.4.3-riscv32-ilp32f",
                root / "build/tools/wamrc-host-build-llvm19/wamrc",
                root / "build/tools/wamrc-host-build-llvm19/wamrc-2.4.3",
            )
        )
        wamrc = next((str(candidate) for candidate in candidates if os.access(candidate, os.X_OK)), "")
    if not wamrc:
        wamrc = shutil.which("wamrc") or ""
    if wamrc:
        wamrc = str(tool_executable(wamrc))
    if not wamrc or not os.access(Path(wamrc).expanduser(), os.X_OK):
        raise EnvironmentFailure("Set WAMRC to the locked wamrc 2.4.3 executable; see https://micropixel.ai/docs/environment/")
    wamrc = str(Path(wamrc).expanduser())
    version = _run_process(
        [wamrc, "--version"], check=True, capture_output=True, text=True
    ).stdout.strip()
    if version != "wamrc 2.4.3":
        raise EnvironmentFailure(f"WAMRC must report 'wamrc 2.4.3', got {version!r}")

    generated_include_override = getattr(args, "generated_include_override", None)
    generated_include = (
        str(generated_include_override)
        if generated_include_override is not None
        else environment.get("MICROPIXEL_GUEST_GENERATED_INCLUDE_DIR", "").strip()
    )
    if generated_include and not Path(generated_include).is_dir():
        raise CliError(f"Generated Guest include directory not found: {generated_include}")
    output_dir_override = getattr(args, "output_dir_override", None) or getattr(args, "output_dir", None)
    output_dir = Path(
        output_dir_override
        if output_dir_override is not None
        else environment.get("P4_GUEST_OUTPUT_DIR", str(Path.cwd() / "build/guest-p4"))
    )
    output_dir.mkdir(parents=True, exist_ok=True)

    compile_flags, link_flags, aot_flags = guest_build_profile_flags(args.profile, aot_target)
    threading = getattr(args, "threading", "none")
    target, thread_compile_flags, thread_link_flags, thread_aot_flags = guest_threading_flags(threading)
    unchecked_memory = bool(getattr(args, "unchecked_memory", False))
    include_flags = ["-I", str(root / "guest")]
    if generated_include:
        include_flags.extend(["-I", generated_include])
    wasm_output = output_dir / f"{name}.wasm"
    aot_output = output_dir / f"{name}.aot"

    compile_command = [
        wasi_clangxx,
        f"--target={target}",
        "-std=c++23",
        "-ffreestanding",
        *thread_compile_flags,
        "-mno-reference-types",
        *compile_flags,
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-threadsafe-statics",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wall",
        "-Wextra",
        "-Werror",
        *include_flags,
    ]
    objects, object_inputs = _compile_guest_objects(
        compile_command,
        [
            root / "guest/runtime/c_runtime.cpp",
            root / "guest/runtime/cxx_runtime.cpp",
            root / "guest/runtime/startup.cpp",
            root / "guest/runtime/service_binding.cpp",
            root / "guest/runtime/panic.cpp",
            root / "guest/runtime/system.cpp",
            root / "guest/runtime/storage.cpp",
            root / "guest/runtime/audio.cpp",
            root / "guest/runtime/timers.cpp",
            root / "guest/runtime/devices.cpp",
            root / "guest/runtime/display_context.cpp",
            root / "guest/runtime/graphics.cpp",
            root / "guest/runtime/direct_surface.cpp",
            root / "guest/runtime/raster_resources.cpp",
            root / "guest/runtime/raycast.cpp",
            root / "guest/runtime/mesh_renderer.cpp",
            root / "guest/runtime/sphere_view.cpp",
            root / "guest/runtime/mode7_plane.cpp",
            root / "guest/runtime/application.cpp",
            root / "guest/runtime/scene_graph.cpp",
            *sources,
        ],
        output_dir,
        bool(getattr(args, "force", False)),
    )
    _run_process(
        [
            wasi_clangxx,
            f"--target={target}",
            "-nostdlib",
            "-fno-exceptions",
            "-Wl,--no-entry",
            *thread_link_flags,
            f"-Wl,--max-memory={GUEST_LINEAR_MEMORY_ABSOLUTE_MAX_BYTES}",
            "-Wl,-z,stack-size=16384",
            "-Wl,--gc-sections",
            f"-Wl,--allow-undefined-file={root / 'guest/abi/allowed_imports.txt'}",
            "-Wl,--export=__micropixel_start",
            "-Wl,--export-if-defined=__wasm_call_ctors",
            "-Wl,--export-if-defined=__micropixel_test_event_wait",
            "-Wl,--export-if-defined=__micropixel_test_touch_pressure",
            "-Wl,--export-if-defined=__micropixel_test_key_input",
            "-Wl,--export-if-defined=__micropixel_test_run_handler",
            *link_flags,
            *(str(obj) for obj in objects),
            "-lc++",
            "-o",
            str(wasm_output),
        ],
        check=True,
    )
    _run_process(
        [
            wamrc,
            *AOT_TARGET_FLAGS[aot_target],
            "--bounds-checks=0" if unchecked_memory else "--bounds-checks=1",
            *thread_aot_flags,
            "--enable-memory-profiling",
            "--disable-ref-types",
            "--disable-simd",
            *aot_flags,
            "--enable-dump-call-stack",
            # Experiment hook: extra wamrc flags for codegen A/B. Not a release knob.
            *shlex.split(environment.get("MICROPIXEL_WAMRC_EXTRA_FLAGS", "")),
            "-o",
            str(aot_output),
            str(wasm_output),
        ],
        check=True,
    )
    # Feed compiler-discovered headers and toolchain files into the outer
    # project/Bundle stamp too, so its fast path cannot hide a stale object.
    _write_guest_cache_json(
        _guest_build_inputs_path(output_dir, name),
        [str(path) for path in sorted({*object_inputs, Path(wamrc).absolute()})],
    )
    _record_artifact(wasm_output, "wasm", aot_target)
    _record_artifact(aot_output, "aot", aot_target)
    memory_mode = "unchecked memory" if unchecked_memory else "checked memory"
    print(
        f"Guest built ({args.profile}, AOT target {aot_target}, threading {threading}, {memory_mode}):"
        f"\n{wasm_output}\n{aot_output}"
    )


def _tool_path(name: str) -> Path:
    for directory in ("libexec", "tools"):
        path = sdk_root() / directory / name
        if path.is_file():
            return path
    raise CliError(f"This SDK does not contain {name}")


def _bundle_builder_command(arguments: list[str]) -> list[str]:
    local_builder = sdk_root() / "tools/build_app_bundle.py"
    if local_builder.is_file():
        return [sys.executable, str(local_builder), *arguments]
    if EMBEDDED_BUNDLE_BUILDER is not None:
        return [sys.executable, "-c", EMBEDDED_BUNDLE_BUILDER, *arguments]
    raise CliError("This development copy does not contain the Bundle builder")


def _run_bundle_builder(arguments: list[str]) -> None:
    _run_process(_bundle_builder_command(arguments), check=True)


def _manifest_child(root: Path, value: object, label: str) -> Path:
    if not isinstance(value, str) or not value or Path(value).is_absolute():
        raise CliError(f"{label} must be a non-empty path relative to app.json")
    path = (root / value).resolve()
    if not path.is_relative_to(root):
        raise CliError(f"{label} escapes the project directory: {value}")
    return path


def resolve_project_manifest(target: str | Path) -> Path | None:
    path = Path(target).expanduser()
    if path.is_dir():
        manifest = path / "app.json"
        return manifest.resolve() if manifest.is_file() else None
    if path.is_file() and path.name == "app.json":
        return path.resolve()
    return None


def validate_app_version(value: object) -> str:
    if (
        not isinstance(value, str)
        or len(value) > 31
        or re.fullmatch(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", value) is None
    ):
        raise CliError("App version must be canonical major.minor.patch, at most 31 ASCII bytes")
    return value


APP_STARTER_SOURCE = '''// SPDX-License-Identifier: Apache-2.0
#include "sdk/micropixel.hpp"

int main() {
    micropixel::Application app;
    micropixel::Renderer renderer = app.renderer();
    auto scene = renderer.CreateScene(micropixel::Color::Black()).value();
    (void)scene.CreateLabel({24, 24}, "Hello, World!", micropixel::Color::White()).value();
    renderer.Present(scene).value();
    app.log().Info("App ready");
    app.Run([](const micropixel::Event&) { return micropixel::EventResult::kContinue; });
    return 0;
}
'''


def run_init(args: argparse.Namespace) -> None:
    root = Path(args.directory).expanduser().resolve()
    if root.exists() and not root.is_dir():
        raise CliError(f"Project path is not a directory: {root}")
    manifest_path = root / "app.json"
    if manifest_path.exists() or manifest_path.is_symlink():
        raise CliError(f"app.json already exists; edit it directly: {manifest_path}")
    app_id = args.app_id or f"local.{root.name}"
    if (
        re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", app_id) is None
        or re.fullmatch(r"[A-Za-z0-9_-]+", app_id.rsplit(".", 1)[-1]) is None
    ):
        raise CliError("Invalid App ID; pass --app-id with 1..64 ASCII letters, digits, dots, hyphens or underscores")
    version = validate_app_version(args.app_version)
    title = args.title if args.title is not None else root.name.replace("-", " ").replace("_", " ").title().strip()
    if (
        not title or title.startswith(" ") or title.endswith(" ") or len(title.encode("utf-8")) > 64
        or any(ord(char) < 32 or ord(char) == 127 for char in title)
    ):
        raise CliError("Title must contain 1..64 UTF-8 bytes without control characters or surrounding spaces")

    sources: list[str] = []
    if args.sources:
        for raw in args.sources:
            source = _manifest_child(root, raw, "--source")
            if not source.is_file():
                raise CliError(f"Guest source not found: {source}")
            sources.append(source.relative_to(root).as_posix())
    elif root.exists():
        excluded = {"build", "artifacts", "generated", "managed_components", "node_modules", "test", "tests"}
        for directory, children, files in os.walk(root):
            children[:] = sorted(
                name for name in children
                if not name.startswith(".") and name not in excluded and not name.startswith("cmake-build-")
                and not (Path(directory) / name).is_symlink()
            )
            for name in sorted(files):
                source = Path(directory) / name
                if source.suffix not in {".cpp", ".cc", ".cxx"} or source.is_symlink():
                    continue
                if source.stem.startswith("test_") or source.stem.endswith("_test"):
                    continue
                sources.append(source.relative_to(root).as_posix())
    sources = sorted(set(sources))
    starter = not sources
    if starter:
        sources = ["src/main.cpp"]
        source_path = _manifest_child(root, sources[0], "starter source")
        if source_path.exists() or (root / sources[0]).is_symlink():
            raise CliError(f"Starter source already exists: {source_path}")

    manifest = {
        "schema_version": 1,
        "app_id": app_id,
        "version": version,
        "title": title,
        "threading": "none",
        "sources": sources,
    }
    if (root / "assets/manifest.json").is_file():
        _manifest_child(root, "assets/manifest.json", "asset_manifest")
        manifest["asset_manifest"] = "assets/manifest.json"
    if starter:
        manifest["requirements"] = {"schema_version": 1, "display": {"layouts": ["square", "portrait", "landscape"], "min_width": 320, "min_height": 320}, "required": [], "optional": [], "any_of": [], "services": {}}
    root.mkdir(parents=True, exist_ok=True)
    if starter:
        source_path.parent.mkdir(parents=True, exist_ok=True)
        with source_path.open("x", encoding="utf-8") as output:
            output.write(APP_STARTER_SOURCE)
    with manifest_path.open("x", encoding="utf-8") as output:
        output.write(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    print(f"Created {manifest_path}\nApp ID: {app_id}\nVersion: {version}\nSources:")
    for source in sources:
        print(f"  {source}")
    print(f"\nNext: cd {shlex.quote(str(root))}\n  micropixel build\n  micropixel --transport usb run")
    if not starter:
        print("Review sources in app.json before building; use --source when initializing projects with multiple entry points.")


def load_project_manifest(path: Path) -> ProjectManifest:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise CliError(f"Cannot read project manifest {path}: {error}") from error
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        raise CliError("app.json must be an object using schema_version 1")

    package_type = value.get("package_type", "app")
    if package_type not in {"app", "component"}:
        raise CliError("app.json package_type must be app or component")
    package_id_value = value.get("app_id") if package_type == "app" else value.get("id")
    if not isinstance(package_id_value, str) or re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", package_id_value) is None:
        raise CliError("app.json requires a 1..64 byte ASCII app_id or component id")
    name = package_id_value.rsplit(".", 1)[-1]
    if re.fullmatch(r"[A-Za-z0-9_-]+", name) is None:
        raise CliError("The final package ID segment must be usable as a build name")

    project_root = path.resolve().parent
    sources: list[Path] = []
    raw_sources = value.get("sources")
    if package_type == "app":
        if "version" in value:
            validate_app_version(value["version"])
        if "display" in value or "display_profile" in value:
            raise CliError("app.json no longer declares a display profile; inspect RendererInfo in Guest code")
        if "display_name" in value:
            raise CliError("app.json display_name has been renamed to title")
        if not isinstance(value.get("title"), (str, dict)):
            raise CliError("App project requires a title string or localized title object")
        if "source" in value:
            raise CliError("app.json source has been removed; list every translation unit in sources")
        if (
            not isinstance(raw_sources, list)
            or not raw_sources
            or not all(isinstance(item, str) for item in raw_sources)
        ):
            raise CliError("App project requires a non-empty string sources list")
        for index, raw_source in enumerate(raw_sources):
            source = _manifest_child(project_root, raw_source, f"sources[{index}]")
            if not source.is_file():
                raise CliError(f"Guest source not found: {source}")
            sources.append(source)
    elif raw_sources not in (None, []):
        raise CliError("Component projects cannot contain Guest sources")

    asset_manifest = None
    if value.get("asset_manifest") is not None:
        asset_manifest = _manifest_child(project_root, value["asset_manifest"], "asset_manifest")
        if not asset_manifest.is_file():
            raise CliError(f"Asset manifest not found: {asset_manifest}")

    threading = value.get("threading", "none")
    if package_type == "component":
        if "threading" in value:
            raise CliError("Component projects cannot declare Guest threading")
        threading = "none"
    elif threading not in {"none", "shared-memory"}:
        raise CliError("app.json threading must be none or shared-memory")

    pinned_memory = value.get("pinned_memory", False)
    if package_type == "component":
        if "pinned_memory" in value:
            raise CliError("Component projects cannot declare pinned_memory")
    elif not isinstance(pinned_memory, bool):
        raise CliError("app.json pinned_memory must be true or false")

    return ProjectManifest(
        path=path.resolve(),
        value=value,
        package_id=package_id_value,
        package_type=package_type,
        name=name,
        sources=tuple(sources),
        asset_manifest=asset_manifest,
        threading=threading,
        pinned_memory=pinned_memory,
    )


def project_output_directory(project: ProjectManifest, override: str | None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    repository_apps = (sdk_root() / "guest/apps").resolve()
    if project.path.parent.is_relative_to(repository_apps):
        return (sdk_root() / "build/apps" / project.name).resolve()
    return (project.path.parent / "build").resolve()


# Incremental build stamps follow the Ninja model: an output is reused when the
# recorded command identity and input set match and no input is newer than the
# output. Inputs are compared by stat mtime only; contents are never hashed.
BUILD_STAMP_SCHEMA_VERSION = 2
BUILD_INPUT_HEADER_SUFFIXES = frozenset({".h", ".hpp", ".inc"})
BUILD_INPUT_SDK_DIRECTORIES = ("guest/sdk", "guest/runtime", "guest/abi")
BUILD_INPUT_GENERATOR_SCRIPTS = ("micropixel", "build_app_bundle.py", "generate_localization.py", "analyze_sfx.py")
# Environment that selects the Guest toolchain; a change re-runs the build even
# when no source moved (a wamrc that no longer matches the Host WAMR would
# otherwise be reused silently).
BUILD_TOOLCHAIN_ENVIRONMENT_KEYS = ("WASI_CLANGXX", "WASI_CLANG", "WASI_SDK_PATH", "WAMRC", "XTENSA_WAMRC")
BUILD_INPUT_SKIPPED_DIRECTORIES = frozenset({"build", ".git"})
QUOTED_INCLUDE_PATTERN = re.compile(r'^\s*#\s*include\s*"([^"]+)"', re.MULTILINE)


def build_stamp_path(output: Path) -> Path:
    return output.with_name(f"{output.name}.stamp.json")


def _walk_input_files(directory: Path, skipped: set[Path]) -> list[Path]:
    files: list[Path] = []
    for current, directories, names in os.walk(directory):
        current_path = Path(current)
        directories[:] = sorted(
            name
            for name in directories
            if name not in BUILD_INPUT_SKIPPED_DIRECTORIES and (current_path / name).resolve() not in skipped
        )
        files.extend(current_path / name for name in sorted(names))
    return files


def _manifest_referenced_files(project: ProjectManifest) -> list[Path]:
    # Best effort only: the generators re-validate these manifests and report
    # real errors, so unreadable manifests simply contribute no extra inputs.
    project_root = project.path.parent
    referenced: list[Path] = []
    localization = project.value.get("localization")
    translations = localization.get("translations") if isinstance(localization, dict) else None
    if isinstance(translations, dict):
        for raw_path in translations.values():
            if isinstance(raw_path, str) and raw_path and not Path(raw_path).is_absolute():
                referenced.append((project_root / raw_path).resolve())
    if project.asset_manifest is not None:
        referenced.append(project.asset_manifest)
        try:
            manifest = json.loads(project.asset_manifest.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError):
            manifest = None
        records = manifest.get("assets") if isinstance(manifest, dict) else None
        for record in records if isinstance(records, list) else []:
            raw_path = record.get("path") if isinstance(record, dict) else None
            if isinstance(raw_path, str) and raw_path:
                referenced.append((project.asset_manifest.parent / raw_path).resolve())
    return referenced


def _quoted_include_closure(seeds: list[Path], project_root: Path) -> list[Path]:
    # Seed dependencies before compiler depfiles exist: follow #include "..."
    # so shared headers outside the project tree count as initial inputs.
    include_roots = (project_root, sdk_root() / "guest")
    visited: set[Path] = set()
    pending = list(seeds)
    found: list[Path] = []
    while pending:
        source = pending.pop()
        if source in visited or not source.is_file():
            continue
        visited.add(source)
        try:
            text = source.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for include in QUOTED_INCLUDE_PATTERN.findall(text):
            for base in (source.parent, *include_roots):
                candidate = (base / include).resolve()
                if candidate.is_file():
                    if candidate not in visited:
                        found.append(candidate)
                        pending.append(candidate)
                    break
    return found


def collect_project_build_inputs(project: ProjectManifest, output_dir: Path) -> list[Path]:
    project_root = project.path.parent
    root = sdk_root()
    inputs: set[Path] = {project.path, *project.sources}
    sfx_manifest = project_root / "audio/sfx.json"
    if sfx_manifest.is_file():
        inputs.add(sfx_manifest)
    inputs.update(_manifest_referenced_files(project))
    skipped = {output_dir.resolve(), (output_dir / "generated").resolve()}
    inputs.update(
        path for path in _walk_input_files(project_root, skipped) if path.suffix in BUILD_INPUT_HEADER_SUFFIXES
    )
    inputs.update(_quoted_include_closure(sorted(inputs), project_root))
    compiler_inputs = _guest_build_inputs_path(output_dir, project.name)
    if compiler_inputs.is_file():
        try:
            recorded_inputs = json.loads(compiler_inputs.read_text(encoding="utf-8"))
            if isinstance(recorded_inputs, list) and all(isinstance(path, str) for path in recorded_inputs):
                inputs.update(Path(path) for path in recorded_inputs)
        except (OSError, UnicodeError, ValueError):
            pass

    for relative in BUILD_INPUT_SDK_DIRECTORIES:
        directory = root / relative
        if directory.is_dir():
            inputs.update(_walk_input_files(directory, skipped))
    for name in BUILD_INPUT_GENERATOR_SCRIPTS:
        script = root / "tools" / name
        if script.is_file():
            inputs.add(script)
    return sorted(path.resolve() for path in inputs)


def build_command_identity(
    project: ProjectManifest,
    kind: str,
    profile: str,
    aot_target: str | None,
    unchecked_memory: bool,
) -> dict[str, Any]:
    environment = project_environment(Path.cwd())
    if project.package_type == "app":
        aot_target = aot_target or environment.get("MICROPIXEL_AOT_TARGET", DEFAULT_AOT_TARGET).strip()
    return {
        "cli_version": VERSION,
        "kind": kind,
        "package_type": project.package_type,
        "profile": profile,
        "aot_target": aot_target,
        "unchecked_memory": bool(unchecked_memory),
        "threading": project.threading,
        "pinned_memory": project.pinned_memory,
        "wamrc_extra_flags": environment.get("MICROPIXEL_WAMRC_EXTRA_FLAGS", ""),
        "compile_environment": {key: os.environ.get(key, "") for key in GUEST_COMPILE_ENVIRONMENT_KEYS},
        "toolchain": {key: environment.get(key, "").strip() for key in BUILD_TOOLCHAIN_ENVIRONMENT_KEYS},
    }


def build_output_up_to_date(output: Path, command: dict[str, Any], inputs: list[Path]) -> bool:
    if not output.is_file():
        return False
    try:
        stamp = json.loads(build_stamp_path(output).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return False
    if (
        not isinstance(stamp, dict)
        or stamp.get("schema_version") != BUILD_STAMP_SCHEMA_VERSION
        or stamp.get("command") != command
        or stamp.get("inputs") != [str(path) for path in inputs]
    ):
        return False
    try:
        output_mtime = output.stat().st_mtime_ns
        return all(path.stat().st_mtime_ns <= output_mtime for path in inputs)
    except OSError:
        return False


def write_build_stamp(output: Path, command: dict[str, Any], inputs: list[Path]) -> None:
    stamp = {
        "schema_version": BUILD_STAMP_SCHEMA_VERSION,
        "command": command,
        "inputs": [str(path) for path in inputs],
    }
    build_stamp_path(output).write_text(json.dumps(stamp, indent=2) + "\n", encoding="utf-8")


def prepare_project(project: ProjectManifest, output_dir: Path) -> tuple[Path, Path | None]:
    output_dir.mkdir(parents=True, exist_ok=True)
    generated_dir = output_dir / "generated"
    generated_dir.mkdir(parents=True, exist_ok=True)

    if project.value.get("localization") is not None:
        _run_process(
            [
                sys.executable,
                str(_tool_path("generate_localization.py")),
                "--app-manifest",
                str(project.path),
                "--cpp-namespace",
                f"{project.name.replace('-', '_')}_strings",
                "--output-header",
                str(generated_dir / f"{project.name}_strings.hpp"),
                "--report",
                str(output_dir / "localization-report.json"),
            ],
            check=True,
        )

    sfx_manifest = project.path.parent / "audio/sfx.json"
    if sfx_manifest.is_file():
        analyze_command = [
            sys.executable,
            str(_tool_path("analyze_sfx.py")),
            "--manifest",
            str(sfx_manifest),
            "--emit-cpp-header",
            str(generated_dir / f"{project.name}_sfx_profiles.hpp"),
            "--report",
            str(output_dir / "sfx-report.json"),
            "--check",
        ]
        _run_process(analyze_command, check=True)

    resource_pack = None
    if project.asset_manifest is not None:
        resource_pack = generated_dir / "resources.pack"
        _run_bundle_builder(
            [
                "--app-manifest",
                str(project.path),
                "--asset-manifest",
                str(project.asset_manifest),
                "--prepare-resource-pack",
                str(resource_pack),
                "--emit-cpp-header",
                str(generated_dir / f"{project.name}_assets.hpp"),
                "--cpp-namespace",
                f"{project.name.replace('-', '_')}_assets",
            ]
        )
    return generated_dir, resource_pack


def build_project(
    project: ProjectManifest,
    profile: str,
    output_dir: Path,
    aot_target: str | None = None,
    unchecked_memory: bool = False,
    force: bool = False,
) -> Path | None:
    aot_output = output_dir / f"{project.name}.aot"
    if project.package_type == "app":
        command = build_command_identity(project, "build", profile, aot_target, unchecked_memory)
        inputs = collect_project_build_inputs(project, output_dir)
        if not force and build_output_up_to_date(aot_output, command, inputs):
            print(f"Guest build unchanged, reusing: {aot_output}")
            _record_artifact(aot_output, "aot", aot_target)
            _record_artifact(aot_output.with_suffix(".wasm"), "wasm", aot_target)
            return aot_output
    generated_dir, _ = prepare_project(project, output_dir)
    if project.package_type == "component":
        print(f"Component resources prepared: {output_dir}")
        return None
    build_args = argparse.Namespace(
        source=str(project.sources[0]),
        extra_source=[str(source) for source in project.sources[1:]],
        name=project.name,
        profile=profile,
        aot_target=aot_target,
        generated_include_override=generated_dir,
        output_dir_override=output_dir,
        threading=project.threading,
        unchecked_memory=unchecked_memory,
        force=force,
    )
    _run_build_sources(build_args)
    write_build_stamp(aot_output, command, collect_project_build_inputs(project, output_dir))
    return aot_output


def package_project(
    project: ProjectManifest,
    profile: str,
    output_dir: Path,
    output: str | None,
    aot_target: str | None = None,
    unchecked_memory: bool = False,
    force: bool = False,
) -> Path:
    if project.package_type == "app" and aot_target not in AOT_TARGET_FLAGS:
        raise CliError("App packaging requires an explicit --aot-target")
    bundle_output = (
        Path(output).expanduser().resolve()
        if output
        else output_dir / f"{project.name}.bundle.bin"
    )
    command = build_command_identity(project, "package", profile, aot_target, unchecked_memory)
    inputs = collect_project_build_inputs(project, output_dir)
    if not force and build_output_up_to_date(bundle_output, command, inputs):
        print(f"Package unchanged, reusing: {bundle_output}")
        _record_artifact(bundle_output, "bundle", aot_target)
        return bundle_output

    generated_dir, resource_pack = prepare_project(project, output_dir)
    aot_output: Path | None = None
    if project.package_type == "app":
        build_args = argparse.Namespace(
            source=str(project.sources[0]),
            extra_source=[str(source) for source in project.sources[1:]],
            name=project.name,
            profile=profile,
            aot_target=aot_target,
            generated_include_override=generated_dir,
            output_dir_override=output_dir,
            threading=project.threading,
            unchecked_memory=unchecked_memory,
            force=force,
        )
        _run_build_sources(build_args)
        aot_output = output_dir / f"{project.name}.aot"

    arguments = ["--app-manifest", str(project.path), "--output", str(bundle_output)]
    if aot_output is not None:
        arguments.extend(["--aot", str(aot_output), "--aot-target", aot_target])
        if unchecked_memory:
            arguments.append("--unchecked-memory")
    if resource_pack is not None:
        arguments.extend(["--resource-pack", str(resource_pack)])
    _run_bundle_builder(arguments)
    write_build_stamp(bundle_output, command, collect_project_build_inputs(project, output_dir))
    _record_artifact(bundle_output, "bundle", aot_target)
    print(f"Package ready: {bundle_output}")
    return bundle_output


def run_build(args: argparse.Namespace) -> None:
    manifest_path = resolve_project_manifest(args.source)
    if manifest_path is None:
        if args.source == ".":
            raise CliError("No app.json found in the current directory")
        _run_build_sources(args)
        return
    if args.extra_source:
        raise CliError("Extra source arguments are not allowed when building an app.json project")
    project = load_project_manifest(manifest_path)
    build_project(
        project,
        args.profile,
        project_output_directory(project, args.output_dir),
        getattr(args, "aot_target", None),
        bool(getattr(args, "unchecked_memory", False)),
        bool(getattr(args, "force", False)),
    )


def run_package(args: argparse.Namespace) -> Path:
    if args.raw is not None:
        if not args.raw:
            raise CliError("package --raw requires build_app_bundle.py arguments")
        _run_bundle_builder(args.raw)
        return Path(args.output).resolve() if args.output else Path()
