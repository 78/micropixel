CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.s31.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ESP-Mosaico's onboard Type-C connector is wired to USB 2.0 HS OTG, not the
# USB Serial/JTAG pads exposed on the left module header. ESP32-S31 does not
# expose ESP-IDF's ROM CDC console choice, so the board initializes an
# interrupt/task-driven TinyUSB CDC console during platform startup.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ESP-Mosaico carries 16 MiB octal PSRAM. Guest linear memory, decoded
# resources and the official BSP's double-partial LVGL buffers use it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# Keep the first product display baseline aligned with the official Mosaico
# HMI demo. The S31 preview PSRAM/SPI DMA path is not yet validated while APB
# and CPU clocks change underneath a full-frame QSPI transfer.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Let small Guests keep a small working set and larger Guests grow on demand.
# Both WAMR and decoded resources must leave the Host PSRAM safety floor intact.
# CONFIG_ESP_SYSTEM_MEMPROT is not set
CONFIG_WAMR_BUILD_RELEASE=y
CONFIG_WAMR_ENABLE_AOT=y
# CONFIG_WAMR_ENABLE_INTERP is not set
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_MEMORY_PROFILING=y
CONFIG_WAMR_ENABLE_DUMP_CALL_STACK=y
CONFIG_WAMR_ENABLE_LIB_PTHREAD=y
CONFIG_WAMR_ENABLE_SHARED_MEMORY=y
CONFIG_WAMR_LINEAR_MEMORY_IN_PSRAM=y
# S31 exposes PSRAM through a unified executable address range. Keep relocated
# AOT text there so normal-sized apps do not depend on scarce contiguous SRAM.
CONFIG_WAMR_AOT_CODE_IN_PSRAM=y
CONFIG_MICROPIXEL_AOT_PACKAGE_BUFFER_IN_PSRAM=y
CONFIG_MICROPIXEL_GUEST_LINEAR_MEMORY_MAX_PAGES=128
CONFIG_MICROPIXEL_GUEST_PSRAM_RESERVE_BYTES=2097152
CONFIG_WAMR_RUNTIME_MAX_GUEST_THREADS=2
CONFIG_WAMR_DEFAULT_WATCHDOG_TIMEOUT_MS=1000

CONFIG_MICROPIXEL_KV_MAX_BYTES=2048
CONFIG_MICROPIXEL_KV_MAX_VALUE_BYTES=512
CONFIG_MICROPIXEL_KV_MAX_KEYS=16
CONFIG_MICROPIXEL_KV_WRITE_BURST=8
CONFIG_MICROPIXEL_KV_WRITE_REFILL_MS=1000
CONFIG_MICROPIXEL_ENABLE_CONFORMANCE_TEST_HOOKS=n

CONFIG_MICROPIXEL_BOARD_ESP_MOSAICO=y
CONFIG_MICROPIXEL_MOSAICO_LCD_QSPI_DRIVE_CAP=3
# Run animated and continuously changing Guest scenes at a 60 Hz-class cadence.
# Static scenes remain event-driven and do not redraw just because this timer
# period is shorter.
CONFIG_LV_DEF_REFR_PERIOD=16
# CO5300 QSPI uses a bounded internal DMA-SRAM strip. This keeps panel DMA
# independent from PSRAM traffic generated by LVGL assets, USB/JPEG and Wi-Fi.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=480
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MICROPIXEL_LVGL_OBJECT_POOL_PSRAM=y
CONFIG_OPUS_NONTHREADSAFE_PSEUDOSTACK=y
CONFIG_OPUS_PSEUDOSTACK_SIZE=120000
CONFIG_OPUS_STATE_PREFER_PSRAM=y
CONFIG_OPUS_PSEUDOSTACK_PREFER_PSRAM=y
CONFIG_OPUS_OGG_DECODER_PREFER_PSRAM=y
# CONFIG_OPUS_FLOATING_POINT is not set
# CONFIG_OPUS_ENABLE_XTENSA_OPTIMIZATIONS is not set
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_MICROPIXEL_BITMAP_PSRAM_QUOTA_BYTES=4194304
# Assets keep their 720-design-space source dimensions and are scaled at draw
# time by Guest Viewport, so the texture ceiling is not the physical 480 panel.
CONFIG_MICROPIXEL_MAX_TEXTURE_DIMENSION=720

# Product builds never compile LVGL's standalone demos or examples. Besides
# wasting flash, some examples hard-code bundled Montserrat fonts that the Host
# intentionally replaces with its generated builtin-latin font.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

CONFIG_MICROPIXEL_REMOTE_CONTROL_ALLOW_UNVERIFIED_TLS=y
# CONFIG_MBEDTLS_HAVE_TIME_DATE is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
# The S31 LVGL/PPA display bridge currently addresses partial RGB565 buffers
# as tightly packed rows. Keep LVGL's global stride packed; persistent
# MicroPixel-owned RGB888 surfaces apply their own 16-pixel stride alignment.
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
CONFIG_LV_DRAW_BUF_ALIGN=64
# S31 has no standard RISC-V Vector Extension target; LVGL's RISCV_V selection
# would use its portable vector emulation here and is substantially slower.
CONFIG_LV_DRAW_SW_ASM_NONE=y
