# Defaults shared by every supported ESP-IDF target. Target- and board-specific
# defaults are layered after this file by the build tools.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Every supported profile has PSRAM. Keep ordinary malloc() internal while
# allowing explicitly capable Host, WAMR, Wi-Fi and static allocations to use it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# WAMR AOT requires executable allocations on every target. All supported
# devices keep both the mutable package input and relocated executable text in
# PSRAM, leaving internal SRAM for metadata, stacks, DMA and system work.
# CONFIG_ESP_SYSTEM_MEMPROT is not set
CONFIG_WAMR_BUILD_RELEASE=y
CONFIG_WAMR_ENABLE_AOT=y
# CONFIG_WAMR_ENABLE_INTERP is not set
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_LIBC_WASI=n
CONFIG_WAMR_ENABLE_MEMORY_PROFILING=y
CONFIG_WAMR_ENABLE_DUMP_CALL_STACK=y
CONFIG_WAMR_ENABLE_LIB_PTHREAD=y
CONFIG_WAMR_ENABLE_SHARED_MEMORY=y
CONFIG_WAMR_LINEAR_MEMORY_IN_PSRAM=y
CONFIG_WAMR_AOT_CODE_IN_PSRAM=y

# All Ogg Opus decoders run serially on MicroPixel's single audio decode worker,
# so every target shares one PSRAM-backed pseudostack. Architecture-specific
# fixed/floating-point and instruction optimizations remain target-specific.
CONFIG_OPUS_NONTHREADSAFE_PSEUDOSTACK=y
CONFIG_OPUS_PSEUDOSTACK_SIZE=120000
CONFIG_OPUS_STATE_PREFER_PSRAM=y
CONFIG_OPUS_PSEUDOSTACK_PREFER_PSRAM=y
CONFIG_OPUS_OGG_DECODER_PREFER_PSRAM=y

# Guest and Host service limits are part of the product contract, not a board
# capability. Board profiles may still tighten a limit in a later defaults file.
CONFIG_MICROPIXEL_GUEST_LINEAR_MEMORY_MAX_PAGES=128
CONFIG_MICROPIXEL_GUEST_PSRAM_RESERVE_BYTES=1048576
CONFIG_MICROPIXEL_MAX_BITMAPS=128
CONFIG_WAMR_RUNTIME_MAX_GUEST_THREADS=2
CONFIG_WAMR_DEFAULT_WATCHDOG_TIMEOUT_MS=1000
CONFIG_MICROPIXEL_KV_MAX_BYTES=2048
CONFIG_MICROPIXEL_KV_MAX_VALUE_BYTES=512
CONFIG_MICROPIXEL_KV_MAX_KEYS=16
CONFIG_MICROPIXEL_KV_WRITE_BURST=8
CONFIG_MICROPIXEL_KV_WRITE_REFILL_MS=1000
CONFIG_MICROPIXEL_ENABLE_CONFORMANCE_TEST_HOOKS=n

# FirmwareApp startup performs synchronous System UI and bundle initialization
# on the ESP main task. Use the same measured stack allowance on every target.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=14336

# Guest-visible GPIO edge handlers run from IRAM and read the pin level while
# the Flash cache may be unavailable. Keep their ESP-IDF GPIO dependencies in
# IRAM on every supported target.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Use 1 ms task timing and retain enough room for descriptive diagnostic names.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=32
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Product firmware never links LVGL examples/demos or architecture-specific
# assembly kernels. Buffers retain cache-line-safe base alignment; row stride
# remains target-specific because P4 uses RGB888 while S31/S3 use RGB565.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_DRAW_SW_ASM_NONE=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_SNAPSHOT=y
# The Host always uses LVGL's fixed builtin pool; main/CMakeLists.txt places
# that pool in PSRAM on every supported target.
CONFIG_LV_USE_BUILTIN_MALLOC=y

# Remote Control uses an explicit development trust policy and no wall clock or
# Mozilla root bundle. Production trust anchors remain machine-local settings.
CONFIG_MICROPIXEL_REMOTE_CONTROL_ALLOW_UNVERIFIED_TLS=y
# CONFIG_MBEDTLS_HAVE_TIME_DATE is not set
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
