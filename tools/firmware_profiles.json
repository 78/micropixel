{
  "metalio-claw4": {
    "description": "ESP32-P4 + Metalio-Claw4 product firmware",
    "target": "esp32p4",
    "chip_markers": [
      "ESP32-P4"
    ],
    "build_dir": "build/host-esp32p4",
    "build_dir_env": "P4_HOST_BUILD_DIR",
    "sdkconfig_name": "sdkconfig.release",
    "sdkconfig_env": "P4_SDKCONFIG",
    "sdkconfig_defaults": [
      "firmware/espressif/sdkconfig.defaults",
      "firmware/espressif/sdkconfig.p4.defaults"
    ],
    "sdkconfig_defaults_env": "P4_SDKCONFIG_DEFAULTS",
    "port_env": "P4_PORT",
    "baud_env": "P4_BAUD",
    "default_baud": 2000000,
    "preview": false,
    "flash": true,
    "monitor": true
  },
  "p4-null": {
    "description": "ESP32-P4 hardware-independent compile gate",
    "target": "esp32p4",
    "build_dir": "build/host-esp32p4-null",
    "build_dir_env": "P4_NULL_HOST_BUILD_DIR",
    "sdkconfig_name": "sdkconfig.release",
    "sdkconfig_defaults": [
      "firmware/espressif/sdkconfig.defaults",
      "firmware/espressif/sdkconfig.p4.defaults",
      "firmware/espressif/sdkconfig.p4-null.defaults"
    ],
    "preview": false,
    "flash": false,
    "monitor": false
  },
  "esp-mosaico": {
    "description": "ESP32-S31 + ESP-Mosaico P0/P1 bring-up firmware",
    "target": "esp32s31",
    "chip_markers": [
      "ESP32-S31"
    ],
    "build_dir": "build/host-esp32s31-mosaico",
